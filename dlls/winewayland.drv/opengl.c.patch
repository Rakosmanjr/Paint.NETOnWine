+static void frame_callback_done(void *data, struct wl_callback *callback, uint32_t time)
+{
+    struct wayland_gl_drawable *gl = data;
+
+    TRACE("drawable %s\n", debugstr_opengl_drawable(&gl->base));
+
+    if (gl->frame_callback == callback) gl->frame_callback = NULL;
+    wl_callback_destroy(callback);
+}
+
+static const struct wl_callback_listener frame_callback_listener = { frame_callback_done };
+
+/* Wait for the compositor to have shown the previous frame, but not for long:
+ * a compositor sends no frame callbacks for a surface it is not showing, such
+ * as an occluded or minimized window or one on another virtual desktop, and a
+ * SwapBuffers that never returns for such a window is not something an
+ * application can be expected to cope with. */
+static void wayland_drawable_wait_frame(struct wayland_gl_drawable *gl)
+{
+    struct wl_display *display = process_wayland.wl_display;
+    struct pollfd pfd = { .fd = wl_display_get_fd(display), .events = POLLIN };
+    struct timespec start, now;
+    int remaining;
+
+    clock_gettime(CLOCK_MONOTONIC, &start);
+
+    while (gl->frame_callback)
+    {
+        while (wl_display_prepare_read_queue(display, gl->wl_event_queue) != 0)
+            wl_display_dispatch_queue_pending(display, gl->wl_event_queue);
+        if (!gl->frame_callback)
+        {
+            wl_display_cancel_read(display);
+            break;
+        }
+        wl_display_flush(display);
+
+        clock_gettime(CLOCK_MONOTONIC, &now);
+        remaining = 100 - ((now.tv_sec - start.tv_sec) * 1000 + (now.tv_nsec - start.tv_nsec) / 1000000);
+        if (remaining <= 0 || poll(&pfd, 1, remaining) <= 0)
+        {
+            wl_display_cancel_read(display);
+            TRACE("drawable %s: no frame callback, not waiting any longer\n", debugstr_opengl_drawable(&gl->base));
+            break;
+        }
+        if (wl_display_read_events(display) == -1) break;
+        wl_display_dispatch_queue_pending(display, gl->wl_event_queue);
+    }
+}
+
 static BOOL wayland_drawable_swap(struct opengl_drawable *base)
 {
     struct wayland_gl_drawable *gl = impl_from_opengl_drawable(base);
+    struct wayland_client_surface *surface = base->client ? impl_from_client_surface(base->client) : NULL;
+    struct wl_surface *wrapper;
 
     client_surface_present(base->client);
+
+    if (surface && gl->wl_event_queue)
+    {
+        if (gl->frame_callback && base->interval) wayland_drawable_wait_frame(gl);
+
+        /* Ask for a frame callback for this frame; the commit that carries it
+         * is the one eglSwapBuffers makes below. The callback goes to a queue
+         * of its own so that only the swapping thread dispatches it. */
+        if ((wrapper = wl_proxy_create_wrapper(surface->wl_surface)))
+        {
+            wl_proxy_set_queue((struct wl_proxy *)wrapper, gl->wl_event_queue);
+            if (gl->frame_callback) wl_callback_destroy(gl->frame_callback);
+            if ((gl->frame_callback = wl_surface_frame(wrapper)))
+                wl_callback_add_listener(gl->frame_callback, &frame_callback_listener, gl);
+            wl_proxy_wrapper_destroy(wrapper);
+        }
+    }
+
     funcs->p_eglSwapBuffers(egl->display, gl->base.surface);
 
     return TRUE;
