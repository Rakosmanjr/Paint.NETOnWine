     ok(ref == 0, "factory not released, %lu\n", ref);
 }
 
+static DWORD WINAPI system_fontcollection_thread(void *arg)
+{
+    IDWriteFactory *factory = arg;
+    IDWriteFontCollection *collection;
+    unsigned int i;
+    HRESULT hr;
+
+    for (i = 0; i < 2000; ++i)
+    {
+        hr = IDWriteFactory_GetSystemFontCollection(factory, &collection, FALSE);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        if (FAILED(hr))
+            break;
+        IDWriteFontCollection_Release(collection);
+    }
+
+    return 0;
+}
+
+/* The factory does not keep the system collection alive by itself, so one
+ * thread can release the last reference while another is asking for it. */
+static void test_system_fontcollection_threads(void)
+{
+    IDWriteFactory *factory;
+    HANDLE threads[8];
+    unsigned int i;
+
+    factory = create_factory();
+
+    for (i = 0; i < ARRAY_SIZE(threads); ++i)
+        threads[i] = CreateThread(NULL, 0, system_fontcollection_thread, factory, 0, NULL);
+    WaitForMultipleObjects(ARRAY_SIZE(threads), threads, TRUE, INFINITE);
+    for (i = 0; i < ARRAY_SIZE(threads); ++i)
+        CloseHandle(threads[i]);
+
+    IDWriteFactory_Release(factory);
+}
+
 static void test_system_fontcollection(void)
 {
     IDWriteFontCollection *collection, *coll2;
@@ -10706,6 +10744,7 @@ START_TEST(font)
     test_CreateFontFace();
     test_GetMetrics();
     test_system_fontcollection();
+    test_system_fontcollection_threads();
     test_ConvertFontFaceToLOGFONT();
     test_CustomFontCollection();
     test_CreateCustomFontFileReference();
