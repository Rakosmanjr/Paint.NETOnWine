+/* Takes a reference unless the last one has already been released, in which
+ * case the collection is being destroyed and must not be handed out. */
+BOOL fontcollection_try_addref(IDWriteFontCollection3 *iface)
+{
+    struct dwrite_fontcollection *collection = impl_from_IDWriteFontCollection3(iface);
+    LONG refcount = ReadNoFence(&collection->refcount), prev;
+
+    while (refcount)
+    {
+        if ((prev = InterlockedCompareExchange(&collection->refcount, refcount + 1, refcount)) == refcount)
+            return TRUE;
+        refcount = prev;
+    }
+
+    return FALSE;
+}
+
 static ULONG WINAPI dwritefontcollection_Release(IDWriteFontCollection3 *iface)
 {
     struct dwrite_fontcollection *collection = impl_from_IDWriteFontCollection3(iface);
@@ -5828,6 +5845,29 @@ static ULONG WINAPI glyphrunanalysis_Release(IDWriteGlyphRunAnalysis *iface)
     return refcount;
 }
 
+// Surely should not be in this file. or there is a better alternative ?
+// but this work so
+// Note: this is to avoid crash on paint.net 5. easily replicable by hovering over the toolbox and moving the mouse
+static void addSafe(LONG* pos, INT value) {
+    LONG current = *pos;
+    LONG result = current + (LONG)value;
+    TRACE("somehow, this is needed ? optimization issue ?\n");
+    if ((value > 0) && (current > result)) {
+        *pos = LONG_MAX;
+    }
+    else if ((value < 0) && (current < result)) {
+        *pos = LONG_MIN;
+    }
+    else *pos = result;
+}
+
+static void OffsetRectSafe(RECT* rect, INT x, INT y) {
+    addSafe(&rect->left, x);
+    addSafe(&rect->right, x);
+    addSafe(&rect->top, y);
+    addSafe(&rect->bottom, y);
+}
