+/* The factory holds no reference to the collections it caches, since each
+ * collection holds one to the factory. A cached collection is cleared from
+ * the cache under the factory lock when its last reference goes away, so a
+ * lookup made under the same lock either takes a reference to a live
+ * collection or finds that it is going away. */
+static void *factory_get_cached_collection(struct dwritefactory *factory, void **cache)
+{
+    IDWriteFontCollection3 *collection;
+
+    EnterCriticalSection(&factory->cs);
+    if ((collection = *cache) && !fontcollection_try_addref(collection))
+        collection = NULL;
+    LeaveCriticalSection(&factory->cs);
+
+    return collection;
+}
+
+/* Caches "collection", unless another thread cached a live one first, and
+ * returns whichever is cached with a reference for the caller. */
+static void *factory_set_cached_collection(struct dwritefactory *factory, void **cache,
+        IDWriteFontCollection3 *collection)
+{
+    IDWriteFontCollection3 *cached;
+
+    EnterCriticalSection(&factory->cs);
+    if ((cached = *cache) && fontcollection_try_addref(cached))
+    {
+        LeaveCriticalSection(&factory->cs);
+        IDWriteFontCollection3_Release(collection);
+        return cached;
+    }
+    *cache = collection;
+    LeaveCriticalSection(&factory->cs);
+
+    return collection;
+}
