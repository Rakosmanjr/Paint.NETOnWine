+static HRESULT compositor_create( ICompositorController *controller,
+        __x_ABI_CWindows_CUI_CComposition_CICompositor **out )
+{
+    struct compositor *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) )))
+        return E_OUTOFMEMORY;
+
+    impl->ICompositor_iface.lpVtbl = &compositor_vtbl;
+    impl->ref = 1;
+    /* Weak: the controller owns the compositor for as long as it lives. */
+    impl->controller = controller;
+
+    *out = &impl->ICompositor_iface;
+
+    return S_OK;
+}
