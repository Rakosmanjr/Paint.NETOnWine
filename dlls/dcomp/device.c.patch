+/* Composition surfaces are not always the layout GDI wants to be handed, so
+ * put the pixels in the one shape it understands. */
+static BOOL composition_surface_to_bgra( const D3D11_MAPPED_SUBRESOURCE *map, const D3D11_TEXTURE2D_DESC *desc,
+        DWORD *out )
+{
+    unsigned int x, y;
+
+    switch (desc->Format)
+    {
+    case DXGI_FORMAT_B8G8R8A8_UNORM:
+    case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+    case DXGI_FORMAT_B8G8R8X8_UNORM:
+        for (y = 0; y < desc->Height; ++y)
+            memcpy( out + y * desc->Width, (const char *)map->pData + y * map->RowPitch, desc->Width * 4 );
+        return TRUE;
+
+    case DXGI_FORMAT_R8G8B8A8_UNORM:
+    case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+        for (y = 0; y < desc->Height; ++y)
+        {
+            const DWORD *src = (const DWORD *)((const char *)map->pData + y * map->RowPitch);
+            for (x = 0; x < desc->Width; ++x)
+            {
+                DWORD p = src[x];
+                out[y * desc->Width + x] = (p & 0xff00ff00) | ((p & 0xff) << 16) | ((p >> 16) & 0xff);
+            }
+        }
+        return TRUE;
+
+    case DXGI_FORMAT_R16G16B16A16_FLOAT:
+        for (y = 0; y < desc->Height; ++y)
+        {
+            const unsigned short *src = (const unsigned short *)((const char *)map->pData + y * map->RowPitch);
+            for (x = 0; x < desc->Width; ++x)
+            {
+                const unsigned short *p = src + x * 4;
+                float a = half_to_float( p[3] );
+                out[y * desc->Width + x] = (((DWORD)(a < 0.0f ? 0.0f : a > 1.0f ? 255.0f : a * 255.0f + 0.5f)) << 24)
+                        | (scrgb_to_srgb( half_to_float( p[0] ) ) << 16)
+                        | (scrgb_to_srgb( half_to_float( p[1] ) ) << 8)
+                        | scrgb_to_srgb( half_to_float( p[2] ) );
+            }
+        }
+        return TRUE;
+
+    default:
+        FIXME( "Unhandled composition surface format %#x.\n", desc->Format );
+        return FALSE;
+    }
+}
+
+/* Compositing a visual tree means getting whatever an application rendered
+ * into its composition surfaces onto the window the tree is targeting.
+ * Nothing here is fast: a commit reads the surface back through a staging
+ * texture and blits it with GDI. It is enough to make the content visible. */
+static void composite_surface_to_window( HWND hwnd, struct composition_surface *surface, const RECT *dest, BYTE opacity )
+{
+    D3D11_TEXTURE2D_DESC desc, staging_desc;
+    ID3D11Texture2D *buffer, *staging;
+    D3D11_MAPPED_SUBRESOURCE map;
+    ID3D11DeviceContext *context;
+    IDXGISwapChain *swapchain;
+    BITMAPINFO info = {{0}};
+    UINT present_count;
+    HBITMAP bitmap;
+    DWORD *pixels;
+    ID3D11Device *device;
+    HRESULT hr;
+    HDC hdc;
+
+    if (FAILED(IUnknown_QueryInterface( surface->content, &IID_IDXGISwapChain, (void **)&swapchain )))
+    {
+        FIXME( "Cannot composite surface content %p.\n", surface->content );
+        return;
+    }
+
+    /* Until the application has presented, the buffer holds nothing it put
+     * there, and drawing it would put stale memory on screen. Once it has,
+     * there is nothing new to draw until it presents again. */
+    if (SUCCEEDED(IDXGISwapChain_GetLastPresentCount( swapchain, &present_count ))
+            && (!present_count || present_count == surface->composited_present))
+    {
+        TRACE( "Swap chain %p has nothing new to show.\n", swapchain );
+        IDXGISwapChain_Release( swapchain );
+        return;
+    }
+    surface->composited_present = present_count;
+
+    hr = IDXGISwapChain_GetBuffer( swapchain, 0, &IID_ID3D11Texture2D, (void **)&buffer );
+    IDXGISwapChain_Release( swapchain );
+    if (FAILED(hr))
+    {
+        WARN( "Failed to get swap chain buffer, hr %#lx.\n", hr );
+        return;
+    }
+
+    ID3D11Texture2D_GetDesc( buffer, &desc );
+    ID3D11Texture2D_GetDevice( buffer, &device );
+    ID3D11Device_GetImmediateContext( device, &context );
+
+    /* The back buffer is not readable by the CPU, so take a copy that is. */
+    staging_desc = desc;
+    staging_desc.Usage = D3D11_USAGE_STAGING;
+    staging_desc.BindFlags = 0;
+    staging_desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    staging_desc.MiscFlags = 0;
+    staging_desc.SampleDesc.Count = 1;
+    staging_desc.SampleDesc.Quality = 0;
+
+    if (SUCCEEDED(hr = ID3D11Device_CreateTexture2D( device, &staging_desc, NULL, &staging )))
+    {
+        ID3D11DeviceContext_CopyResource( context, (ID3D11Resource *)staging, (ID3D11Resource *)buffer );
+
+        if (SUCCEEDED(hr = ID3D11DeviceContext_Map( context, (ID3D11Resource *)staging, 0,
+                                                    D3D11_MAP_READ, 0, &map )))
+        {
+            info.bmiHeader.biSize = sizeof(info.bmiHeader);
+            info.bmiHeader.biWidth = desc.Width;
+            /* Negative height: composition surfaces are top-down. */
+            info.bmiHeader.biHeight = -(LONG)desc.Height;
+            info.bmiHeader.biPlanes = 1;
+            info.bmiHeader.biBitCount = 32;
+            info.bmiHeader.biCompression = BI_RGB;
+
+            if ((bitmap = CreateDIBSection( NULL, &info, DIB_RGB_COLORS, (void **)&pixels, NULL, 0 )))
+            {
+                if (composition_surface_to_bgra( &map, &desc, pixels ) && (hdc = GetDC( hwnd )))
+                {
+                    BLENDFUNCTION blend = {AC_SRC_OVER, 0, opacity, AC_SRC_ALPHA};
+                    HDC src_hdc = CreateCompatibleDC( hdc );
+                    HBITMAP prev = SelectObject( src_hdc, bitmap );
+
+                    /* A visual is drawn over what is already on the window, not
+                     * stamped onto it: what it leaves transparent has to stay. */
+                    GdiAlphaBlend( hdc, dest->left, dest->top,
+                                   dest->right - dest->left, dest->bottom - dest->top,
+                                   src_hdc, 0, 0, desc.Width, desc.Height, blend );
+
+                    SelectObject( src_hdc, prev );
+                    DeleteDC( src_hdc );
+                    ReleaseDC( hwnd, hdc );
+                }
+                DeleteObject( bitmap );
+            }
+
+            ID3D11DeviceContext_Unmap( context, (ID3D11Resource *)staging, 0 );
+        }
+        else WARN( "Failed to map staging texture, hr %#lx.\n", hr );
+
+        ID3D11Texture2D_Release( staging );
+    }
+    else WARN( "Failed to create staging texture, hr %#lx.\n", hr );
+
+    ID3D11DeviceContext_Release( context );
+    ID3D11Device_Release( device );
+    ID3D11Texture2D_Release( buffer );
+}
+
+static void composite_target( struct desktop_window_target *target )
+{
+    struct surface_brush *brush;
+    struct visual *visual;
+    BYTE opacity;
+    RECT dest;
+
+    if (!target->root) return;
+    /* Only visuals this module made can be walked. */
+    if (target->root->lpVtbl != &visual_vtbl) return;
+
+    visual = impl_from_IVisual( target->root );
+    if (!visual->is_visible || !visual->brush) return;
+    if (visual->brush->lpVtbl != (const ICompositionBrushVtbl *)&composition_brush_vtbl) return;
+
+    brush = CONTAINING_RECORD( visual->brush, struct surface_brush, ICompositionBrush_iface );
+    if (!brush->surface) return;
+
+    if (brush->surface->lpVtbl != &composition_surface_vtbl) return;
+    if (!CONTAINING_RECORD( brush->surface, struct composition_surface, ICompositionSurface_iface )->content)
+        return;
+
+    dest.left = (LONG)visual->offset.X;
+    dest.top = (LONG)visual->offset.Y;
+    dest.right = dest.left + (LONG)visual->size.X;
+    dest.bottom = dest.top + (LONG)visual->size.Y;
+
+    TRACE( "compositing visual %p into window %p, %s.\n", visual, target->hwnd, wine_dbgstr_rect( &dest ) );
+
+    opacity = visual->opacity <= 0.0f ? 0 : visual->opacity >= 1.0f ? 0xff
+            : (BYTE)(visual->opacity * 255.0f + 0.5f);
+    if (!opacity)
+        return;
+
+    composite_surface_to_window( target->hwnd,
+            CONTAINING_RECORD( brush->surface, struct composition_surface, ICompositionSurface_iface ),
+            &dest, opacity );
+}
+
+static HRESULT WINAPI compositor_controller_Commit( ICompositorController *iface )
+{
+    struct desktop_window_target *target;
+
+    TRACE( "iface %p.\n", iface );
+
+    EnterCriticalSection( &compositor_controller_cs );
+    LIST_FOR_EACH_ENTRY( target, &composition_targets, struct desktop_window_target, entry )
+            composite_target( target );
+    LeaveCriticalSection( &compositor_controller_cs );
+
+    return S_OK;
+}
+
+static HRESULT WINAPI compositor_controller_EnsurePreviousCommitCompletedAsync( ICompositorController *iface, __x_ABI_CWindows_CFoundation_CIAsyncAction **operation )
+{
+    FIXME( "iface %p, operation %p stub.\n", iface, operation );
+
+    if (!operation) return E_POINTER;
+
+    *operation = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI compositor_controller_add_CommitNeeded( ICompositorController *iface, ICommitNeededHandler *handler,
+        EventRegistrationToken *token )
+{
+    struct compositor_controller *impl = impl_from_ICompositorController( iface );
+    ICommitNeededHandler **handlers;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+
+    if (!token) return E_POINTER;
+    if (!handler) return E_INVALIDARG;
+
+    EnterCriticalSection( &compositor_controller_cs );
+    if (!(handlers = realloc( impl->handlers, (impl->handler_count + 1) * sizeof(*handlers) )))
+        hr = E_OUTOFMEMORY;
+    else
+    {
+        impl->handlers = handlers;
+        impl->handlers[impl->handler_count++] = handler;
+        ICommitNeededHandler_AddRef( handler );
+        /* Tokens are one-based so that a zeroed token never matches. */
+        token->value = impl->handler_count;
+    }
+    LeaveCriticalSection( &compositor_controller_cs );
+
+    if (FAILED(hr)) token->value = 0;
+    return hr;
+}
+
+static HRESULT WINAPI compositor_controller_remove_CommitNeeded( ICompositorController *iface, EventRegistrationToken token )
+{
+    struct compositor_controller *impl = impl_from_ICompositorController( iface );
+    ICommitNeededHandler *handler = NULL;
+
+    TRACE( "iface %p, token %#I64x.\n", iface, token.value );
+
+    EnterCriticalSection( &compositor_controller_cs );
+    if (token.value > 0 && (SIZE_T)token.value <= impl->handler_count)
+    {
+        handler = impl->handlers[token.value - 1];
+        impl->handlers[token.value - 1] = NULL;
+    }
+    LeaveCriticalSection( &compositor_controller_cs );
+
+    if (handler) ICommitNeededHandler_Release( handler );
+    return S_OK;
+}
+
+const struct ICompositorControllerVtbl compositor_controller_vtbl =
+{
+    /* IUnknown methods */
+    compositor_controller_QueryInterface,
+    compositor_controller_AddRef,
+    compositor_controller_Release,
+    /*** IInspectable methods ***/
+    compositor_controller_GetIids,
+    compositor_controller_GetRuntimeClassName,
+    compositor_controller_GetTrustLevel,
+    /* ICompositorController methods */
+    compositor_controller_get_Compositor,
+    compositor_controller_Commit,
+    compositor_controller_EnsurePreviousCommitCompletedAsync,
+    compositor_controller_add_CommitNeeded,
+    compositor_controller_remove_CommitNeeded,
+};
+
+static HRESULT compositor_controller_create(ICompositorController **obj)
+{
+    struct compositor_controller *This = calloc( sizeof(*This), 1 );
+
+    if (!This)
+        return E_OUTOFMEMORY;
+    This->ICompositorController_iface.lpVtbl = &compositor_controller_vtbl;
+    This->ref = 1;
+
+    *obj = &This->ICompositorController_iface;
+
+    return S_OK;
+}
+
+static struct compositor_controller compositor_controller_inst =
+{
+    {&compositor_controller_vtbl},
+    1,
+};
+
+IActivationFactory *compositor_controller_activation_factory = (IActivationFactory*) &compositor_controller_inst.ICompositorController_iface;
+
+
+HRESULT WINAPI DllGetActivationFactory( HSTRING classid, IActivationFactory **factory )
+{
+    const WCHAR *buffer = WindowsGetStringRawBuffer( classid, NULL );
+
+    TRACE( "class %s, factory %p.\n", debugstr_hstring(classid), factory );
+
+    *factory = NULL;
+
+    //if (!wcscmp( buffer, RUNTIMECLASS_Windows_UI_Composition_Core_CompositorController ))
+    if (!wcscmp( buffer, L"Windows.UI.Composition.Core.CompositorController" ))
+        IActivationFactory_QueryInterface( compositor_controller_activation_factory, &IID_IActivationFactory, (void **)factory );
+
+    if (*factory) return S_OK;
+    return CLASS_E_CLASSNOTAVAILABLE;
+}
