+    {
+        IUnknown_AddRef( iface );
+        *out = &compositor->ICompositorController_iface;
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
