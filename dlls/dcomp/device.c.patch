+/* A composition target bound to a window. The visual tree set as its root is
+ * what a compositor would draw into that window. */
+struct desktop_window_target
+{
+    struct list entry;
+    IDesktopWindowTarget IDesktopWindowTarget_iface;
+    ICompositionTarget ICompositionTarget_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+
+    HWND hwnd;
+    boolean topmost;
+    IVisual *root;
+};
+
+/* Every live target, so that a commit can find the trees to draw. Guarded by
+ * compositor_controller_cs. */
+static struct list composition_targets = LIST_INIT( composition_targets );
+
+static inline struct desktop_window_target *impl_from_IDesktopWindowTarget( IDesktopWindowTarget *iface )
+{
+    return CONTAINING_RECORD( iface, struct desktop_window_target, IDesktopWindowTarget_iface );
+}
+
+static HRESULT WINAPI desktop_window_target_QueryInterface( IDesktopWindowTarget *iface, REFIID iid, void **out )
+{
+    struct desktop_window_target *impl = impl_from_IDesktopWindowTarget( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IDesktopWindowTarget ))
+    {
+        IDesktopWindowTarget_AddRef( iface );
+        *out = &impl->IDesktopWindowTarget_iface;
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_ICompositionTarget ))
+    {
+        IDesktopWindowTarget_AddRef( iface );
+        *out = &impl->ICompositionTarget_iface;
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IClosable ))
+    {
+        IDesktopWindowTarget_AddRef( iface );
+        *out = &impl->IClosable_iface;
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI desktop_window_target_AddRef( IDesktopWindowTarget *iface )
+{
+    struct desktop_window_target *impl = impl_from_IDesktopWindowTarget( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p increasing refcount to %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI desktop_window_target_Release( IDesktopWindowTarget *iface )
+{
+    struct desktop_window_target *impl = impl_from_IDesktopWindowTarget( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p decreasing refcount to %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        EnterCriticalSection( &compositor_controller_cs );
+        list_remove( &impl->entry );
+        LeaveCriticalSection( &compositor_controller_cs );
+
+        if (impl->root) IVisual_Release( impl->root );
+        free( impl );
+    }
+
+    return ref;
+}
