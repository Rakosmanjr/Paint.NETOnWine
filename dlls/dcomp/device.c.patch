+static HRESULT surface_brush_create( ICompositionSurface *surface, ICompositionSurfaceBrush **out )
+{
+    struct surface_brush *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) )))
+        return E_OUTOFMEMORY;
+
+    impl->ICompositionSurfaceBrush_iface.lpVtbl = &surface_brush_vtbl;
+    impl->ICompositionBrush_iface.lpVtbl = &composition_brush_vtbl;
+    impl->IClosable_iface.lpVtbl = &surface_brush_closable_vtbl;
+    impl->ref = 1;
+
+    /* A new surface brush fills the visual and centres its surface. */
+    impl->stretch = CompositionStretch_Fill;
+    impl->horizontal_alignment_ratio = 0.5f;
+    impl->vertical_alignment_ratio = 0.5f;
+
+    if ((impl->surface = surface)) ICompositionSurface_AddRef( surface );
+
+    *out = &impl->ICompositionSurfaceBrush_iface;
+
+    return S_OK;
+}
