+static HRESULT WINAPI compositor_controller_add_CommitNeeded( ICompositorController *iface, ICommitNeededHandler *handler,
+        EventRegistrationToken *token )
+{
+    struct compositor_controller *impl = impl_from_ICompositorController( iface );
+    ICommitNeededHandler **handlers;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+
+    if (!token) return E_POINTER;
+    if (!handler) return E_INVALIDARG;
+
+    EnterCriticalSection( &compositor_controller_cs );
+    if (!(handlers = realloc( impl->handlers, (impl->handler_count + 1) * sizeof(*handlers) )))
+        hr = E_OUTOFMEMORY;
+    else
+    {
+        impl->handlers = handlers;
+        impl->handlers[impl->handler_count++] = handler;
+        ICommitNeededHandler_AddRef( handler );
+        /* Tokens are one-based so that a zeroed token never matches. */
+        token->value = impl->handler_count;
+    }
+    LeaveCriticalSection( &compositor_controller_cs );
+
+    if (FAILED(hr)) token->value = 0;
+    return hr;
+}
+
+static HRESULT WINAPI compositor_controller_remove_CommitNeeded( ICompositorController *iface, EventRegistrationToken token )
+{
+    struct compositor_controller *impl = impl_from_ICompositorController( iface );
+    ICommitNeededHandler *handler = NULL;
+
+    TRACE( "iface %p, token %#I64x.\n", iface, token.value );
+
+    EnterCriticalSection( &compositor_controller_cs );
+    if (token.value > 0 && (SIZE_T)token.value <= impl->handler_count)
+    {
+        handler = impl->handlers[token.value - 1];
+        impl->handlers[token.value - 1] = NULL;
+    }
+    LeaveCriticalSection( &compositor_controller_cs );
+
+    if (handler) ICommitNeededHandler_Release( handler );
+    return S_OK;
+}
