+static HRESULT sprite_visual_create( ICompositor *compositor, ISpriteVisual **out )
+{
+    struct visual *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) )))
+        return E_OUTOFMEMORY;
+
+    impl->IVisual_iface.lpVtbl = &visual_vtbl;
+    impl->ISpriteVisual_iface.lpVtbl = &sprite_visual_vtbl;
+    impl->ICompositionObject_iface.lpVtbl = &composition_object_vtbl;
+    impl->IClosable_iface.lpVtbl = &visual_closable_vtbl;
+    impl->ref = 1;
+
+    /* A new visual is visible, fully opaque and untransformed. */
+    impl->is_visible = TRUE;
+    impl->opacity = 1.0f;
+    impl->scale.X = impl->scale.Y = impl->scale.Z = 1.0f;
+    impl->orientation.W = 1.0f;
+    impl->transform_matrix.M11 = impl->transform_matrix.M22 = 1.0f;
+    impl->transform_matrix.M33 = impl->transform_matrix.M44 = 1.0f;
+
+    if ((impl->compositor = compositor)) ICompositor_AddRef( compositor );
+
+    *out = &impl->ISpriteVisual_iface;
+
+    return S_OK;
+}
