+/***********************************************************************
+ *          ICompositor
+ *
+ * The compositor owns the visual tree an application builds and is what
+ * ultimately puts its content on screen. Nothing is composited yet; this
+ * exists so that get_Compositor() can hand out an object of the right type.
+ * It previously returned the controller cast to ICompositor, which is a
+ * different interface with a different vtable, so any call through it
+ * dispatched on the wrong slot.
+ */
+
+
+/* A composition surface wrapping content an application produced elsewhere,
+ * most often the back buffer of a composition swap chain. */
+struct composition_surface
+{
+    ICompositionSurface ICompositionSurface_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+
+    IUnknown *content;
+    /* The present the window was last drawn from, so that a commit that
+     * changes nothing does not stamp the same frame down again. */
+    UINT composited_present;
+};
+
+static inline struct composition_surface *impl_from_ICompositionSurface( ICompositionSurface *iface )
+{
+    return CONTAINING_RECORD( iface, struct composition_surface, ICompositionSurface_iface );
+}
+
+static HRESULT WINAPI composition_surface_QueryInterface( ICompositionSurface *iface, REFIID iid, void **out )
+{
+    struct composition_surface *impl = impl_from_ICompositionSurface( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_ICompositionSurface ))
+        *out = &impl->ICompositionSurface_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable ))
+        *out = &impl->IClosable_iface;
+    else
+    {
+        FIXME( "%s not implemented.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI composition_surface_AddRef( ICompositionSurface *iface )
+{
+    struct composition_surface *impl = impl_from_ICompositionSurface( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p increasing refcount to %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI composition_surface_Release( ICompositionSurface *iface )
+{
+    struct composition_surface *impl = impl_from_ICompositionSurface( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p decreasing refcount to %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        if (impl->content) IUnknown_Release( impl->content );
+        free( impl );
+    }
+
+    return ref;
+}
+
+static HRESULT WINAPI composition_surface_GetIids( ICompositionSurface *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub.\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI composition_surface_GetRuntimeClassName( ICompositionSurface *iface, HSTRING *class_name )
+{
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( RuntimeClass_Windows_UI_Composition_CompositionSurfaceBrush,
+                                ARRAY_SIZE(RuntimeClass_Windows_UI_Composition_CompositionSurfaceBrush) - 1,
+                                class_name );
+}
+
+static HRESULT WINAPI composition_surface_GetTrustLevel( ICompositionSurface *iface, TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static const struct ICompositionSurfaceVtbl composition_surface_vtbl =
+{
+    composition_surface_QueryInterface,
+    composition_surface_AddRef,
+    composition_surface_Release,
+    /* IInspectable methods */
+    composition_surface_GetIids,
+    composition_surface_GetRuntimeClassName,
+    composition_surface_GetTrustLevel,
+};
+
+DEFINE_IINSPECTABLE_( composition_surface_closable, IClosable, struct composition_surface,
+                      impl_from_surface_IClosable, IClosable_iface, &impl->ICompositionSurface_iface )
+
+static HRESULT WINAPI composition_surface_closable_Close( IClosable *iface )
+{
+    struct composition_surface *impl = impl_from_surface_IClosable( iface );
+    IUnknown *content;
+
+    TRACE( "iface %p.\n", iface );
+
+    content = impl->content;
+    impl->content = NULL;
+    if (content) IUnknown_Release( content );
+
+    return S_OK;
+}
+
+static const struct IClosableVtbl composition_surface_closable_vtbl =
+{
+    composition_surface_closable_QueryInterface,
+    composition_surface_closable_AddRef,
+    composition_surface_closable_Release,
+    /* IInspectable methods */
+    composition_surface_closable_GetIids,
+    composition_surface_closable_GetRuntimeClassName,
+    composition_surface_closable_GetTrustLevel,
+    /* IClosable methods */
+    composition_surface_closable_Close,
+};
+
+static HRESULT composition_surface_create( IUnknown *content, ICompositionSurface **out )
+{
+    struct composition_surface *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) )))
+        return E_OUTOFMEMORY;
+
+    impl->ICompositionSurface_iface.lpVtbl = &composition_surface_vtbl;
+    impl->IClosable_iface.lpVtbl = &composition_surface_closable_vtbl;
+    impl->ref = 1;
+    if ((impl->content = content)) IUnknown_AddRef( content );
+
+    *out = &impl->ICompositionSurface_iface;
+
+    return S_OK;
+}
