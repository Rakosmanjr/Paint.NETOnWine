+/***********************************************************************
+ *          ICompositor
+ *
+ * The compositor owns the visual tree an application builds and is what
+ * ultimately puts its content on screen. Nothing is composited yet; this
+ * exists so that get_Compositor() can hand out an object of the right type.
+ * It previously returned the controller cast to ICompositor, which is a
+ * different interface with a different vtable, so any call through it
+ * dispatched on the wrong slot.
+ */
+struct compositor
+{
+    __x_ABI_CWindows_CUI_CComposition_CICompositor ICompositor_iface;
+    LONG ref;
+    /* The controller this compositor belongs to. An application can ask a
+     * compositor for its controller, so keep a way back. */
+    ICompositorController *controller;
+};
+
+static inline struct compositor *impl_from_ICompositor( __x_ABI_CWindows_CUI_CComposition_CICompositor *iface )
+{
+    return CONTAINING_RECORD( iface, struct compositor, ICompositor_iface );
+}
+
+static HRESULT WINAPI compositor_QueryInterface( __x_ABI_CWindows_CUI_CComposition_CICompositor *iface,
+        REFIID iid, void **out )
+{
+    struct compositor *impl = impl_from_ICompositor( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID___x_ABI_CWindows_CUI_CComposition_CICompositor ))
+    {
+        IUnknown_AddRef( iface );
+        *out = &impl->ICompositor_iface;
+        return S_OK;
+    }
+
+    if (impl->controller && IsEqualGUID( iid, &IID_ICompositorController ))
+        return ICompositorController_QueryInterface( impl->controller, iid, out );
+
+    FIXME( "%s not implemented.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI compositor_AddRef( __x_ABI_CWindows_CUI_CComposition_CICompositor *iface )
+{
+    struct compositor *impl = impl_from_ICompositor( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI compositor_Release( __x_ABI_CWindows_CUI_CComposition_CICompositor *iface )
+{
+    struct compositor *impl = impl_from_ICompositor( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+        free( impl );
+
+    return ref;
+}
