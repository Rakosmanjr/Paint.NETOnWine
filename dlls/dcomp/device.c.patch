+/***********************************************************************
+ *          ICompositor
+ *
+ * The compositor owns the visual tree an application builds and is what
+ * ultimately puts its content on screen. Nothing is composited yet; this
+ * exists so that get_Compositor() can hand out an object of the right type.
+ * It previously returned the controller cast to ICompositor, which is a
+ * different interface with a different vtable, so any call through it
+ * dispatched on the wrong slot.
+ */
+
+/* A node in a composition visual tree. Everything an application can put in a
+ * tree shares the Visual surface, so one object covers the sprite case too. */
+struct visual
+{
+    IVisual IVisual_iface;
+    ISpriteVisual ISpriteVisual_iface;
+    ICompositionObject ICompositionObject_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+
+    Vector2 anchor_point;
+    CompositionBackfaceVisibility backface_visibility;
+    CompositionBorderMode border_mode;
+    Vector3 center_point;
+    ICompositionClip *clip;
+    CompositionCompositeMode composite_mode;
+    boolean is_visible;
+    Vector3 offset;
+    FLOAT opacity;
+    Quaternion orientation;
+    IContainerVisual *parent;
+    FLOAT rotation_angle;
+    FLOAT rotation_angle_in_degrees;
+    Vector3 rotation_axis;
+    Vector3 scale;
+    Vector2 size;
+    Matrix4x4 transform_matrix;
+
+    ICompositionBrush *brush;
+    ICompositor *compositor;
+    ICompositionPropertySet *properties;
+};
+
+static inline struct visual *impl_from_IVisual( IVisual *iface )
+{
+    return CONTAINING_RECORD( iface, struct visual, IVisual_iface );
+}
+
+static HRESULT WINAPI visual_QueryInterface( IVisual *iface, REFIID iid, void **out )
+{
+    struct visual *impl = impl_from_IVisual( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IVisual ))
+        *out = &impl->IVisual_iface;
+    else if (IsEqualGUID( iid, &IID_ISpriteVisual ))
+        *out = &impl->ISpriteVisual_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionObject ))
+        *out = &impl->ICompositionObject_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable ))
+        *out = &impl->IClosable_iface;
+    else
+    {
+        FIXME( "%s not implemented.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI visual_AddRef( IVisual *iface )
+{
+    struct visual *impl = impl_from_IVisual( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p increasing refcount to %lu.\n", iface, ref );
+    return ref;
+}
+
+static void visual_detach( struct visual *impl )
+{
+    if (impl->brush) ICompositionBrush_Release( impl->brush );
+    if (impl->clip) ICompositionClip_Release( impl->clip );
+    if (impl->properties) ICompositionPropertySet_Release( impl->properties );
+    impl->brush = NULL;
+    impl->clip = NULL;
+    impl->properties = NULL;
+}
+
+static ULONG WINAPI visual_Release( IVisual *iface )
+{
+    struct visual *impl = impl_from_IVisual( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p decreasing refcount to %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        visual_detach( impl );
+        if (impl->compositor) ICompositor_Release( impl->compositor );
+        free( impl );
+    }
+
+    return ref;
+}
