+/* Half floats, as composition surfaces in scRGB use them. */
+static float half_to_float( unsigned short h )
+{
+    unsigned int sign = (h >> 15) & 1, exponent = (h >> 10) & 0x1f, mantissa = h & 0x3ff;
+    union { unsigned int i; float f; } u;
+
+    if (!exponent) /* zero or subnormal */
+    {
+        if (!mantissa) u.i = sign << 31;
+        else
+        {
+            exponent = 127 - 15 + 1;
+            while (!(mantissa & 0x400))
+            {
+                mantissa <<= 1;
+                --exponent;
+            }
+            u.i = (sign << 31) | (exponent << 23) | ((mantissa & 0x3ff) << 13);
+        }
+    }
+    else if (exponent == 0x1f) u.i = (sign << 31) | 0x7f800000 | (mantissa << 13);
+    else u.i = (sign << 31) | ((exponent - 15 + 127) << 23) | (mantissa << 13);
+
+    return u.f;
+}
+
+static unsigned char scrgb_to_srgb( float c )
+{
+    if (c <= 0.0f) return 0;
+    if (c >= 1.0f) return 255;
+    c = c <= 0.0031308f ? c * 12.92f : 1.055f * powf( c, 1.0f / 2.4f ) - 0.055f;
+    return (unsigned char)(c * 255.0f + 0.5f);
+}
