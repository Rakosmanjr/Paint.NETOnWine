diff --git a/dlls/d2d1/wic_render_target.c b/dlls/d2d1/wic_render_target.c
index c0720e69a8a..79b651de351 100644
--- a/dlls/d2d1/wic_render_target.c
+++ b/dlls/d2d1/wic_render_target.c
@@ -27,6 +27,53 @@ static inline struct d2d_wic_render_target *impl_from_IUnknown(IUnknown *iface)
     return CONTAINING_RECORD(iface, struct d2d_wic_render_target, IUnknown_iface);
 }
 
+/* Drawing to a WIC bitmap target draws over what the bitmap holds, so its
+ * current contents are what the texture starts from. */
+static void d2d_wic_render_target_begin_draw(IUnknown *outer_unknown)
+{
+    struct d2d_wic_render_target *render_target = impl_from_IUnknown(outer_unknown);
+    ID3D10Resource *dst_resource;
+    IWICBitmapLock *bitmap_lock;
+    UINT src_size, src_pitch;
+    ID3D10Device *device;
+    WICRect src_rect;
+    BYTE *src;
+    HRESULT hr;
+
+    src_rect.X = 0;
+    src_rect.Y = 0;
+    src_rect.Width = render_target->width;
+    src_rect.Height = render_target->height;
+    if (FAILED(hr = IWICBitmap_Lock(render_target->bitmap, &src_rect, WICBitmapLockRead, &bitmap_lock)))
+    {
+        WARN("Failed to lock source bitmap, hr %#lx.\n", hr);
+        return;
+    }
+
+    if (FAILED(hr = IWICBitmapLock_GetDataPointer(bitmap_lock, &src_size, &src))
+            || FAILED(hr = IWICBitmapLock_GetStride(bitmap_lock, &src_pitch)))
+    {
+        WARN("Failed to get bitmap data, hr %#lx.\n", hr);
+        IWICBitmapLock_Release(bitmap_lock);
+        return;
+    }
+
+    if (SUCCEEDED(hr = IDXGISurface_QueryInterface(render_target->dxgi_surface,
+            &IID_ID3D10Resource, (void **)&dst_resource)))
+    {
+        ID3D10Texture2D_GetDevice(render_target->readback_texture, &device);
+        ID3D10Device_UpdateSubresource(device, dst_resource, 0, NULL, src, src_pitch, 0);
+        ID3D10Device_Release(device);
+        ID3D10Resource_Release(dst_resource);
+    }
+    else
+    {
+        WARN("Failed to get destination resource interface, hr %#lx.\n", hr);
+    }
+
+    IWICBitmapLock_Release(bitmap_lock);
+}
+
 static HRESULT d2d_wic_render_target_present(IUnknown *outer_unknown)
 {
     struct d2d_wic_render_target *render_target = impl_from_IUnknown(outer_unknown);
@@ -146,6 +193,7 @@ static const struct IUnknownVtbl d2d_wic_render_target_vtbl =
 
 static const struct d2d_device_context_ops d2d_wic_render_target_ops =
 {
+    d2d_wic_render_target_begin_draw,
     d2d_wic_render_target_present,
 };
 
@@ -227,6 +275,9 @@ HRESULT d2d_wic_render_target_init(struct d2d_wic_render_target *render_target,
         case DXGI_FORMAT_R8G8B8A8_UNORM:
             render_target->bpp = 4;
             break;
+        case DXGI_FORMAT_A8_UNORM:
+            render_target->bpp = 1;
+            break;
 
         default:
             FIXME("Unhandled format %#x.\n", texture_desc.Format);
