-    if (FAILED(hr = IWICBitmap_Lock(render_target->bitmap, &dst_rect, WICBitmapLockWrite, &bitmap_lock)))
+    if (!render_target->lock && FAILED(hr = d2d_wic_render_target_lock(render_target, &bitmap_lock)))
     {
-        ERR("Failed to lock destination bitmap, hr %#lx.\n", hr);
-        goto end;
+        WARN("Failed to lock destination bitmap, hr %#lx.\n", hr);
+        return hr;
     }
 
-    if (FAILED(hr = IWICBitmapLock_GetDataPointer(bitmap_lock, &dst_size, &dst)))
+    if (FAILED(hr = IWICBitmapLock_GetDataPointer(render_target->lock ? render_target->lock : bitmap_lock,
+            &dst_size, &dst)))
     {
         ERR("Failed to get data pointer, hr %#lx.\n", hr);
