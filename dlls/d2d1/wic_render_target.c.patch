@@ -27,15 +27,65 @@ static inline struct d2d_wic_render_target *impl_from_IUnknown(IUnknown *iface)
     return CONTAINING_RECORD(iface, struct d2d_wic_render_target, IUnknown_iface);
 }
 
+static HRESULT d2d_wic_render_target_lock(struct d2d_wic_render_target *render_target, IWICBitmapLock **lock)
+{
+    WICRect rect;
+
+    rect.X = 0;
+    rect.Y = 0;
+    rect.Width = render_target->width;
+    rect.Height = render_target->height;
+    return IWICBitmap_Lock(render_target->bitmap, &rect, WICBitmapLockWrite, lock);
+}
+
+/* The target holds the bitmap's lock from BeginDraw() to EndDraw(), and
+ * drawing to it draws over what the bitmap holds, so its contents when the
+ * draw begins are what the texture starts from. */
+static void d2d_wic_render_target_begin_draw(IUnknown *outer_unknown)
+{
+    struct d2d_wic_render_target *render_target = impl_from_IUnknown(outer_unknown);
+    ID3D10Resource *dst_resource;
+    UINT src_size, src_pitch;
+    ID3D10Device *device;
+    BYTE *src;
+    HRESULT hr;
+
+    if (!render_target->lock && FAILED(hr = d2d_wic_render_target_lock(render_target, &render_target->lock)))
+    {
+        WARN("Failed to lock bitmap, hr %#lx.\n", hr);
+        render_target->lock = NULL;
+        return;
+    }
+
+    if (FAILED(hr = IWICBitmapLock_GetDataPointer(render_target->lock, &src_size, &src))
+            || FAILED(hr = IWICBitmapLock_GetStride(render_target->lock, &src_pitch)))
+    {
+        WARN("Failed to get bitmap data, hr %#lx.\n", hr);
+        return;
+    }
+
+    if (SUCCEEDED(hr = IDXGISurface_QueryInterface(render_target->dxgi_surface,
+            &IID_ID3D10Resource, (void **)&dst_resource)))
+    {
+        ID3D10Texture2D_GetDevice(render_target->readback_texture, &device);
+        ID3D10Device_UpdateSubresource(device, dst_resource, 0, NULL, src, src_pitch, 0);
+        ID3D10Device_Release(device);
+        ID3D10Resource_Release(dst_resource);
+    }
+    else
+    {
+        WARN("Failed to get destination resource interface, hr %#lx.\n", hr);
+    }
+}
