+    *out = unsafe_impl_from_ID2D1Bitmap(bitmap_iface);
+
+    /* An effect input sits at the origin of the effect's coordinate space. */
+    size = (*out)->pixel_size;
+    out_rect->left = 0;
+    out_rect->top = 0;
+    out_rect->right = size.width;
+    out_rect->bottom = size.height;
+
+    return S_OK;
+}
