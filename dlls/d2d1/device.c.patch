+/* Fills the polygons, given in target pixels, with antialiased edges. The
+ * clip is applied by the pixel shader, so only the mask's extent is
+ * limited here. */
+static void d2d_device_context_fill_polylines(struct d2d_device_context *context,
+        struct d2d_polyline_set *set, struct d2d_brush *brush, struct d2d_brush *opacity_brush)
+{
+    struct d2d_coverage_mask mask;
+    struct d2d_vec4 coverage_rect;
+    D2D1_RECT_F clip, rect, bounds;
+    RECT clip_rect;
+    HRESULT hr;
+
+    d2d_device_context_get_clip_rect(context, &clip);
+    if (clip.left >= clip.right || clip.top >= clip.bottom)
+        return;
+    clip_rect.left = floorf(clip.left);
+    clip_rect.top = floorf(clip.top);
+    clip_rect.right = ceilf(clip.right);
+    clip_rect.bottom = ceilf(clip.bottom);
+
+    if (d2d_polyline_set_is_rect(set, &rect))
+    {
+        if (rect.left >= rect.right || rect.top >= rect.bottom)
+            return;
+        coverage_rect.x = d2d_coverage_snap(rect.left);
+        coverage_rect.y = d2d_coverage_snap(rect.top);
+        coverage_rect.z = d2d_coverage_snap(rect.right);
+        coverage_rect.w = d2d_coverage_snap(rect.bottom);
+        d2d_rect_set(&bounds, floorf(rect.left), floorf(rect.top), ceilf(rect.right), ceilf(rect.bottom));
+        d2d_rect_intersect(&bounds, &clip);
+        d2d_rect_set(&bounds, floorf(bounds.left), floorf(bounds.top), ceilf(bounds.right), ceilf(bounds.bottom));
+        if (bounds.left >= bounds.right || bounds.top >= bounds.bottom)
+            return;
+        d2d_device_context_draw_coverage(context, &bounds, D2D_COVERAGE_MODE_RECT, &coverage_rect,
+                NULL, brush, opacity_brush);
+        return;
+    }
+
+    if (FAILED(hr = d2d_polyline_set_rasterize(set, &clip_rect, &mask)))
+    {
+        WARN("Failed to rasterize geometry, hr %#lx.\n", hr);
+        return;
+    }
+
+    if (mask.width && mask.height && SUCCEEDED(d2d_device_context_upload_coverage(context, &mask)))
+    {
+        coverage_rect.x = mask.x;
+        coverage_rect.y = mask.y;
+        coverage_rect.z = mask.width;
+        coverage_rect.w = mask.height;
+        d2d_rect_set(&bounds, mask.x, mask.y, mask.x + mask.width, mask.y + mask.height);
+        d2d_device_context_draw_coverage(context, &bounds, D2D_COVERAGE_MODE_MASK, &coverage_rect,
+                context->coverage_srv, brush, opacity_brush);
+    }
+
+    d2d_coverage_mask_cleanup(&mask);
+}
