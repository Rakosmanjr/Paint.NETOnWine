+static BOOL STDMETHODCALLTYPE d2d_device_context_IsSupported(ID2D1DeviceContext6 *iface,
+        const D2D1_RENDER_TARGET_PROPERTIES *desc)
+{
+    struct d2d_device_context *context = impl_from_ID2D1DeviceContext(iface);
+
+    TRACE("iface %p, desc %p.\n", iface, desc);
+
+    if (!desc)
+        return FALSE;
+
+    /* An unspecified field places no requirement, so only a field asking for
+     * something this context does not provide makes it unsupported. */
+    if (desc->type != D2D1_RENDER_TARGET_TYPE_DEFAULT
+            && desc->type != D2D1_RENDER_TARGET_TYPE_HARDWARE)
+        return FALSE;
+    if (desc->pixelFormat.format != DXGI_FORMAT_UNKNOWN
+            && desc->pixelFormat.format != context->desc.pixelFormat.format)
+        return FALSE;
+    if (desc->pixelFormat.alphaMode != D2D1_ALPHA_MODE_UNKNOWN
+            && desc->pixelFormat.alphaMode != context->desc.pixelFormat.alphaMode)
+        return FALSE;
+    if (desc->dpiX != 0.0f && desc->dpiX != context->desc.dpiX)
+        return FALSE;
+    if (desc->dpiY != 0.0f && desc->dpiY != context->desc.dpiY)
+        return FALSE;
+    if (desc->usage & ~context->desc.usage)
+        return FALSE;
+    if (desc->minLevel > context->desc.minLevel)
+        return FALSE;
+
+    return TRUE;
+}
