+/* Blend factors for each composite mode, on premultiplied colour. The alpha
+ * channel uses the same factors; the colour-only ones are not valid there, so
+ * MASK_INVERT falls back to the alpha equivalent. */
+static ID3D11BlendState *d2d_device_context_get_composite_bs(struct d2d_device_context *context,
+        D2D1_COMPOSITE_MODE mode)
+{
+    static const struct
+    {
+        D3D11_BLEND src, dst, src_alpha, dst_alpha;
+    }
+    modes[] =
+    {
+        /* SOURCE_OVER */        {D3D11_BLEND_ONE,            D3D11_BLEND_INV_SRC_ALPHA,
+                                  D3D11_BLEND_ONE,            D3D11_BLEND_INV_SRC_ALPHA},
+        /* DESTINATION_OVER */   {D3D11_BLEND_INV_DEST_ALPHA, D3D11_BLEND_ONE,
+                                  D3D11_BLEND_INV_DEST_ALPHA, D3D11_BLEND_ONE},
+        /* SOURCE_IN */          {D3D11_BLEND_DEST_ALPHA,     D3D11_BLEND_ZERO,
+                                  D3D11_BLEND_DEST_ALPHA,     D3D11_BLEND_ZERO},
+        /* DESTINATION_IN */     {D3D11_BLEND_ZERO,           D3D11_BLEND_SRC_ALPHA,
+                                  D3D11_BLEND_ZERO,           D3D11_BLEND_SRC_ALPHA},
+        /* SOURCE_OUT */         {D3D11_BLEND_INV_DEST_ALPHA, D3D11_BLEND_ZERO,
+                                  D3D11_BLEND_INV_DEST_ALPHA, D3D11_BLEND_ZERO},
+        /* DESTINATION_OUT */    {D3D11_BLEND_ZERO,           D3D11_BLEND_INV_SRC_ALPHA,
+                                  D3D11_BLEND_ZERO,           D3D11_BLEND_INV_SRC_ALPHA},
+        /* SOURCE_ATOP */        {D3D11_BLEND_DEST_ALPHA,     D3D11_BLEND_INV_SRC_ALPHA,
+                                  D3D11_BLEND_DEST_ALPHA,     D3D11_BLEND_INV_SRC_ALPHA},
+        /* DESTINATION_ATOP */   {D3D11_BLEND_INV_DEST_ALPHA, D3D11_BLEND_SRC_ALPHA,
+                                  D3D11_BLEND_INV_DEST_ALPHA, D3D11_BLEND_SRC_ALPHA},
+        /* XOR */                {D3D11_BLEND_INV_DEST_ALPHA, D3D11_BLEND_INV_SRC_ALPHA,
+                                  D3D11_BLEND_INV_DEST_ALPHA, D3D11_BLEND_INV_SRC_ALPHA},
+        /* PLUS */               {D3D11_BLEND_ONE,            D3D11_BLEND_ONE,
+                                  D3D11_BLEND_ONE,            D3D11_BLEND_ONE},
+        /* SOURCE_COPY */        {D3D11_BLEND_ONE,            D3D11_BLEND_ZERO,
+                                  D3D11_BLEND_ONE,            D3D11_BLEND_ZERO},
+        /* BOUNDED_SOURCE_COPY */{D3D11_BLEND_ONE,            D3D11_BLEND_ZERO,
+                                  D3D11_BLEND_ONE,            D3D11_BLEND_ZERO},
+        /* MASK_INVERT */        {D3D11_BLEND_ZERO,           D3D11_BLEND_INV_SRC_COLOR,
+                                  D3D11_BLEND_ZERO,           D3D11_BLEND_INV_SRC_ALPHA},
+    };
+    D3D11_BLEND_DESC blend_desc;
+    HRESULT hr;
+
+    if (mode >= ARRAY_SIZE(modes))
+    {
+        WARN("Unhandled composite mode %#x.\n", mode);
+        return context->bs;
+    }
+
+    if (mode == D2D1_COMPOSITE_MODE_SOURCE_OVER)
+        return context->bs;
+
+    if (context->composite_bs[mode])
+        return context->composite_bs[mode];
+
+    memset(&blend_desc, 0, sizeof(blend_desc));
+    blend_desc.IndependentBlendEnable = FALSE;
+    blend_desc.RenderTarget[0].BlendEnable = TRUE;
+    blend_desc.RenderTarget[0].SrcBlend = modes[mode].src;
+    blend_desc.RenderTarget[0].DestBlend = modes[mode].dst;
+    blend_desc.RenderTarget[0].BlendOp = D3D11_BLEND_OP_ADD;
+    blend_desc.RenderTarget[0].SrcBlendAlpha = modes[mode].src_alpha;
+    blend_desc.RenderTarget[0].DestBlendAlpha = modes[mode].dst_alpha;
+    blend_desc.RenderTarget[0].BlendOpAlpha = D3D11_BLEND_OP_ADD;
+    blend_desc.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL;
+
+    if (FAILED(hr = ID3D11Device1_CreateBlendState(context->d3d_device, &blend_desc,
+            &context->composite_bs[mode])))
+    {
+        WARN("Failed to create blend state for composite mode %#x, hr %#lx.\n", mode, hr);
+        return context->bs;
+    }
+
+    return context->composite_bs[mode];
+}
