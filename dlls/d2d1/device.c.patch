+/* Drawing goes to the layer's own target until it is popped, so that what is
+ * drawn can be masked and made transparent as a whole rather than a primitive
+ * at a time. */
+static HRESULT d2d_device_context_push_layer(struct d2d_device_context *context,
+        const D2D1_LAYER_PARAMETERS1 *parameters, ID2D1Layer *layer)
+{
+    struct d2d_layer_entry *entry;
+    struct d2d_bitmap *bitmap;
+    D2D1_RECT_F bounds;
+    HRESULT hr;
+    size_t i;
+
+    /* "A particular ID2D1Layer resource can be active only at one time." */
+    if (layer)
+    {
+        for (i = 0; i < context->layer_stack.count; ++i)
+        {
+            if (context->layer_stack.stack[i].layer == layer)
+            {
+                WARN("Layer %p is already pushed.\n", layer);
+                return D2DERR_LAYER_ALREADY_IN_USE;
+            }
+        }
+    }
+
+    if (!d2d_array_reserve((void **)&context->layer_stack.stack, &context->layer_stack.size,
+            context->layer_stack.count + 1, sizeof(*context->layer_stack.stack)))
+        return E_OUTOFMEMORY;
+
+    if (FAILED(hr = d2d_effect_create_intermediate(context, &context->pixel_size, &bitmap)))
+    {
+        WARN("Failed to create a target for the layer, hr %#lx.\n", hr);
+        return hr;
+    }
+
+    entry = &context->layer_stack.stack[context->layer_stack.count];
+    memset(entry, 0, sizeof(*entry));
+    entry->bitmap = bitmap;
+    entry->layer = layer;
+    if (layer)
+        ID2D1Layer_AddRef(layer);
+    if ((entry->mask = parameters->geometricMask))
+        ID2D1Geometry_AddRef(entry->mask);
+    if ((entry->opacity_brush = parameters->opacityBrush))
+        ID2D1Brush_AddRef(entry->opacity_brush);
+    entry->mask_transform = parameters->maskTransform;
+    entry->transform = context->drawing_state.transform;
+    entry->mask_antialias_mode = parameters->maskAntialiasMode;
+    entry->opacity = parameters->opacity;
+    entry->clip_count = context->clip_stack.count;
+
+    entry->target_object = context->target.object;
+    entry->target_type = context->target.type;
+    if (context->target.type == D2D_TARGET_COMMAND_LIST)
+        entry->target_command_list = context->target.command_list;
+    else
+        entry->target_bitmap = context->target.bitmap;
+    entry->target_hdc = context->target.hdc;
+
+    /* "Content won't render outside these bounds." They are given in the
+     * space the layer was pushed in, so they move with the transform. The
+     * clip rectangle is in pixels; the bounds are kept as they were given,
+     * because popping the layer draws them as a geometry. */
+    entry->content_bounds = parameters->contentBounds;
+    {
+        float x_scale = context->desc.dpiX / 96.0f, y_scale = context->desc.dpiY / 96.0f;
+        const D2D1_MATRIX_3X2_F *t = &context->drawing_state.transform;
+        const D2D1_RECT_F *r = &parameters->contentBounds;
+        D2D1_POINT_2F point;
+
+        d2d_point_transform(&point, t, r->left * x_scale, r->top * y_scale);
+        d2d_rect_set(&bounds, point.x, point.y, point.x, point.y);
+        d2d_point_transform(&point, t, r->left * x_scale, r->bottom * y_scale);
+        d2d_rect_expand(&bounds, &point);
+        d2d_point_transform(&point, t, r->right * x_scale, r->top * y_scale);
+        d2d_rect_expand(&bounds, &point);
+        d2d_point_transform(&point, t, r->right * x_scale, r->bottom * y_scale);
+        d2d_rect_expand(&bounds, &point);
+    }
+    if (!d2d_clip_stack_push(&context->clip_stack, &bounds))
+    {
+        ID2D1Bitmap1_Release(&bitmap->ID2D1Bitmap1_iface);
+        return E_OUTOFMEMORY;
+    }
+
+    context->target.object = (ID2D1Image *)&bitmap->ID2D1Bitmap1_iface;
+    context->target.type = D2D_TARGET_BITMAP;
+    context->target.bitmap = bitmap;
+    context->target.hdc = NULL;
+
+    /* "A premultiplied layer target is pushed and its contents are cleared to
+     * transparent black", unless the caller asked to keep what is there. */
+    if (!(parameters->layerOptions & D2D1_LAYER_OPTIONS1_INITIALIZE_FROM_BACKGROUND))
+    {
+        static const float transparent[4] = {0.0f};
+        ID3D11DeviceContext1 *d3d_context;
+
+        if (bitmap->rtv)
+        {
+            ID3D11Device1_GetImmediateContext1(context->d3d_device, &d3d_context);
+            ID3D11DeviceContext1_ClearRenderTargetView(d3d_context, bitmap->rtv, transparent);
+            ID3D11DeviceContext1_Release(d3d_context);
+        }
+    }
+
+    ++context->layer_stack.count;
+
+    return S_OK;
+}
