+static void d2d_layer_stack_cleanup(struct d2d_layer_stack *stack)
+{
+    struct d2d_layer_entry *entry;
+
+    while (stack->count)
+    {
+        entry = &stack->stack[--stack->count];
+        if (entry->opacity_brush)
+            ID2D1Brush_Release(entry->opacity_brush);
+        if (entry->mask)
+            ID2D1Geometry_Release(entry->mask);
+        if (entry->layer)
+            ID2D1Layer_Release(entry->layer);
+        ID2D1Bitmap1_Release(&entry->bitmap->ID2D1Bitmap1_iface);
+    }
+    free(stack->stack);
+}
