+/* Draws the brush over the pixel rectangle "bounds", attenuated by the
+ * coverage the pixel shader derives from the mode. */
+static void d2d_device_context_draw_coverage(struct d2d_device_context *context, const D2D1_RECT_F *bounds,
+        enum d2d_coverage_mode mode, const struct d2d_vec4 *coverage_rect, ID3D11ShaderResourceView *srv,
+        struct d2d_brush *brush, struct d2d_brush *opacity_brush)
+{
+    D2D1_MATRIX_3X2_F transform, inverse;
+    D3D11_SUBRESOURCE_DATA buffer_data;
+    D3D11_BUFFER_DESC buffer_desc;
+    D2D1_POINT_2F vertices[4];
+    struct d2d_vec4 clip_rect;
+    D2D1_RECT_F clip;
+    ID3D11Buffer *vb;
+    HRESULT hr;
+
+    d2d_device_context_get_clip_rect(context, &clip);
+    clip_rect.x = d2d_coverage_snap(clip.left);
+    clip_rect.y = d2d_coverage_snap(clip.top);
+    clip_rect.z = d2d_coverage_snap(clip.right);
+    clip_rect.w = d2d_coverage_snap(clip.bottom);
+
+    /* The vertex shader maps positions through the world transform and the
+     * DPI, and brushes are evaluated in the space before them. Mapping the
+     * corners back through the inverse puts the quad over the mask's pixels
+     * with the brushes positioned as for any other fill. The margin covers
+     * the rounding of that round trip; the shader gives pixels outside the
+     * mask no coverage. */
+    d2d_device_context_get_device_transform(context, &transform);
+    if (!d2d_matrix_invert(&inverse, &transform))
+        return;
+    d2d_point_transform(&vertices[0], &inverse, bounds->left - 1.0f, bounds->top - 1.0f);
+    d2d_point_transform(&vertices[1], &inverse, bounds->left - 1.0f, bounds->bottom + 1.0f);
+    d2d_point_transform(&vertices[2], &inverse, bounds->right + 1.0f, bounds->top - 1.0f);
+    d2d_point_transform(&vertices[3], &inverse, bounds->right + 1.0f, bounds->bottom + 1.0f);
+
+    if (FAILED(hr = d2d_device_context_update_vs_cb(context, &identity, 0.0f)))
+    {
+        WARN("Failed to update vs constant buffer, hr %#lx.\n", hr);
+        return;
+    }
+    if (FAILED(hr = d2d_device_context_update_ps_cb(context, brush, opacity_brush, FALSE, FALSE, mode,
+            coverage_rect, &clip_rect)))
+    {
+        WARN("Failed to update ps constant buffer, hr %#lx.\n", hr);
+        return;
+    }
+
+    buffer_desc.ByteWidth = sizeof(vertices);
+    buffer_desc.Usage = D3D11_USAGE_DEFAULT;
+    buffer_desc.BindFlags = D3D11_BIND_VERTEX_BUFFER;
+    buffer_desc.CPUAccessFlags = 0;
+    buffer_desc.MiscFlags = 0;
+    buffer_data.pSysMem = vertices;
+    buffer_data.SysMemPitch = 0;
+    buffer_data.SysMemSlicePitch = 0;
+    if (FAILED(hr = ID3D11Device1_CreateBuffer(context->d3d_device, &buffer_desc, &buffer_data, &vb)))
+    {
+        WARN("Failed to create vertex buffer, hr %#lx.\n", hr);
+        return;
+    }
+
+    d2d_device_context_draw(context, D2D_SHAPE_TYPE_TRIANGLE, context->ib, 6, vb, sizeof(*vertices),
+            brush, opacity_brush, srv, TRUE);
+
+    ID3D11Buffer_Release(vb);
+}
