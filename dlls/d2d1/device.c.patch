+/* Custom effect pixel shaders are compiled against a fixed D2D signature:
+ *
+ *     float4 main(float4 clip : SV_POSITION, float4 scene : SCENE_POSITION,
+ *                 float4 uv0 : TEXCOORD0, ...) : SV_TARGET
+ *
+ * A pixel shader's input semantics must be a subset of the vertex shader's
+ * output semantics, so this emits SCENE_POSITION even though nothing here
+ * consumes it -- an effect shader that declares it would otherwise fail to
+ * link. Positions are transformed on the CPU, so this is a pass-through. */
+static const char effect_vs_code[] =
+    "struct output\n"
+    "{\n"
+    "    float4 scene : SCENE_POSITION;\n"
+    "    float4 position : SV_POSITION;\n"
+    "};\n"
+    "\n"
+    "void main(float4 position : POSITION, float4 scene : SCENE_POSITION, out struct output o)\n"
+    "{\n"
+    "    o.position = position;\n"
+    "    o.scene = scene;\n"
+    "}\n";
+
+struct d2d_effect_vertex
+{
+    struct d2d_vec4 position;
+    struct d2d_vec4 scene;
+};
+
+static HRESULT d2d_device_context_ensure_effect_resources(struct d2d_device_context *context)
+{
+    static const D3D11_INPUT_ELEMENT_DESC il_desc[] =
+    {
+        {"POSITION", 0, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 0, D3D11_INPUT_PER_VERTEX_DATA, 0},
+        {"SCENE_POSITION", 0, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, 16, D3D11_INPUT_PER_VERTEX_DATA, 0},
+    };
+    ID3D10Blob *compiled, *errors;
+    HRESULT hr;
+
+    if (context->effect_vs)
+        return S_OK;
+
+    if (FAILED(hr = D3DCompile(effect_vs_code, sizeof(effect_vs_code) - 1, "effect_vs", NULL, NULL,
+            "main", "vs_4_0", 0, 0, &compiled, &errors)))
+    {
+        WARN("Failed to compile the effect vertex shader, hr %#lx.\n", hr);
+        if (errors)
+        {
+            WARN("%s\n", (char *)ID3D10Blob_GetBufferPointer(errors));
+            ID3D10Blob_Release(errors);
+        }
+        return hr;
+    }
+    if (errors)
+        ID3D10Blob_Release(errors);
+
+    if (FAILED(hr = ID3D11Device1_CreateVertexShader(context->d3d_device,
+            ID3D10Blob_GetBufferPointer(compiled), ID3D10Blob_GetBufferSize(compiled),
+            NULL, &context->effect_vs)))
+    {
+        WARN("Failed to create the effect vertex shader, hr %#lx.\n", hr);
+        ID3D10Blob_Release(compiled);
+        return hr;
+    }
+
+    hr = ID3D11Device1_CreateInputLayout(context->d3d_device, il_desc, ARRAY_SIZE(il_desc),
+            ID3D10Blob_GetBufferPointer(compiled), ID3D10Blob_GetBufferSize(compiled),
+            &context->effect_il);
+    ID3D10Blob_Release(compiled);
+    if (FAILED(hr))
+    {
+        WARN("Failed to create the effect input layout, hr %#lx.\n", hr);
+        ID3D11VertexShader_Release(context->effect_vs);
+        context->effect_vs = NULL;
+        return hr;
+    }
+
+    return S_OK;
+}
