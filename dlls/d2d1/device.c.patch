+static HRESULT d2d_device_context_upload_coverage(struct d2d_device_context *context,
+        const struct d2d_coverage_mask *mask)
+{
+    D3D11_MAPPED_SUBRESOURCE map_desc;
+    ID3D11DeviceContext *d3d_context;
+    D3D11_TEXTURE2D_DESC desc;
+    unsigned int y;
+    HRESULT hr;
+
+    if (mask->width > context->coverage_width || mask->height > context->coverage_height)
+    {
+        if (context->coverage_srv)
+            ID3D11ShaderResourceView_Release(context->coverage_srv);
+        if (context->coverage_texture)
+            ID3D11Texture2D_Release(context->coverage_texture);
+        context->coverage_srv = NULL;
+        context->coverage_texture = NULL;
+
+        desc.Width = max(context->coverage_width, (mask->width + 63) & ~63u);
+        desc.Height = max(context->coverage_height, (mask->height + 63) & ~63u);
+        desc.MipLevels = 1;
+        desc.ArraySize = 1;
+        desc.Format = DXGI_FORMAT_R8_UNORM;
+        desc.SampleDesc.Count = 1;
+        desc.SampleDesc.Quality = 0;
+        desc.Usage = D3D11_USAGE_DYNAMIC;
+        desc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+        desc.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+        desc.MiscFlags = 0;
+        if (FAILED(hr = ID3D11Device1_CreateTexture2D(context->d3d_device, &desc, NULL, &context->coverage_texture)))
+        {
+            WARN("Failed to create coverage texture, hr %#lx.\n", hr);
+            context->coverage_width = context->coverage_height = 0;
+            return hr;
+        }
+        if (FAILED(hr = ID3D11Device1_CreateShaderResourceView(context->d3d_device,
+                (ID3D11Resource *)context->coverage_texture, NULL, &context->coverage_srv)))
+        {
+            WARN("Failed to create coverage view, hr %#lx.\n", hr);
+            ID3D11Texture2D_Release(context->coverage_texture);
+            context->coverage_texture = NULL;
+            context->coverage_width = context->coverage_height = 0;
+            return hr;
+        }
+        context->coverage_width = desc.Width;
+        context->coverage_height = desc.Height;
+    }
+
+    ID3D11Device1_GetImmediateContext(context->d3d_device, &d3d_context);
+    if (FAILED(hr = ID3D11DeviceContext_Map(d3d_context, (ID3D11Resource *)context->coverage_texture,
+            0, D3D11_MAP_WRITE_DISCARD, 0, &map_desc)))
+    {
+        WARN("Failed to map coverage texture, hr %#lx.\n", hr);
+        ID3D11DeviceContext_Release(d3d_context);
+        return hr;
+    }
+    for (y = 0; y < mask->height; ++y)
+        memcpy((BYTE *)map_desc.pData + y * map_desc.RowPitch, mask->data + (size_t)y * mask->width, mask->width);
+    ID3D11DeviceContext_Unmap(d3d_context, (ID3D11Resource *)context->coverage_texture, 0);
+    ID3D11DeviceContext_Release(d3d_context);
+
+    return S_OK;
+}
