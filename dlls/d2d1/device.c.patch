+        if (!d2d_transform_node_map_input_rect(node->object, &input_rects[0], &rect))
+            rect = input_rects[0];
+    }
+
+    /* Keep the unclipped mapping; the pass-through case below needs to know
+     * how the transform moved the region, which clipping would obscure. */
+    mapped = rect;
+
+    /* A transform whose output is conceptually unbounded reports a rect
+     * covering the whole logical plane. Clipping to the region that was asked
+     * for keeps the intermediate to a size that can actually be allocated,
+     * and matches D2D only producing the area that is needed. */
+    if (rect.left < requested_rect->left)
+        rect.left = requested_rect->left;
+    if (rect.top < requested_rect->top)
+        rect.top = requested_rect->top;
+    if (rect.right > requested_rect->right)
+        rect.right = requested_rect->right;
+    if (rect.bottom > requested_rect->bottom)
+        rect.bottom = requested_rect->bottom;
+
+    if (d2d_rect_l_width(&rect) <= 0 || d2d_rect_l_height(&rect) <= 0)
+    {
+        WARN("Node %p has an empty output rect.\n", node);
+        hr = E_FAIL;
+        goto done;
+    }
+
+    *out_rect = rect;
+
+    /* A node standing in for a nested effect: feed it the inputs resolved
+     * here and evaluate its own graph. */
+    if ((nested = d2d_transform_node_get_effect(node->object)))
+    {
+        struct d2d_effect *nested_impl = unsafe_impl_from_ID2D1Effect(nested);
+
+        if (!nested_impl)
+        {
+            FIXME("Nested effect %p is not implemented here.\n", nested);
+            hr = E_NOTIMPL;
+            goto done;
+        }
+
+        for (i = 0; i < node->input_count; ++i)
+        {
+            if (inputs[i])
+                ID2D1Effect_SetInput(nested, i,
+                        (ID2D1Image *)&inputs[i]->ID2D1Bitmap1_iface, TRUE);
+        }
+
+        hr = d2d_effect_run_graph(context, nested_impl, &rect, depth + 1, out, out_rect);
+
+        /* Drop the inputs again. They are intermediates owned by this
+         * evaluation, and leaving them set would have the nested effect hold
+         * references to them until it is next drawn or destroyed. */
+        for (i = 0; i < node->input_count; ++i)
+            ID2D1Effect_SetInput(nested, i, NULL, TRUE);
+
+        goto done;
+    }
+
+    /* Nodes without a pixel shader are not draw transforms: offset, border
+     * and bounds adjustment transforms only move or extend rectangles, which
+     * the rect mapping above has already accounted for, so the input image
+     * passes through unchanged. */
+    if (!node->render_info || !(node->render_info->mask & D2D_RENDER_INFO_PIXEL_SHADER))
+    {
+        if (node->input_count == 1 && inputs[0]
+                && d2d_rect_l_width(&mapped) == d2d_rect_l_width(&input_rects[0])
+                && d2d_rect_l_height(&mapped) == d2d_rect_l_height(&input_rects[0]))
+        {
+            /* The transform only translates the region -- an offset transform
+             * -- so the pixels are the input's, just at a different place. */
+            *out = inputs[0];
+            ID2D1Bitmap1_AddRef(&(*out)->ID2D1Bitmap1_iface);
+            *out_rect = mapped;
+            hr = S_OK;
+            goto done;
+        }
+        else if (node->input_count == 1 && inputs[0])
+        {
+            /* The region changed size: a crop shrinks it, a border grows it.
+             * Resample the input into an intermediate covering the new rect,
+             * which clips or clamp-extends as the transform asked. */
+            copy_shader = TRUE;
+        }
+        else
+        {
+            FIXME("Node %p has no pixel shader and %u inputs.\n", node, node->input_count);
+            hr = E_NOTIMPL;
+            goto done;
+        }
+    }
+
+    if (copy_shader)
+    {
+        if (FAILED(hr = d2d_device_context_get_copy_shader(context, &ps)))
+            goto done;
+    }
+    else
+    {
+        if (!d2d_device_get_indexed_object(&context->device->shaders,
+                &node->render_info->pixel_shader, &object))
+        {
+            WARN("Pixel shader %s is not loaded.\n", debugstr_guid(&node->render_info->pixel_shader));
+            hr = E_FAIL;
+            goto done;
+        }
+        hr = IUnknown_QueryInterface(object, &IID_ID3D11PixelShader, (void **)&ps);
+        IUnknown_Release(object);
+        if (FAILED(hr))
+        {
+            WARN("Object %s is not a pixel shader, hr %#lx.\n",
+                    debugstr_guid(&node->render_info->pixel_shader), hr);
+            goto done;
+        }
+    }
+
+    if (FAILED(hr = d2d_device_context_get_effect_shader(context, node->input_count, &vs, &il)))
+        goto done;
+
+    size.width = d2d_rect_l_width(&rect);
+    size.height = d2d_rect_l_height(&rect);
+
+    if (FAILED(hr = d2d_effect_create_intermediate(context, &size, &target)))
+    {
+        WARN("Failed to create an intermediate target, hr %#lx.\n", hr);
+        goto done;
+    }
+    if (!target->rtv)
+    {
+        WARN("Intermediate target has no render target view.\n");
+        hr = E_FAIL;
+        goto done;
+    }
+
+    d2d_effect_fill_quad(vertices, &rect, input_rects, node->input_count);
+
+    buffer_desc.ByteWidth = sizeof(vertices);
+    buffer_desc.Usage = D3D11_USAGE_DEFAULT;
+    buffer_desc.BindFlags = D3D11_BIND_VERTEX_BUFFER;
+    buffer_desc.CPUAccessFlags = 0;
+    buffer_desc.MiscFlags = 0;
+    buffer_desc.StructureByteStride = 0;
+
+    vertex_data.pSysMem = vertices;
+    vertex_data.SysMemPitch = 0;
+    vertex_data.SysMemSlicePitch = 0;
+
+    if (FAILED(hr = ID3D11Device1_CreateBuffer(context->d3d_device, &buffer_desc, &vertex_data, &vb)))
+    {
+        WARN("Failed to create the effect vertex buffer, hr %#lx.\n", hr);
+        goto done;
+    }
+
+    if (!copy_shader && node->render_info->mask & D2D_RENDER_INFO_PS_CONSTANT_BUFFER
+            && node->render_info->ps_cb_size)
+    {
+        D3D11_SUBRESOURCE_DATA cb_data;
+        BYTE *padded;
+
+        /* Constant buffers are sized in whole 16-byte registers, so the tail
+         * has to be padded rather than left uninitialised. */
+        buffer_desc.ByteWidth = (node->render_info->ps_cb_size + 15) & ~15u;
+        buffer_desc.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+
+        if (!(padded = calloc(1, buffer_desc.ByteWidth)))
+        {
+            hr = E_OUTOFMEMORY;
+            goto done;
+        }
+        memcpy(padded, node->render_info->ps_cb, node->render_info->ps_cb_size);
+
+        cb_data.pSysMem = padded;
+        cb_data.SysMemPitch = 0;
+        cb_data.SysMemSlicePitch = 0;
+
+        hr = ID3D11Device1_CreateBuffer(context->d3d_device, &buffer_desc, &cb_data, &cb);
+        free(padded);
+        if (FAILED(hr))
+        {
+            WARN("Failed to create the effect constant buffer, hr %#lx.\n", hr);
+            goto done;
+        }
+    }
+
+    for (i = 0; i < node->input_count; ++i)
+    {
+        srvs[i] = inputs[i] ? inputs[i]->srv : NULL;
+        samplers[i] = d2d_effect_get_sampler(context, copy_shader);
+    }
+
+    vp.TopLeftX = 0.0f;
+    vp.TopLeftY = 0.0f;
+    vp.Width = size.width;
+    vp.Height = size.height;
+    vp.MinDepth = 0.0f;
+    vp.MaxDepth = 1.0f;
+
+    if (context->cs)
+        EnterCriticalSection(context->cs);
+
+    ID3D11Device1_GetImmediateContext1(context->d3d_device, &d3d_context);
+    ID3D11DeviceContext1_SwapDeviceContextState(d3d_context, context->d3d_state, &prev_state);
+
+    stride = sizeof(*vertices);
+    offset = 0;
+    ID3D11DeviceContext1_IASetInputLayout(d3d_context, il);
+    ID3D11DeviceContext1_IASetPrimitiveTopology(d3d_context, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    ID3D11DeviceContext1_IASetVertexBuffers(d3d_context, 0, 1, &vb, &stride, &offset);
+    ID3D11DeviceContext1_VSSetShader(d3d_context, vs, NULL, 0);
+    ID3D11DeviceContext1_PSSetShader(d3d_context, ps, NULL, 0);
+    if (cb)
+        ID3D11DeviceContext1_PSSetConstantBuffers(d3d_context, 0, 1, &cb);
+    if (node->input_count)
+    {
+        ID3D11DeviceContext1_PSSetShaderResources(d3d_context, 0, node->input_count, srvs);
+        ID3D11DeviceContext1_PSSetSamplers(d3d_context, 0, node->input_count, samplers);
+    }
+    ID3D11DeviceContext1_RSSetViewports(d3d_context, 1, &vp);
+    ID3D11DeviceContext1_RSSetState(d3d_context, NULL);
+    ID3D11DeviceContext1_OMSetRenderTargets(d3d_context, 1, &target->rtv, NULL);
+    /* d2d_bitmap_create() leaves the texture uninitialised. */
+    ID3D11DeviceContext1_ClearRenderTargetView(d3d_context, target->rtv, transparent);
+    ID3D11DeviceContext1_OMSetBlendState(d3d_context, NULL, NULL, D3D11_DEFAULT_SAMPLE_MASK);
+
+    ID3D11DeviceContext1_Draw(d3d_context, ARRAY_SIZE(vertices), 0);
+
+    ID3D11DeviceContext1_SwapDeviceContextState(d3d_context, prev_state, NULL);
+    ID3D11DeviceContext1_Release(d3d_context);
+    ID3DDeviceContextState_Release(prev_state);
+
+    if (context->cs)
+        LeaveCriticalSection(context->cs);
+
+
+    *out = target;
+    target = NULL;
+    hr = S_OK;
+
+done:
+    if (transform)
+        ID2D1Transform_Release(transform);
+    if (target)
+        ID2D1Bitmap1_Release(&target->ID2D1Bitmap1_iface);
+    if (cb)
+        ID3D11Buffer_Release(cb);
+    if (vb)
+        ID3D11Buffer_Release(vb);
+    if (ps)
+        ID3D11PixelShader_Release(ps);
+    for (i = 0; i < node->input_count; ++i)
+    {
+        if (inputs[i])
+            ID2D1Bitmap1_Release(&inputs[i]->ID2D1Bitmap1_iface);
+    }
+
+    return hr;
+}
+
+/* Evaluate an effect's transform graph, returning the rendered result and the
+ * rect it covers in the effect's coordinate space. */
+/* An effect refreshes its render info -- in particular its pixel shader
+ * constants -- and may rebuild its transform graph from PrepareForRender(),
+ * so nothing may be decided from the graph before it has run. D2D calls it
+ * when the effect is first drawn or measured, and again after a property
+ * change, not every time. */
+static HRESULT d2d_effect_prepare(struct d2d_effect *effect)
+{
+    HRESULT hr;
+
+    if (!effect->effect_impl || effect->pending_change == D2D1_CHANGE_TYPE_NONE)
+        return S_OK;
+
+    if (FAILED(hr = ID2D1EffectImpl_PrepareForRender(effect->effect_impl, effect->pending_change)))
+    {
+        WARN("PrepareForRender() failed, hr %#lx.\n", hr);
+        return hr;
+    }
+    effect->pending_change = D2D1_CHANGE_TYPE_NONE;
+
+    return S_OK;
+}
+
+static HRESULT d2d_effect_run_graph(struct d2d_device_context *context, struct d2d_effect *effect,
+        const D2D1_RECT_L *requested, unsigned int depth, struct d2d_bitmap **out,
+        D2D1_RECT_L *out_rect)
+{
+    HRESULT hr;
+
+    if (depth > D2D_EFFECT_MAX_GRAPH_DEPTH)
+    {
+        WARN("Effects are nested too deeply.\n");
+        return E_FAIL;
+    }
+
+    if (!effect->graph)
+    {
+        WARN("Effect %p has no transform graph.\n", effect);
+        return E_FAIL;
+    }
+
+    if (d2d_rect_l_width(requested) <= 0 || d2d_rect_l_height(requested) <= 0)
+    {
+        WARN("Requested rect %s is empty.\n", wine_dbgstr_rect((const RECT *)requested));
+        return E_FAIL;
+    }
+
+    if (FAILED(hr = d2d_effect_prepare(effect)))
+        return hr;
+
+    /* A passthrough graph's output is one of the effect's inputs, unchanged,
+     * whatever nodes the graph holds. */
+    if (effect->graph->passthrough)
+        return d2d_effect_resolve_effect_input(context, effect, effect->graph->passthrough_input,
+                requested, depth, out, out_rect);
+
+    if (!effect->graph->output)
+    {
+        WARN("Effect %p has no output node.\n", effect);
+        return E_FAIL;
+    }
+
+    return d2d_effect_render_node(context, effect, effect->graph->output, requested, depth,
+            out, out_rect);
+}
+
+static void d2d_device_context_draw_effect(struct d2d_device_context *context, ID2D1Effect *effect,
+        const D2D1_RECT_F *dst_rect, float opacity, D2D1_INTERPOLATION_MODE interpolation_mode,
+        const D2D1_RECT_F *src_rect, const D2D1_POINT_2F *offset,
+        const D2D1_MATRIX_4X4_F *perspective_transform)
+{
+    struct d2d_effect *effect_impl;
+    struct d2d_bitmap *result;
+    D2D1_RECT_L result_rect;
+    ID2D1Image *input;
+    unsigned int i;
+    HRESULT hr;
+
+    if ((effect_impl = unsafe_impl_from_ID2D1Effect(effect)))
+    {
+        D2D1_RECT_L requested;
+        D2D1_RECT_F d;
+
+        /* The region the caller wants bounds the whole evaluation. Effects
+         * whose output is conceptually unbounded are clipped to it, so this
+         * has to reflect what was actually asked for -- using the full target
+         * here makes such an effect cover the entire render target. */
+        const D2D1_RECT_F *hint = src_rect ? src_rect : dst_rect;
+
+        /* Start from the target, which is the largest region that can ever be
+         * visible, then narrow to what the caller asked for. The hint is
+         * clamped rather than converted directly: D2D uses very large floats
+         * to mean "unbounded", and converting those to LONG is undefined and
+         * yields a rect that cannot be allocated. */
+        requested.left = 0;
+        requested.top = 0;
+        requested.right = context->pixel_size.width;
+        requested.bottom = context->pixel_size.height;
+
+        if (hint)
+        {
+            if (hint->left > 0.0f && hint->left < (float)requested.right)
+                requested.left = floorf(hint->left);
+            if (hint->top > 0.0f && hint->top < (float)requested.bottom)
+                requested.top = floorf(hint->top);
+            if (hint->right > (float)requested.left && hint->right < (float)requested.right)
+                requested.right = ceilf(hint->right);
+            if (hint->bottom > (float)requested.top && hint->bottom < (float)requested.bottom)
+                requested.bottom = ceilf(hint->bottom);
+        }
+
+        if (FAILED(hr = d2d_effect_run_graph(context, effect_impl, &requested, 0, &result, &result_rect)))
+        {
+            WARN("Failed to run the graph of effect %s, hr %#lx.\n",
+                    debugstr_guid(&effect_impl->id), hr);
+            goto fallback;
+        }
+
+
+        /* The intermediate holds exactly the effect's output rect, so it is
+         * drawn at that rect rather than stretched over the target. An
+         * explicit dst_rect still wins, matching DrawImage(). */
+        if (dst_rect)
+        {
+            d = *dst_rect;
+        }
+        else
+        {
+            float x, y;
+
+            /* DrawImage() places the requested region of the image at
+             * target_offset, so the destination is that offset plus the size
+             * of the region -- not plus its origin, which would apply the
+             * position twice. */
+            x = offset ? offset->x : (float)result_rect.left;
+            y = offset ? offset->y : (float)result_rect.top;
+
+            d2d_rect_set(&d, x, y,
+                    x + d2d_rect_l_width(&result_rect),
+                    y + d2d_rect_l_height(&result_rect));
+        }
+
+
+        /* src_rect selects part of the source image; the intermediate already
+         * covers only what the graph produced, so it is drawn whole. */
+        d2d_device_context_draw_bitmap(context, (ID2D1Bitmap *)&result->ID2D1Bitmap1_iface,
+                &d, opacity, d2d1_1_interp_mode_from_d2d1(interpolation_mode),
+                NULL, NULL, perspective_transform);
+        ID2D1Bitmap1_Release(&result->ID2D1Bitmap1_iface);
+        return;
+    }
+
+fallback:
+    FIXME("Drawing first input image instead of actual effect. context %p, effect %p, dst_rect %s, opacity %.8e, interpolation_mode %#x, src_rect %s, offset %p, perspective_transform %p.\n",
+            context, effect, debug_d2d_rect_f(dst_rect), opacity, interpolation_mode, debug_d2d_rect_f(src_rect), offset, perspective_transform);
+
+    for (i = 0; i < ID2D1Effect_GetInputCount(effect); ++i)
+    {
+        ID2D1Effect_GetInput(effect, i, &input);
+        if (input == NULL) continue;
+
+        ID2D1DeviceContext6_DrawImage(&context->ID2D1DeviceContext6_iface, input,
+                offset, src_rect, interpolation_mode,
+                D2D1_COMPOSITE_MODE_SOURCE_OVER);
+
+        ID2D1Image_Release(input);
+        return;
+    }
+
+    FIXME("No input to draw\n");
+
+}
