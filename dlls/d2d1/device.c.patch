+/* Map a point from DIP space through the current world transform into clip
+ * space, matching what the shape vertex shaders do on the GPU. */
+static void d2d_device_context_transform_to_clip(const struct d2d_device_context *context,
+        float x, float y, struct d2d_vec4 *out, struct d2d_vec4 *scene)
+{
+    const D2D_MATRIX_3X2_F *w = &context->drawing_state.transform;
+    float dpi_x = context->desc.dpiX / 96.0f;
+    float dpi_y = context->desc.dpiY / 96.0f;
+    float sx, sy;
+
+    sx = (w->_11 * x + w->_21 * y + w->_31) * dpi_x;
+    sy = (w->_12 * x + w->_22 * y + w->_32) * dpi_y;
+
+    scene->x = sx;
+    scene->y = sy;
+    scene->z = 0.0f;
+    scene->w = 1.0f;
+
+    out->x = sx * (2.0f / context->pixel_size.width) - 1.0f;
+    out->y = sy * (-2.0f / context->pixel_size.height) + 1.0f;
+    out->z = 0.0f;
+    out->w = 1.0f;
+}
