+/* Produce one of the effect's own inputs as a bitmap. */
+static HRESULT d2d_effect_resolve_effect_input(struct d2d_device_context *context,
+        struct d2d_effect *effect, unsigned int i, const D2D1_RECT_L *requested_rect,
+        unsigned int depth, struct d2d_bitmap **out, D2D1_RECT_L *out_rect)
+{
+    ID2D1CommandList *command_list;
+    ID2D1Effect *input_effect;
+    ID2D1Bitmap *bitmap_iface;
+    D2D1_SIZE_U size;
+    HRESULT hr;
+
+    *out = NULL;
+
+    if (i >= effect->input_count || !effect->inputs[i])
+    {
+        WARN("Effect %p input %u is not set.\n", effect, i);
+        return E_FAIL;
+    }
+
+    /* An input that is itself an effect is evaluated in turn, so that a chain
+     * of effects resolves rather than stopping here. */
+    if (SUCCEEDED(ID2D1Image_QueryInterface(effect->inputs[i], &IID_ID2D1Effect,
+            (void **)&input_effect)))
+    {
+        struct d2d_effect *input_impl = unsafe_impl_from_ID2D1Effect(input_effect);
+
+        hr = input_impl ? d2d_effect_run_graph(context, input_impl, requested_rect,
+                depth + 1, out, out_rect) : E_NOTIMPL;
+        ID2D1Effect_Release(input_effect);
+        if (FAILED(hr))
+            FIXME("Failed to evaluate input effect %p, hr %#lx.\n", effect->inputs[i], hr);
+        return hr;
+    }
+
+    /* A command list has to be replayed into an intermediate before it can
+     * be sampled. It has no size of its own, so it is drawn over exactly the
+     * region that was asked for. */
+    if (SUCCEEDED(ID2D1Image_QueryInterface(effect->inputs[i], &IID_ID2D1CommandList,
+            (void **)&command_list)))
+    {
+        hr = d2d_effect_rasterise_command_list(context, command_list, requested_rect, out);
+        ID2D1CommandList_Release(command_list);
+        if (SUCCEEDED(hr))
+            *out_rect = *requested_rect;
+        return hr;
+    }
+
+    if (FAILED(hr = ID2D1Image_QueryInterface(effect->inputs[i], &IID_ID2D1Bitmap,
+            (void **)&bitmap_iface)))
+    {
+        FIXME("Unsupported input image %p.\n", effect->inputs[i]);
+        return hr;
+    }
