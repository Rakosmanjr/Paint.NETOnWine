+/* The transform from the space brushes and geometry are given in to target
+ * pixels: the world transform, then the DPI. */
+static void d2d_device_context_get_device_transform(const struct d2d_device_context *context,
+        D2D1_MATRIX_3X2_F *transform)
+{
+    D2D1_MATRIX_3X2_F dpi = {{{context->desc.dpiX / 96.0f, 0.0f, 0.0f, context->desc.dpiY / 96.0f, 0.0f, 0.0f}}};
+
+    *transform = context->drawing_state.transform;
+    d2d_matrix_multiply(transform, &dpi);
+}
+
+/* The part of the target, in pixels, that drawing is limited to. */
+static void d2d_device_context_get_clip_rect(const struct d2d_device_context *context, D2D1_RECT_F *rect)
+{
+    d2d_rect_set(rect, 0.0f, 0.0f, context->pixel_size.width, context->pixel_size.height);
+    if (context->clip_stack.count)
+        d2d_rect_intersect(rect, &context->clip_stack.stack[context->clip_stack.count - 1]);
+}
