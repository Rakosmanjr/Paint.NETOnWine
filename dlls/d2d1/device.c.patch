+/* Render a single draw-transform node by running its pixel shader over
+ * dst_rect. This covers effects whose graph is one node with no inputs --
+ * generators such as a checkerboard or a solid fill, which produce their
+ * output entirely from the shader and so cannot be approximated by drawing
+ * an input image. */
+static HRESULT d2d_device_context_draw_effect_node(struct d2d_device_context *context,
+        const struct d2d_render_info *render_info, const D2D1_RECT_F *dst_rect)
+{
+    ID3D11DeviceContext1 *d3d_context;
+    ID3DDeviceContextState *prev_state;
+    struct d2d_effect_vertex vertices[6];
+    D3D11_SUBRESOURCE_DATA vertex_data;
+    ID3D11Buffer *vb = NULL, *cb = NULL;
+    struct d2d_vec4 corners[4], scene[4];
+    ID3D11PixelShader *ps = NULL;
+    D3D11_BUFFER_DESC buffer_desc;
+    unsigned int stride, offset;
+    D3D11_RECT scissor_rect;
+    IUnknown *object;
+    D3D11_VIEWPORT vp;
+    HRESULT hr;
+
+    if (!d2d_device_get_indexed_object(&context->device->shaders, &render_info->pixel_shader, &object))
+    {
+        WARN("Pixel shader %s is not loaded.\n", debugstr_guid(&render_info->pixel_shader));
+        return E_FAIL;
+    }
+
+    hr = IUnknown_QueryInterface(object, &IID_ID3D11PixelShader, (void **)&ps);
+    IUnknown_Release(object);
+    if (FAILED(hr))
+    {
+        WARN("Object %s is not a pixel shader, hr %#lx.\n", debugstr_guid(&render_info->pixel_shader), hr);
+        return hr;
+    }
+
+    if (FAILED(hr = d2d_device_context_ensure_effect_resources(context)))
+        goto done;
+
+    d2d_device_context_transform_to_clip(context, dst_rect->left,  dst_rect->top,    &corners[0], &scene[0]);
+    d2d_device_context_transform_to_clip(context, dst_rect->right, dst_rect->top,    &corners[1], &scene[1]);
+    d2d_device_context_transform_to_clip(context, dst_rect->left,  dst_rect->bottom, &corners[2], &scene[2]);
+    d2d_device_context_transform_to_clip(context, dst_rect->right, dst_rect->bottom, &corners[3], &scene[3]);
+
+    /* Two triangles: 0,1,2 and 2,1,3. */
+    vertices[0].position = corners[0]; vertices[0].scene = scene[0];
+    vertices[1].position = corners[1]; vertices[1].scene = scene[1];
+    vertices[2].position = corners[2]; vertices[2].scene = scene[2];
+    vertices[3].position = corners[2]; vertices[3].scene = scene[2];
+    vertices[4].position = corners[1]; vertices[4].scene = scene[1];
+    vertices[5].position = corners[3]; vertices[5].scene = scene[3];
+
+    buffer_desc.ByteWidth = sizeof(vertices);
+    buffer_desc.Usage = D3D11_USAGE_DEFAULT;
+    buffer_desc.BindFlags = D3D11_BIND_VERTEX_BUFFER;
+    buffer_desc.CPUAccessFlags = 0;
+    buffer_desc.MiscFlags = 0;
+    buffer_desc.StructureByteStride = 0;
+
+    vertex_data.pSysMem = vertices;
+    vertex_data.SysMemPitch = 0;
+    vertex_data.SysMemSlicePitch = 0;
+
+    if (FAILED(hr = ID3D11Device1_CreateBuffer(context->d3d_device, &buffer_desc, &vertex_data, &vb)))
+    {
+        WARN("Failed to create the effect vertex buffer, hr %#lx.\n", hr);
+        goto done;
+    }
+
+    if (render_info->mask & D2D_RENDER_INFO_PS_CONSTANT_BUFFER && render_info->ps_cb_size)
+    {
+        D3D11_SUBRESOURCE_DATA cb_data;
+
+        /* Constant buffers are sized in whole 16-byte registers. */
+        buffer_desc.ByteWidth = (render_info->ps_cb_size + 15) & ~15u;
+        buffer_desc.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+
+        cb_data.pSysMem = render_info->ps_cb;
+        cb_data.SysMemPitch = 0;
+        cb_data.SysMemSlicePitch = 0;
+
+        if (buffer_desc.ByteWidth != render_info->ps_cb_size)
+        {
+            /* The tail padding would otherwise be uninitialised. */
+            BYTE *padded;
+
+            if (!(padded = calloc(1, buffer_desc.ByteWidth)))
+            {
+                hr = E_OUTOFMEMORY;
+                goto done;
+            }
+            memcpy(padded, render_info->ps_cb, render_info->ps_cb_size);
+            cb_data.pSysMem = padded;
+            hr = ID3D11Device1_CreateBuffer(context->d3d_device, &buffer_desc, &cb_data, &cb);
+            free(padded);
+        }
+        else
+        {
+            hr = ID3D11Device1_CreateBuffer(context->d3d_device, &buffer_desc, &cb_data, &cb);
+        }
+
+        if (FAILED(hr))
+        {
+            WARN("Failed to create the effect constant buffer, hr %#lx.\n", hr);
+            goto done;
+        }
+    }
+
+    vp.TopLeftX = 0.0f;
+    vp.TopLeftY = 0.0f;
+    vp.Width = context->pixel_size.width;
+    vp.Height = context->pixel_size.height;
+    vp.MinDepth = 0.0f;
+    vp.MaxDepth = 1.0f;
+
+    if (context->clip_stack.count)
+    {
+        const D2D1_RECT_F *clip_rect = &context->clip_stack.stack[context->clip_stack.count - 1];
+
+        scissor_rect.left = ceilf(clip_rect->left - 0.5f);
+        scissor_rect.top = ceilf(clip_rect->top - 0.5f);
+        scissor_rect.right = ceilf(clip_rect->right - 0.5f);
+        scissor_rect.bottom = ceilf(clip_rect->bottom - 0.5f);
+    }
+    else
+    {
+        scissor_rect.left = 0;
+        scissor_rect.top = 0;
+        scissor_rect.right = context->pixel_size.width;
+        scissor_rect.bottom = context->pixel_size.height;
+    }
+
+    if (context->cs)
+        EnterCriticalSection(context->cs);
+
+    ID3D11Device1_GetImmediateContext1(context->d3d_device, &d3d_context);
+    ID3D11DeviceContext1_SwapDeviceContextState(d3d_context, context->d3d_state, &prev_state);
+
+    stride = sizeof(*vertices);
+    offset = 0;
+    ID3D11DeviceContext1_IASetInputLayout(d3d_context, context->effect_il);
+    ID3D11DeviceContext1_IASetPrimitiveTopology(d3d_context, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    ID3D11DeviceContext1_IASetVertexBuffers(d3d_context, 0, 1, &vb, &stride, &offset);
+    ID3D11DeviceContext1_VSSetShader(d3d_context, context->effect_vs, NULL, 0);
+    ID3D11DeviceContext1_PSSetShader(d3d_context, ps, NULL, 0);
+    if (cb)
+        ID3D11DeviceContext1_PSSetConstantBuffers(d3d_context, 0, 1, &cb);
+    ID3D11DeviceContext1_RSSetViewports(d3d_context, 1, &vp);
+    ID3D11DeviceContext1_RSSetScissorRects(d3d_context, 1, &scissor_rect);
+    ID3D11DeviceContext1_RSSetState(d3d_context, context->rs);
+    ID3D11DeviceContext1_OMSetRenderTargets(d3d_context, 1, &context->target.bitmap->rtv, NULL);
+    ID3D11DeviceContext1_OMSetBlendState(d3d_context, context->bs, NULL, D3D11_DEFAULT_SAMPLE_MASK);
+
+    ID3D11DeviceContext1_Draw(d3d_context, ARRAY_SIZE(vertices), 0);
+
+    ID3D11DeviceContext1_SwapDeviceContextState(d3d_context, prev_state, NULL);
+    ID3D11DeviceContext1_Release(d3d_context);
+    ID3DDeviceContextState_Release(prev_state);
+
+    if (context->cs)
+        LeaveCriticalSection(context->cs);
+
+    hr = S_OK;
+
+done:
+    if (cb)
+        ID3D11Buffer_Release(cb);
+    if (vb)
+        ID3D11Buffer_Release(vb);
+    ID3D11PixelShader_Release(ps);
+
+    return hr;
+}
