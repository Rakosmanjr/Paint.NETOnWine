+/* Returns the render info for an effect that consists of a single node with
+ * no inputs, or NULL if the effect is anything more complicated. */
+static const struct d2d_render_info *d2d_effect_get_generator_render_info(struct d2d_effect *effect)
+{
+    struct d2d_transform_node *node;
+
+    if (!effect->graph || effect->input_count)
+        return NULL;
+
+    if (list_count(&effect->graph->nodes) != 1)
+        return NULL;
+
+    node = LIST_ENTRY(list_head(&effect->graph->nodes), struct d2d_transform_node, entry);
+    if (!node->render_info || !(node->render_info->mask & D2D_RENDER_INFO_PIXEL_SHADER))
+        return NULL;
+
+    return node->render_info;
+}
+
+static void d2d_device_context_draw_effect(struct d2d_device_context *context, ID2D1Effect *effect,
+        const D2D1_RECT_F *dst_rect, float opacity, D2D1_INTERPOLATION_MODE interpolation_mode,
+        const D2D1_RECT_F *src_rect, const D2D1_POINT_2F *offset,
+        const D2D1_MATRIX_4X4_F *perspective_transform)
+{
+    const struct d2d_render_info *render_info;
+    struct d2d_effect *effect_impl;
+    ID2D1Image *input;
+    unsigned int i;
+
+    effect_impl = unsafe_impl_from_ID2D1Effect(effect);
+    if (effect_impl && (render_info = d2d_effect_get_generator_render_info(effect_impl)))
+    {
+        D2D1_RECT_F rect;
+
+        /* A generator has no inputs to derive bounds from, so fall back to
+         * the whole target when the caller does not specify a rectangle. */
+        if (dst_rect)
+        {
+            rect = *dst_rect;
+        }
+        else
+        {
+            rect.left = 0.0f;
+            rect.top = 0.0f;
+            rect.right = context->pixel_size.width;
+            rect.bottom = context->pixel_size.height;
+            if (offset)
+            {
+                rect.left += offset->x;
+                rect.top += offset->y;
+            }
+        }
+
+        if (SUCCEEDED(d2d_device_context_draw_effect_node(context, render_info, &rect)))
+            return;
+
+        /* Fall through to the input-image approximation below. */
+    }
+
+    FIXME("Drawing first input image instead of actual effect. context %p, effect %p, dst_rect %s, opacity %.8e, interpolation_mode %#x, src_rect %s, offset %p, perspective_transform %p.\n",
+            context, effect, debug_d2d_rect_f(dst_rect), opacity, interpolation_mode, debug_d2d_rect_f(src_rect), offset, perspective_transform);
+
+    for (i = 0; i < ID2D1Effect_GetInputCount(effect); ++i)
+    {
+        ID2D1Effect_GetInput(effect, i, &input);
+        if (input == NULL) continue;
+
+        ID2D1DeviceContext6_DrawImage(&context->ID2D1DeviceContext6_iface, input,
+                offset, src_rect, interpolation_mode,
+                D2D1_COMPOSITE_MODE_SOURCE_OVER);
+
+        ID2D1Image_Release(input);
+        return;
+    }
+
+    FIXME("No input to draw\n");
+
+}
