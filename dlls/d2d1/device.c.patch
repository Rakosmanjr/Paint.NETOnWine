+static HRESULT STDMETHODCALLTYPE d2d_device_context_GetImageLocalBounds(ID2D1DeviceContext6 *iface,
+        ID2D1Image *image, D2D1_RECT_F *local_bounds);
+
+/* Bounds of a graph node in the effect's coordinate space, from the
+ * transforms' own rect mapping -- the same mapping the renderer uses, so the
+ * reported bounds and what is actually drawn agree. */
+static HRESULT d2d_effect_node_bounds(struct d2d_device_context *context, struct d2d_effect *effect,
+        struct d2d_transform_node *node, unsigned int depth, D2D1_RECT_L *out_rect)
+{
+    D2D1_RECT_L input_rects[D2D_EFFECT_MAX_INPUTS], opaque[D2D_EFFECT_MAX_INPUTS], opaque_out;
+    struct d2d_transform_graph *graph = effect->graph;
+    ID2D1Transform *transform = NULL;
+    unsigned int i, j;
+    HRESULT hr;
+
+    if (depth > D2D_EFFECT_MAX_GRAPH_DEPTH)
+        return E_FAIL;
+    if (node->input_count > D2D_EFFECT_MAX_INPUTS)
+        return E_NOTIMPL;
+
+    for (i = 0; i < node->input_count; ++i)
+    {
+        if (node->inputs[i])
+        {
+            if (FAILED(hr = d2d_effect_node_bounds(context, effect, node->inputs[i],
+                    depth + 1, &input_rects[i])))
+                return hr;
+        }
+        else
+        {
+            D2D1_RECT_F f;
+
+            for (j = 0; j < graph->input_count; ++j)
+            {
+                if (graph->inputs[j].node == node && graph->inputs[j].index == i)
+                    break;
+            }
+            if (j == graph->input_count || j >= effect->input_count || !effect->inputs[j])
+                return E_FAIL;
+
+            if (FAILED(hr = d2d_device_context_GetImageLocalBounds(
+                    &context->ID2D1DeviceContext6_iface, effect->inputs[j], &f)))
+                return hr;
+
+            input_rects[i].left = floorf(f.left);
+            input_rects[i].top = floorf(f.top);
+            input_rects[i].right = ceilf(f.right);
+            input_rects[i].bottom = ceilf(f.bottom);
+        }
+        opaque[i] = input_rects[i];
+    }
+
+    ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1Transform, (void **)&transform);
+    if (transform)
+    {
+        hr = ID2D1Transform_MapInputRectsToOutputRect(transform, input_rects, opaque,
+                node->input_count, out_rect, &opaque_out);
+        ID2D1Transform_Release(transform);
+        return hr;
+    }
+
+    /* A node with no transform interface passes its input through. */
+    if (node->input_count != 1)
+        return E_NOTIMPL;
+    *out_rect = input_rects[0];
+
+    return S_OK;
+}
