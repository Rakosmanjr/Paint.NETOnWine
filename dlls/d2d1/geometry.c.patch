+/* The bounds of a rect with rounded corners under a transform. The shape is
+ * the rect shrunk by the radii, swept by an ellipse of those radii, so its
+ * bounds are those of the shrunk rect widened by the extent of the
+ * transformed ellipse. A plain ellipse is the case of an empty inner rect. */
+static void d2d_rounded_rect_get_bounds(const D2D1_RECT_F *rect, float rx, float ry,
+        const D2D1_MATRIX_3X2_F *transform, D2D1_RECT_F *bounds)
+{
+    D2D1_RECT_F inner;
+    float ex, ey;
+
+    d2d_rect_set(&inner, min(rect->left, rect->right), min(rect->top, rect->bottom),
+            max(rect->left, rect->right), max(rect->top, rect->bottom));
+    rx = min(fabsf(rx), 0.5f * (inner.right - inner.left));
+    ry = min(fabsf(ry), 0.5f * (inner.bottom - inner.top));
+    inner.left += rx;
+    inner.right -= rx;
+    inner.top += ry;
+    inner.bottom -= ry;
+
+    if (transform)
+    {
+        d2d_rect_transform_bounds(bounds, transform, &inner);
+        ex = sqrtf(rx * rx * transform->_11 * transform->_11 + ry * ry * transform->_21 * transform->_21);
+        ey = sqrtf(rx * rx * transform->_12 * transform->_12 + ry * ry * transform->_22 * transform->_22);
+    }
+    else
+    {
+        *bounds = inner;
+        ex = rx;
+        ey = ry;
+    }
+
+    bounds->left -= ex;
+    bounds->right += ex;
+    bounds->top -= ey;
+    bounds->bottom += ey;
+}
+
 static HRESULT STDMETHODCALLTYPE d2d_ellipse_geometry_GetBounds(ID2D1EllipseGeometry *iface,
         const D2D1_MATRIX_3X2_F *transform, D2D1_RECT_F *bounds)
 {
-    FIXME("iface %p, transform %p, bounds %p stub!\n", iface, transform, bounds);
+    struct d2d_geometry *geometry = impl_from_ID2D1EllipseGeometry(iface);
+    const D2D1_ELLIPSE *ellipse = &geometry->u.ellipse.ellipse;
+    D2D1_RECT_F rect;
 
-    return E_NOTIMPL;
+    TRACE("iface %p, transform %p, bounds %p.\n", iface, transform, bounds);
+
+    d2d_rect_set(&rect, ellipse->point.x - ellipse->radiusX, ellipse->point.y - ellipse->radiusY,
+            ellipse->point.x + ellipse->radiusX, ellipse->point.y + ellipse->radiusY);
+    d2d_rounded_rect_get_bounds(&rect, ellipse->radiusX, ellipse->radiusY, transform, bounds);
+
+    return S_OK;
 }
 
