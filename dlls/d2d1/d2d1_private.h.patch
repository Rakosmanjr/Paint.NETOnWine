+/* The D3D11 immediate context is not safe to use from several threads at
+ * once, and a sequence of calls on it -- binding a target, then drawing --
+ * has to be kept together. D3D's own device lock is shared by everything
+ * that renders through the device, including other D2D factories and the
+ * application; the factory's lock covers only the factory's own objects. */
+static inline void d2d_lock(CRITICAL_SECTION *cs, ID3D11Multithread *multithread)
+{
+    if (cs)
+        EnterCriticalSection(cs);
+    if (multithread)
+        ID3D11Multithread_Enter(multithread);
+}
+
+static inline void d2d_unlock(CRITICAL_SECTION *cs, ID3D11Multithread *multithread)
+{
+    if (multithread)
+        ID3D11Multithread_Leave(multithread);
+    if (cs)
+        LeaveCriticalSection(cs);
+}
+
+static inline void d2d_rect_set(D2D1_RECT_F *dst, float left, float top, float right, float bottom)
+{
+    dst->left = left;
+    dst->top = top;
+    dst->right = right;
+    dst->bottom = bottom;
+}
+
+static inline void d2d_rect_intersect(D2D1_RECT_F *dst, const D2D1_RECT_F *src)
+{
+    if (src->left > dst->left)
+        dst->left = src->left;
+    if (src->top > dst->top)
+        dst->top = src->top;
+    if (src->right < dst->right)
+        dst->right = src->right;
+    if (src->bottom < dst->bottom)
+        dst->bottom = src->bottom;
+}
+
+static inline void d2d_rect_union(D2D1_RECT_F *dst, const D2D1_RECT_F *src)
+{
+    if (src->left < dst->left)
+        dst->left = src->left;
+    if (src->top < dst->top)
+        dst->top = src->top;
+    if (src->right > dst->right)
+        dst->right = src->right;
+    if (src->bottom > dst->bottom)
+        dst->bottom = src->bottom;
+}
+
+/* A rect with no area; also the representation of "nothing". */
+static inline bool d2d_rect_is_empty(const D2D1_RECT_F *rect)
+{
+    return !(rect->left < rect->right) || !(rect->top < rect->bottom);
+}
+
+/* The bounding rect of a rect taken through a transform. */
+static inline void d2d_rect_transform_bounds(D2D1_RECT_F *dst, const D2D1_MATRIX_3X2_F *matrix,
+        const D2D1_RECT_F *src)
+{
+    D2D1_RECT_F r = *src;
+    D2D1_POINT_2F p;
+
+    d2d_point_transform(&p, matrix, r.left, r.top);
+    d2d_rect_set(dst, p.x, p.y, p.x, p.y);
+    d2d_point_transform(&p, matrix, r.right, r.top);
+    d2d_rect_expand(dst, &p);
+    d2d_point_transform(&p, matrix, r.right, r.bottom);
+    d2d_rect_expand(dst, &p);
+    d2d_point_transform(&p, matrix, r.left, r.bottom);
+    d2d_rect_expand(dst, &p);
+}
+
+/* An upper bound on how much a transform scales any length. */
+static inline float d2d_matrix_scale_bound(const D2D1_MATRIX_3X2_F *m)
+{
+    return sqrtf(m->_11 * m->_11 + m->_12 * m->_12 + m->_21 * m->_21 + m->_22 * m->_22);
+}
