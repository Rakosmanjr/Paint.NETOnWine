+/* How the pixel shader derives the coverage of a pixel. */
+enum d2d_coverage_mode
+{
+    /* Every pixel the rasterizer produces is fully covered. */
+    D2D_COVERAGE_MODE_NONE = 0,
+    /* A mask texture holds the coverage; coverage_rect is its position and
+     * size in the target. */
+    D2D_COVERAGE_MODE_MASK = 1,
+    /* The shape is the axis-aligned rectangle coverage_rect, in target
+     * pixels, and the coverage is computed from its edges. */
+    D2D_COVERAGE_MODE_RECT = 2,
+};
+
