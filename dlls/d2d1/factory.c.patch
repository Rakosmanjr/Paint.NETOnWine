+/* Moves to the next child element of the element the reader is on, whose
+ * earlier children must have been read to their end. Returns S_FALSE at the
+ * end of the parent. */
+static HRESULT parse_effect_next_child(IXmlReader *reader, const WCHAR **name)
+{
+    XmlNodeType node_type;
+    HRESULT hr;
+
+    while ((hr = IXmlReader_Read(reader, &node_type)) == S_OK)
+    {
+        if (node_type == XmlNodeType_EndElement)
+            return S_FALSE;
+        if (node_type == XmlNodeType_Element)
+            return IXmlReader_GetLocalName(reader, name, NULL);
+    }
+
+    return FAILED(hr) ? hr : HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+}
+
+/* Reads to the end of the element the reader is on. */
+static HRESULT parse_effect_skip_children(IXmlReader *reader)
+{
+    const WCHAR *name;
+    HRESULT hr;
+
+    IXmlReader_MoveToElement(reader);
+    if (IXmlReader_IsEmptyElement(reader))
+        return S_OK;
+
+    while ((hr = parse_effect_next_child(reader, &name)) == S_OK)
+    {
+        if (FAILED(hr = parse_effect_skip_children(reader)))
+            return hr;
+    }
+
+    return hr == S_FALSE ? S_OK : hr;
+}
+
+static struct d2d_effect_properties *parse_effect_create_subproperties(struct d2d_effect_property *property)
+{
+    if (!property->subproperties)
+    {
+        if (!(property->subproperties = calloc(1, sizeof(*property->subproperties))))
+            return NULL;
+        d2d_effect_init_properties(NULL, property->subproperties);
+    }
+
+    return property->subproperties;
+}
+
+static struct d2d_effect_property *parse_effect_get_subproperty(const struct d2d_effect_property *property,
+        UINT32 index)
+{
+    unsigned int i;
+
+    if (!property->subproperties)
+        return NULL;
+
+    for (i = 0; i < property->subproperties->count; ++i)
+    {
+        if (property->subproperties->properties[i].index == index)
+            return &property->subproperties->properties[i];
+    }
+
+    return NULL;
+}
+
+/* "Fields" holds one string per enum value, named for the value and set to
+ * its display name, with the value itself in an "Index" subproperty. */
+static HRESULT parse_effect_fields(IXmlReader *reader, struct d2d_effect_property *property)
+{
+    WCHAR *name, *display_name, *index, buffer[16];
+    struct d2d_effect_property *fields, *field;
+    struct d2d_effect_properties *subproperties;
+    unsigned int count = 0;
+    const WCHAR *node_name;
+    HRESULT hr;
+
+    if (property->type != D2D1_PROPERTY_TYPE_ENUM || parse_effect_get_subproperty(property, D2D1_SUBPROPERTY_FIELDS))
+        return E_INVALIDARG;
+
+    if (!(subproperties = parse_effect_create_subproperties(property)))
+        return E_OUTOFMEMORY;
+    if (FAILED(hr = d2d_effect_subproperties_add(subproperties, L"Fields", D2D1_SUBPROPERTY_FIELDS,
+            D2D1_PROPERTY_TYPE_ARRAY, NULL)))
+        return hr;
+    fields = parse_effect_get_subproperty(property, D2D1_SUBPROPERTY_FIELDS);
+    if (!(subproperties = parse_effect_create_subproperties(fields)))
+        return E_OUTOFMEMORY;
+
+    if (IXmlReader_IsEmptyElement(reader))
+        return S_OK;
+
+    while ((hr = parse_effect_next_child(reader, &node_name)) == S_OK)
+    {
+        if (wcscmp(node_name, L"Field"))
+            return E_INVALIDARG;
+
+        if (FAILED(hr = parse_effect_get_attribute(reader, L"displayname", &display_name)))
+            return hr;
+        if (FAILED(hr = parse_effect_get_attribute(reader, L"index", &index)))
+        {
+            free(display_name);
+            return hr;
+        }
+        if (FAILED(parse_effect_get_attribute(reader, L"name", &name)))
+        {
+            swprintf(buffer, ARRAY_SIZE(buffer), L"%u", count);
+            if (!(name = wcsdup(buffer)))
+            {
+                free(display_name);
+                free(index);
+                return E_OUTOFMEMORY;
+            }
+        }
+
+        hr = d2d_effect_subproperties_add(subproperties, name, count, D2D1_PROPERTY_TYPE_STRING, display_name);
+        if (SUCCEEDED(hr))
+        {
+            field = &subproperties->properties[subproperties->count - 1];
+            if (!parse_effect_create_subproperties(field))
+                hr = E_OUTOFMEMORY;
+            else
+                hr = d2d_effect_subproperties_add(field->subproperties, L"Index", 0,
+                        D2D1_PROPERTY_TYPE_UINT32, index);
+        }
+        free(name);
+        free(display_name);
+        free(index);
+        if (FAILED(hr) || FAILED(hr = parse_effect_skip_children(reader)))
+            return hr;
+        ++count;
+    }
+    if (FAILED(hr))
+        return hr;
+
+    fields = parse_effect_get_subproperty(property, D2D1_SUBPROPERTY_FIELDS);
+    *(UINT32 *)(property->subproperties->data.ptr + fields->data.offset) = count;
+
+    return S_OK;
+}
+
+static HRESULT parse_effect_subproperty(IXmlReader *reader, struct d2d_effect_property *property)
+{
+    static const struct
+    {
+        const WCHAR *name;
+        UINT32 index;
+    }
+    subproperties[] =
+    {
+        {L"DisplayName", D2D1_SUBPROPERTY_DISPLAYNAME},
+        {L"Min",         D2D1_SUBPROPERTY_MIN},
+        {L"Max",         D2D1_SUBPROPERTY_MAX},
+        {L"Default",     D2D1_SUBPROPERTY_DEFAULT},
+    };
+    WCHAR *name, *value = NULL;
+    D2D1_PROPERTY_TYPE type;
+    unsigned int i;
+    HRESULT hr;
+
+    if (FAILED(hr = parse_effect_get_attribute(reader, L"name", &name)))
+        return hr;
+    for (i = 0; i < ARRAY_SIZE(subproperties); ++i)
+    {
+        if (!wcscmp(name, subproperties[i].name))
+            break;
+    }
+    free(name);
+    if (i == ARRAY_SIZE(subproperties))
+        return E_INVALIDARG;
+
+    if (FAILED(hr = parse_effect_get_property_type(reader, &type)))
+        return hr;
+    if (type != (subproperties[i].index == D2D1_SUBPROPERTY_DISPLAYNAME ? D2D1_PROPERTY_TYPE_STRING : property->type)
+            || parse_effect_get_subproperty(property, subproperties[i].index))
+        return E_INVALIDARG;
+
+    if (!parse_effect_create_subproperties(property))
+        return E_OUTOFMEMORY;
+    parse_effect_get_attribute(reader, L"value", &value);
+    hr = d2d_effect_subproperties_add(property->subproperties, subproperties[i].name,
+            subproperties[i].index, type, value);
+    free(value);
+    if (FAILED(hr))
+        return hr;
+
+    return parse_effect_skip_children(reader);
+}
