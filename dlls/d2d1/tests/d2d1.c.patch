+static void test_layer_opacity(BOOL d3d11)
+{
+    D2D1_LAYER_PARAMETERS layer_desc;
+    ID2D1SolidColorBrush *brush, *mask;
+    struct d2d1_test_context ctx;
+    struct resource_readback rb;
+    ID2D1RenderTarget *rt;
+    D2D1_COLOR_F colour_f;
+    ID2D1Layer *layer;
+    D2D1_RECT_F rect;
+    DWORD colour;
+    HRESULT hr;
+
+    if (!init_test_context(&ctx, d3d11))
+        return;
+    rt = ctx.rt;
+
+    hr = ID2D1RenderTarget_CreateLayer(rt, NULL, &layer);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    set_color(&colour_f, 1.0f, 0.0f, 0.0f, 1.0f);
+    hr = ID2D1RenderTarget_CreateSolidColorBrush(rt, &colour_f, NULL, &brush);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    /* Only the alpha channel of the opacity brush matters. */
+    set_color(&colour_f, 0.0f, 1.0f, 0.0f, 0.5f);
+    hr = ID2D1RenderTarget_CreateSolidColorBrush(rt, &colour_f, NULL, &mask);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    ID2D1RenderTarget_BeginDraw(rt);
+    set_color(&colour_f, 1.0f, 1.0f, 1.0f, 1.0f);
+    ID2D1RenderTarget_Clear(rt, &colour_f);
+
+    /* "An opacity value that is applied uniformly to all resources in the
+     * layer when compositing to the target." */
+    set_rect(&layer_desc.contentBounds, -FLT_MAX, -FLT_MAX, FLT_MAX, FLT_MAX);
+    layer_desc.geometricMask = NULL;
+    layer_desc.maskAntialiasMode = D2D1_ANTIALIAS_MODE_ALIASED;
+    set_matrix_identity(&layer_desc.maskTransform);
+    layer_desc.opacity = 0.5f;
+    layer_desc.opacityBrush = NULL;
+    layer_desc.layerOptions = D2D1_LAYER_OPTIONS_NONE;
+    ID2D1RenderTarget_PushLayer(rt, &layer_desc, layer);
+    set_rect(&rect, 100.0f, 100.0f, 200.0f, 200.0f);
+    ID2D1RenderTarget_FillRectangle(rt, &rect, (ID2D1Brush *)brush);
+    ID2D1RenderTarget_PopLayer(rt);
+
+    /* "The brush is mapped to the layer, and the alpha channel of each mapped
+     * brush pixel is multiplied against the corresponding layer pixel." */
+    layer_desc.opacity = 1.0f;
+    layer_desc.opacityBrush = (ID2D1Brush *)mask;
+    ID2D1RenderTarget_PushLayer(rt, &layer_desc, layer);
+    set_rect(&rect, 300.0f, 100.0f, 400.0f, 200.0f);
+    ID2D1RenderTarget_FillRectangle(rt, &rect, (ID2D1Brush *)brush);
+    ID2D1RenderTarget_PopLayer(rt);
+
+    hr = ID2D1RenderTarget_EndDraw(rt, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    get_surface_readback(&ctx, &rb);
+    /* Opaque red at half opacity over white. */
+    colour = get_readback_colour(&rb, 150, 150);
+    todo_wine ok(compare_colour(colour, 0xffff7f7f, 2), "Got unexpected colour 0x%08lx for layer opacity.\n", colour);
+    colour = get_readback_colour(&rb, 350, 150);
+    todo_wine ok(compare_colour(colour, 0xffff7f7f, 2), "Got unexpected colour 0x%08lx for opacity brush.\n", colour);
+    colour = get_readback_colour(&rb, 50, 50);
+    ok(compare_colour(colour, 0xffffffff, 1), "Got unexpected colour 0x%08lx outside the layer.\n", colour);
+    release_resource_readback(&rb);
+
+    ID2D1SolidColorBrush_Release(mask);
+    ID2D1SolidColorBrush_Release(brush);
+    ID2D1Layer_Release(layer);
+    release_test_context(&ctx);
+}
