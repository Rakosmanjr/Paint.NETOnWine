+/* Enough commands that the list has to grow its storage several times while
+ * recording. The rects and offsets each command carries must survive that. */
+static void test_command_list_many_commands(BOOL d3d11)
+{
+    static const DWORD red[16] =
+    {
+        0xffff0000, 0xffff0000, 0xffff0000, 0xffff0000,
+        0xffff0000, 0xffff0000, 0xffff0000, 0xffff0000,
+        0xffff0000, 0xffff0000, 0xffff0000, 0xffff0000,
+        0xffff0000, 0xffff0000, 0xffff0000, 0xffff0000,
+    };
+    struct rect_sink sink = {{&rect_sink_vtbl}};
+    D2D1_BITMAP_PROPERTIES1 bitmap_desc;
+    ID2D1CommandList *command_list;
+    struct d2d1_test_context ctx;
+    ID2D1DeviceContext *context;
+    D2D1_POINT_2F offset;
+    ID2D1Bitmap1 *bitmap;
+    ID2D1Image *target;
+    D2D1_SIZE_U size;
+    D2D1_RECT_F rect;
+    unsigned int i;
+    HRESULT hr;
+
+    if (!init_test_context(&ctx, d3d11))
+        return;
+
+    context = ctx.context;
+    if (!ctx.factory1)
+    {
+        win_skip("Command lists are not supported.\n");
+        release_test_context(&ctx);
+        return;
+    }
+
+    set_size_u(&size, 4, 4);
+    bitmap_desc.pixelFormat.format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    bitmap_desc.pixelFormat.alphaMode = D2D1_ALPHA_MODE_PREMULTIPLIED;
+    bitmap_desc.dpiX = 96.0f;
+    bitmap_desc.dpiY = 96.0f;
+    bitmap_desc.bitmapOptions = D2D1_BITMAP_OPTIONS_NONE;
+    bitmap_desc.colorContext = NULL;
+    hr = ID2D1DeviceContext_CreateBitmap(context, size, red, sizeof(*red) * 4, &bitmap_desc, &bitmap);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    hr = ID2D1DeviceContext_CreateCommandList(context, &command_list);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    ID2D1DeviceContext_GetTarget(context, &target);
+    ID2D1DeviceContext_SetTarget(context, (ID2D1Image *)command_list);
+    ID2D1DeviceContext_BeginDraw(context);
+
+    for (i = 0; i < 64; ++i)
+    {
+        many_commands_rect(i, &rect);
+        ID2D1DeviceContext_DrawBitmap(context, (ID2D1Bitmap *)bitmap, &rect, 1.0f,
+                D2D1_INTERPOLATION_MODE_NEAREST_NEIGHBOR, NULL, NULL);
+    }
+    for (i = 0; i < 64; ++i)
+    {
+        many_commands_rect(i, &rect);
+        set_point(&offset, rect.left, rect.top);
+        set_rect(&rect, 0.0f, 0.0f, 4.0f, 4.0f);
+        ID2D1DeviceContext_DrawImage(context, (ID2D1Image *)bitmap, &offset, &rect,
+                D2D1_INTERPOLATION_MODE_NEAREST_NEIGHBOR, D2D1_COMPOSITE_MODE_SOURCE_OVER);
+    }
+
+    hr = ID2D1DeviceContext_EndDraw(context, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1DeviceContext_SetTarget(context, target);
+    if (target)
+        ID2D1Image_Release(target);
+    hr = ID2D1CommandList_Close(command_list);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    hr = ID2D1CommandList_Stream(command_list, &sink.ID2D1CommandSink_iface);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(sink.bitmap_count == 64, "Got unexpected bitmap count %u.\n", sink.bitmap_count);
+    ok(sink.image_count == 64, "Got unexpected image count %u.\n", sink.image_count);
+    ok(!sink.mismatches, "%u rects or offsets differ from the ones recorded.\n", sink.mismatches);
+
+    ID2D1CommandList_Release(command_list);
+    ID2D1Bitmap1_Release(bitmap);
+    release_test_context(&ctx);
+}
