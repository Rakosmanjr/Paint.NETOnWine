+static void test_layer_nesting(BOOL d3d11)
+{
+    D2D1_LAYER_PARAMETERS layer_desc;
+    struct d2d1_test_context ctx;
+    ID2D1SolidColorBrush *brush;
+    struct resource_readback rb;
+    ID2D1Layer *layer1, *layer2;
+    ID2D1RenderTarget *rt;
+    D2D1_COLOR_F colour_f;
+    D2D1_RECT_F rect;
+    DWORD colour;
+    HRESULT hr;
+
+    if (!init_test_context(&ctx, d3d11))
+        return;
+    rt = ctx.rt;
+
+    hr = ID2D1RenderTarget_CreateLayer(rt, NULL, &layer1);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1RenderTarget_CreateLayer(rt, NULL, &layer2);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    set_color(&colour_f, 1.0f, 0.0f, 0.0f, 1.0f);
+    hr = ID2D1RenderTarget_CreateSolidColorBrush(rt, &colour_f, NULL, &brush);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    ID2D1RenderTarget_BeginDraw(rt);
+    set_color(&colour_f, 1.0f, 1.0f, 1.0f, 1.0f);
+    ID2D1RenderTarget_Clear(rt, &colour_f);
+
+    layer_desc.geometricMask = NULL;
+    layer_desc.maskAntialiasMode = D2D1_ANTIALIAS_MODE_ALIASED;
+    set_matrix_identity(&layer_desc.maskTransform);
+    layer_desc.opacity = 1.0f;
+    layer_desc.opacityBrush = NULL;
+    layer_desc.layerOptions = D2D1_LAYER_OPTIONS_NONE;
+
+    set_rect(&layer_desc.contentBounds, 100.0f, 100.0f, 300.0f, 300.0f);
+    ID2D1RenderTarget_PushLayer(rt, &layer_desc, layer1);
+    set_rect(&layer_desc.contentBounds, 200.0f, 200.0f, 400.0f, 400.0f);
+    ID2D1RenderTarget_PushLayer(rt, &layer_desc, layer2);
+
+    set_rect(&rect, 0.0f, 0.0f, 640.0f, 480.0f);
+    ID2D1RenderTarget_FillRectangle(rt, &rect, (ID2D1Brush *)brush);
+
+    ID2D1RenderTarget_PopLayer(rt);
+    ID2D1RenderTarget_PopLayer(rt);
+    hr = ID2D1RenderTarget_EndDraw(rt, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    /* Nested layers clip to the intersection of their bounds. */
+    get_surface_readback(&ctx, &rb);
+    colour = get_readback_colour(&rb, 250, 250);
+    ok(compare_colour(colour, 0xffff0000, 1), "Got unexpected colour 0x%08lx inside both.\n", colour);
+    colour = get_readback_colour(&rb, 150, 150);
+    todo_wine ok(compare_colour(colour, 0xffffffff, 1), "Got unexpected colour 0x%08lx inside outer only.\n", colour);
+    colour = get_readback_colour(&rb, 350, 350);
+    todo_wine ok(compare_colour(colour, 0xffffffff, 1), "Got unexpected colour 0x%08lx inside inner only.\n", colour);
+    release_resource_readback(&rb);
+
+    ID2D1SolidColorBrush_Release(brush);
+    ID2D1Layer_Release(layer2);
+    ID2D1Layer_Release(layer1);
+    release_test_context(&ctx);
+}
