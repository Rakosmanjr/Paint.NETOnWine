+    bitmap_desc.colorContext = NULL;
+    for (i = 0; i < ARRAY_SIZE(bitmap); ++i)
+    {
+        hr = ID2D1DeviceContext_CreateBitmap(context, size, &input_colour[i],
+                sizeof(*input_colour), &bitmap_desc, &bitmap[i]);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    }
+
+    hr = ID2D1DeviceContext_CreateEffect(context, &CLSID_TestEffect, &effect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    for (i = 0; i < ARRAY_SIZE(bitmap); ++i)
+        ID2D1Effect_SetInput(effect, i, (ID2D1Image *)bitmap[i], FALSE);
+    ID2D1Effect_GetOutput(effect, &output);
+
+    ID2D1DeviceContext_BeginDraw(context);
+    ID2D1DeviceContext_Clear(context, NULL);
+    ID2D1DeviceContext_DrawImage(context, output, NULL, NULL, 0, 0);
+    hr = ID2D1DeviceContext_EndDraw(context, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    /* The graph the effect left behind in PrepareForRender() is the one that
+     * is rendered, not the one it built when it was created. */
+    get_surface_readback(&ctx, &rb);
+    colour = get_readback_colour(&rb, 0, 0);
+    ok(compare_colour(colour, input_colour[1], 1),
+            "Got unexpected colour 0x%08lx, the graph set at creation was used.\n", colour);
+    release_resource_readback(&rb);
+
+    ID2D1Image_Release(output);
+    ID2D1Effect_Release(effect);
+    for (i = 0; i < ARRAY_SIZE(bitmap); ++i)
+        ID2D1Bitmap1_Release(bitmap[i]);
+    hr = ID2D1Factory1_UnregisterEffect(factory, &CLSID_TestEffect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    release_test_context(&ctx);
+}
+
+/* Records each PrepareForRender() call: "Count" is the number of calls and
+ * "History" their change types, two bits each, oldest first. */
+static HRESULT STDMETHODCALLTYPE counting_effect_impl_PrepareForRender(ID2D1EffectImpl *iface,
+        D2D1_CHANGE_TYPE type)
+{
+    struct effect_impl *effect_impl = impl_from_ID2D1EffectImpl(iface);
+
+    ++effect_impl->prepare_count;
+    effect_impl->prepare_history = effect_impl->prepare_history << 2 | type;
+    return S_OK;
+}
+
+static const ID2D1EffectImplVtbl counting_effect_impl_vtbl =
+{
+    effect_impl_QueryInterface,
+    effect_impl_AddRef,
+    effect_impl_Release,
+    regraph_effect_impl_Initialize,
+    counting_effect_impl_PrepareForRender,
+    effect_impl_SetGraph,
+};
+
+static HRESULT STDMETHODCALLTYPE counting_effect_impl_create(IUnknown **effect_impl)
+{
+    struct effect_impl *object;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+
+    object->ID2D1EffectImpl_iface.lpVtbl = &counting_effect_impl_vtbl;
+    object->refcount = 1;
+
+    *effect_impl = (IUnknown *)&object->ID2D1EffectImpl_iface;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE counting_effect_impl_get_count(const IUnknown *iface,
+        BYTE *data, UINT32 data_size, UINT32 *actual_size)
+{
+    struct effect_impl *effect_impl = impl_from_ID2D1EffectImpl((ID2D1EffectImpl *)iface);
+
+    if (actual_size)
+        *actual_size = sizeof(UINT32);
+    if (data)
+        *(UINT32 *)data = effect_impl->prepare_count;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE counting_effect_impl_get_history(const IUnknown *iface,
+        BYTE *data, UINT32 data_size, UINT32 *actual_size)
+{
+    struct effect_impl *effect_impl = impl_from_ID2D1EffectImpl((ID2D1EffectImpl *)iface);
+
+    if (actual_size)
+        *actual_size = sizeof(UINT32);
+    if (data)
+        *(UINT32 *)data = effect_impl->prepare_history;
+    return S_OK;
+}
+
+/* Unlike effect_impl_get_integer(), this answers a query for the size. D2D
+ * can only tell that a value is unchanged when the getter does. */
+static HRESULT STDMETHODCALLTYPE counting_effect_impl_get_integer(const IUnknown *iface,
+        BYTE *data, UINT32 data_size, UINT32 *actual_size)
+{
+    struct effect_impl *effect_impl = impl_from_ID2D1EffectImpl((ID2D1EffectImpl *)iface);
+
+    if (actual_size)
+        *actual_size = sizeof(effect_impl->integer);
+    if (data)
+        *(UINT32 *)data = effect_impl->integer;
+    return S_OK;
+}
+
+static void check_prepare_calls_(unsigned int line, ID2D1Effect *effect, UINT32 count, UINT32 history)
+{
+    UINT32 value;
+    HRESULT hr;
+
+    hr = ID2D1Effect_GetValueByName(effect, L"Count", D2D1_PROPERTY_TYPE_UINT32, (BYTE *)&value, sizeof(value));
+    ok_(__FILE__, line)(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok_(__FILE__, line)(value == count, "Got %u calls, expected %u.\n", value, count);
+    hr = ID2D1Effect_GetValueByName(effect, L"History", D2D1_PROPERTY_TYPE_UINT32, (BYTE *)&value, sizeof(value));
+    ok_(__FILE__, line)(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok_(__FILE__, line)(value == history, "Got history %#x, expected %#x.\n", value, history);
+}
+#define check_prepare_calls(a, b, c) check_prepare_calls_(__LINE__, a, b, c)
+
+static void draw_effect_output(ID2D1DeviceContext *context, ID2D1Effect *effect)
+{
+    ID2D1Image *output;
+    HRESULT hr;
+
+    ID2D1Effect_GetOutput(effect, &output);
+    ID2D1DeviceContext_BeginDraw(context);
+    ID2D1DeviceContext_DrawImage(context, output, NULL, NULL, 0, 0);
+    hr = ID2D1DeviceContext_EndDraw(context, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1Image_Release(output);
+}
+
+/* When D2D calls PrepareForRender(), and with which change type. */
+static void test_effect_prepare_for_render_calls(BOOL d3d11)
+{
+    static const WCHAR *description =
+        L"<?xml version='1.0'?>                                                       \
+            <Effect>                                                                  \
+                <Property name='DisplayName' type='string' value='Counting'/>         \
+                <Property name='Author'      type='string' value='The Wine Project'/> \
+                <Property name='Category'    type='string' value='Test'/>             \
+                <Property name='Description' type='string' value='Test effect.'/>     \
+                <Inputs>                                                              \
+                    <Input name='Source'/>                                            \
+                    <Input name='Source2'/>                                           \
+                </Inputs>                                                             \
+                <Property name='Integer' type='uint32'>                               \
+                    <Property name='DisplayName' type='string' value='Integer'/>      \
+                </Property>                                                           \
+                <Property name='Count' type='uint32'>                                 \
+                    <Property name='DisplayName' type='string' value='Count'/>        \
+                </Property>                                                           \
+                <Property name='History' type='uint32'>                               \
+                    <Property name='DisplayName' type='string' value='History'/>      \
+                </Property>                                                           \
+            </Effect>                                                                 \
+        ";
+    static const DWORD input_colour[2] = {0xffff0000, 0xff00ff00};
+    const D2D1_PROPERTY_BINDING bindings[] =
+    {
+        {L"Integer", effect_impl_set_integer, counting_effect_impl_get_integer},
+        {L"Count",   NULL, counting_effect_impl_get_count},
+        {L"History", NULL, counting_effect_impl_get_history},
+    };
+
+    D2D1_BITMAP_PROPERTIES1 bitmap_desc;
+    struct d2d1_test_context ctx;
+    ID2D1DeviceContext *context;
+    ID2D1Bitmap1 *bitmap[2];
+    ID2D1Factory1 *factory;
+    ID2D1Effect *effect;
+    ID2D1Image *output;
+    D2D1_RECT_F bounds;
+    D2D1_SIZE_U size;
+    unsigned int i;
+    UINT32 value;
+    HRESULT hr;
+
+    if (!init_test_context(&ctx, d3d11))
+        return;
+
+    context = ctx.context;
+    if (!(factory = ctx.factory1))
+    {
+        win_skip("ID2D1Factory1 is not supported.\n");
+        release_test_context(&ctx);
+        return;
+    }
+
+    hr = ID2D1Factory1_RegisterEffectFromString(factory, &CLSID_TestEffect, description,
+            bindings, ARRAY_SIZE(bindings), counting_effect_impl_create);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    set_size_u(&size, 1, 1);
+    bitmap_desc.pixelFormat.format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    bitmap_desc.pixelFormat.alphaMode = D2D1_ALPHA_MODE_IGNORE;
+    bitmap_desc.dpiX = 96.0f;
+    bitmap_desc.dpiY = 96.0f;
+    bitmap_desc.bitmapOptions = D2D1_BITMAP_OPTIONS_NONE;
+    bitmap_desc.colorContext = NULL;
+    for (i = 0; i < ARRAY_SIZE(bitmap); ++i)
+    {
+        hr = ID2D1DeviceContext_CreateBitmap(context, size, &input_colour[i],
+                sizeof(*input_colour), &bitmap_desc, &bitmap[i]);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    }
+
+    /* Not while the effect is created. */
+    hr = ID2D1DeviceContext_CreateEffect(context, &CLSID_TestEffect, &effect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    check_prepare_calls(effect, 0, 0);
+    for (i = 0; i < ARRAY_SIZE(bitmap); ++i)
+        ID2D1Effect_SetInput(effect, i, (ID2D1Image *)bitmap[i], FALSE);
+    check_prepare_calls(effect, 0, 0);
+
+    /* The first draw passes D2D1_CHANGE_TYPE_GRAPH; later draws make no call
+     * until something changes. */
+    draw_effect_output(context, effect);
+    check_prepare_calls(effect, 1, D2D1_CHANGE_TYPE_GRAPH);
+    draw_effect_output(context, effect);
+    check_prepare_calls(effect, 1, D2D1_CHANGE_TYPE_GRAPH);
+
+    /* Setting a property to the value it already has is not a change. */
+    value = 0;
+    hr = ID2D1Effect_SetValueByName(effect, L"Integer", D2D1_PROPERTY_TYPE_UINT32, (BYTE *)&value, sizeof(value));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    draw_effect_output(context, effect);
+    check_prepare_calls(effect, 1, D2D1_CHANGE_TYPE_GRAPH);
+
+    /* Any number of property changes are reported once, on the next draw. */
+    value = 5;
+    hr = ID2D1Effect_SetValueByName(effect, L"Integer", D2D1_PROPERTY_TYPE_UINT32, (BYTE *)&value, sizeof(value));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    value = 6;
+    hr = ID2D1Effect_SetValueByName(effect, L"Integer", D2D1_PROPERTY_TYPE_UINT32, (BYTE *)&value, sizeof(value));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    check_prepare_calls(effect, 1, D2D1_CHANGE_TYPE_GRAPH);
+    draw_effect_output(context, effect);
+    check_prepare_calls(effect, 2, D2D1_CHANGE_TYPE_GRAPH << 2 | D2D1_CHANGE_TYPE_PROPERTIES);
+    draw_effect_output(context, effect);
+    check_prepare_calls(effect, 2, D2D1_CHANGE_TYPE_GRAPH << 2 | D2D1_CHANGE_TYPE_PROPERTIES);
+
+    /* Changing an input is not reported. */
+    ID2D1Effect_SetInput(effect, 0, (ID2D1Image *)bitmap[1], FALSE);
+    draw_effect_output(context, effect);
+    check_prepare_calls(effect, 2, D2D1_CHANGE_TYPE_GRAPH << 2 | D2D1_CHANGE_TYPE_PROPERTIES);
+
+    /* Measuring the effect delivers a pending change as drawing does. */
+    value = 7;
+    hr = ID2D1Effect_SetValueByName(effect, L"Integer", D2D1_PROPERTY_TYPE_UINT32, (BYTE *)&value, sizeof(value));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1Effect_GetOutput(effect, &output);
+    hr = ID2D1DeviceContext_GetImageLocalBounds(context, output, &bounds);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1Image_Release(output);
+    check_prepare_calls(effect, 3, (D2D1_CHANGE_TYPE_GRAPH << 2 | D2D1_CHANGE_TYPE_PROPERTIES) << 2
+            | D2D1_CHANGE_TYPE_PROPERTIES);
+    draw_effect_output(context, effect);
+    check_prepare_calls(effect, 3, (D2D1_CHANGE_TYPE_GRAPH << 2 | D2D1_CHANGE_TYPE_PROPERTIES) << 2
+            | D2D1_CHANGE_TYPE_PROPERTIES);
+
+    ID2D1Effect_Release(effect);
+    for (i = 0; i < ARRAY_SIZE(bitmap); ++i)
+        ID2D1Bitmap1_Release(bitmap[i]);
+    hr = ID2D1Factory1_UnregisterEffect(factory, &CLSID_TestEffect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    release_test_context(&ctx);
+}
