+/* When D2D calls PrepareForRender(), and with which change type. */
+static void test_effect_prepare_for_render_calls(BOOL d3d11)
+{
+    static const WCHAR *description =
+        L"<?xml version='1.0'?>                                                       \
+            <Effect>                                                                  \
+                <Property name='DisplayName' type='string' value='Counting'/>         \
+                <Property name='Author'      type='string' value='The Wine Project'/> \
+                <Property name='Category'    type='string' value='Test'/>             \
+                <Property name='Description' type='string' value='Test effect.'/>     \
+                <Inputs>                                                              \
+                    <Input name='Source'/>                                            \
+                    <Input name='Source2'/>                                           \
+                </Inputs>                                                             \
+                <Property name='Integer' type='uint32'>                               \
+                    <Property name='DisplayName' type='string' value='Integer'/>      \
+                </Property>                                                           \
+                <Property name='Count' type='uint32'>                                 \
+                    <Property name='DisplayName' type='string' value='Count'/>        \
+                </Property>                                                           \
+                <Property name='History' type='uint32'>                               \
+                    <Property name='DisplayName' type='string' value='History'/>      \
+                </Property>                                                           \
+            </Effect>                                                                 \
+        ";
+    static const DWORD input_colour[2] = {0xffff0000, 0xff00ff00};
+    const D2D1_PROPERTY_BINDING bindings[] =
+    {
+        {L"Integer", effect_impl_set_integer, counting_effect_impl_get_integer},
+        {L"Count",   NULL, counting_effect_impl_get_count},
+        {L"History", NULL, counting_effect_impl_get_history},
+    };
+
+    D2D1_BITMAP_PROPERTIES1 bitmap_desc;
+    struct d2d1_test_context ctx;
+    ID2D1DeviceContext *context;
+    ID2D1Bitmap1 *bitmap[2];
+    ID2D1Factory1 *factory;
+    ID2D1Effect *effect;
+    ID2D1Image *output;
+    D2D1_RECT_F bounds;
+    D2D1_SIZE_U size;
+    unsigned int i;
+    UINT32 value;
+    HRESULT hr;
+
+    if (!init_test_context(&ctx, d3d11))
+        return;
+
+    context = ctx.context;
+    if (!(factory = ctx.factory1))
+    {
+        win_skip("ID2D1Factory1 is not supported.\n");
+        release_test_context(&ctx);
+        return;
+    }
+
+    hr = ID2D1Factory1_RegisterEffectFromString(factory, &CLSID_TestEffect, description,
+            bindings, ARRAY_SIZE(bindings), counting_effect_impl_create);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    set_size_u(&size, 1, 1);
+    bitmap_desc.pixelFormat.format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    bitmap_desc.pixelFormat.alphaMode = D2D1_ALPHA_MODE_IGNORE;
+    bitmap_desc.dpiX = 96.0f;
+    bitmap_desc.dpiY = 96.0f;
+    bitmap_desc.bitmapOptions = D2D1_BITMAP_OPTIONS_NONE;
+    bitmap_desc.colorContext = NULL;
+    for (i = 0; i < ARRAY_SIZE(bitmap); ++i)
+    {
+        hr = ID2D1DeviceContext_CreateBitmap(context, size, &input_colour[i],
+                sizeof(*input_colour), &bitmap_desc, &bitmap[i]);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    }
+
+    /* Not while the effect is created. */
+    hr = ID2D1DeviceContext_CreateEffect(context, &CLSID_TestEffect, &effect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    check_prepare_calls(effect, 0, 0);
+    for (i = 0; i < ARRAY_SIZE(bitmap); ++i)
+        ID2D1Effect_SetInput(effect, i, (ID2D1Image *)bitmap[i], FALSE);
+    check_prepare_calls(effect, 0, 0);
+
+    /* The first draw passes D2D1_CHANGE_TYPE_GRAPH; later draws make no call
+     * until something changes. */
+    draw_effect_output(context, effect);
+    check_prepare_calls(effect, 1, D2D1_CHANGE_TYPE_GRAPH);
+    draw_effect_output(context, effect);
+    check_prepare_calls(effect, 1, D2D1_CHANGE_TYPE_GRAPH);
+
+    /* Setting a property to the value it already has is not a change. */
+    value = 0;
+    hr = ID2D1Effect_SetValueByName(effect, L"Integer", D2D1_PROPERTY_TYPE_UINT32, (BYTE *)&value, sizeof(value));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    draw_effect_output(context, effect);
+    check_prepare_calls(effect, 1, D2D1_CHANGE_TYPE_GRAPH);
+
+    /* Any number of property changes are reported once, on the next draw. */
+    value = 5;
+    hr = ID2D1Effect_SetValueByName(effect, L"Integer", D2D1_PROPERTY_TYPE_UINT32, (BYTE *)&value, sizeof(value));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    value = 6;
+    hr = ID2D1Effect_SetValueByName(effect, L"Integer", D2D1_PROPERTY_TYPE_UINT32, (BYTE *)&value, sizeof(value));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    check_prepare_calls(effect, 1, D2D1_CHANGE_TYPE_GRAPH);
+    draw_effect_output(context, effect);
+    check_prepare_calls(effect, 2, D2D1_CHANGE_TYPE_GRAPH << 2 | D2D1_CHANGE_TYPE_PROPERTIES);
+    draw_effect_output(context, effect);
+    check_prepare_calls(effect, 2, D2D1_CHANGE_TYPE_GRAPH << 2 | D2D1_CHANGE_TYPE_PROPERTIES);
+
+    /* Changing an input is not reported. */
+    ID2D1Effect_SetInput(effect, 0, (ID2D1Image *)bitmap[1], FALSE);
+    draw_effect_output(context, effect);
+    check_prepare_calls(effect, 2, D2D1_CHANGE_TYPE_GRAPH << 2 | D2D1_CHANGE_TYPE_PROPERTIES);
+
+    /* Measuring the effect delivers a pending change as drawing does. */
+    value = 7;
+    hr = ID2D1Effect_SetValueByName(effect, L"Integer", D2D1_PROPERTY_TYPE_UINT32, (BYTE *)&value, sizeof(value));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1Effect_GetOutput(effect, &output);
+    hr = ID2D1DeviceContext_GetImageLocalBounds(context, output, &bounds);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1Image_Release(output);
+    check_prepare_calls(effect, 3, (D2D1_CHANGE_TYPE_GRAPH << 2 | D2D1_CHANGE_TYPE_PROPERTIES) << 2
+            | D2D1_CHANGE_TYPE_PROPERTIES);
+    draw_effect_output(context, effect);
+    check_prepare_calls(effect, 3, (D2D1_CHANGE_TYPE_GRAPH << 2 | D2D1_CHANGE_TYPE_PROPERTIES) << 2
+            | D2D1_CHANGE_TYPE_PROPERTIES);
+
+    ID2D1Effect_Release(effect);
+    for (i = 0; i < ARRAY_SIZE(bitmap); ++i)
+        ID2D1Bitmap1_Release(bitmap[i]);
+    hr = ID2D1Factory1_UnregisterEffect(factory, &CLSID_TestEffect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    release_test_context(&ctx);
+}
