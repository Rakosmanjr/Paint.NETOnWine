+/* Checks the rects and offsets streamed back from a command list against the
+ * ones test_command_list_many_commands() recorded. */
+struct rect_sink
+{
+    ID2D1CommandSink ID2D1CommandSink_iface;
+    unsigned int bitmap_count, image_count, mismatches;
+};
