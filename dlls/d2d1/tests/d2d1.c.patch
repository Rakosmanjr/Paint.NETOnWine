+static void test_effect_vertex_buffer(BOOL d3d11)
+{
+    static const char custom_vs_code[] =
+        "struct vs_out"
+        "{"
+        "    float4 clipSpaceOutput  : SV_POSITION;"
+        "    float4 sceneSpaceOutput : SCENE_POSITION;"
+        "    float4 texelSpaceInput0 : TEXCOORD0;"
