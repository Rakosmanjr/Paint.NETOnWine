+    /* With straight alpha the stored values are converted as they are. */
+    static const struct
+    {
+        enum cm_context source, destination;
+        unsigned int pixel;
+        float expected[4];
+    }
+    straight_tests[] =
+    {
+        {CM_SRGB, CM_SCRGB, 4, {0.050881f, 0.010025f, 0.003935f, 0.5f}},
+        {CM_SCRGB, CM_SRGB, 4, {0.537106f, 0.349173f, 0.247772f, 0.5f}},
+        {CM_SRGB, CM_SCRGB, 3, {1.0f, 0.214046f, 0.0f, 1.0f}},
+    };
+    /* Only the best quality converts to and from BT.2020. scRGB 1.0 is
+     * 80 nits there. */
+    static const struct
+    {
+        enum cm_context source, destination;
+        unsigned int pixel;
+        float expected[4];
+        float tolerance;
+    }
+    bt2020_tests[] =
+    {
+        {CM_SCRGB, CM_PQ_2020, 0, {0.419285f, 0.419285f, 0.419285f, 1.0f}, 0.001f},
+        {CM_PQ_2020, CM_SCRGB, 0, {1.153046f, 1.153047f, 1.153046f, 1.0f}, 0.001f},
+        {CM_SCRGB, CM_PQ_2020, 2, {0.381187f, 0.477598f, 0.272762f, 1.0f}, 0.001f},
+        {CM_SCRGB, CM_G22_2020, 1, {0.576523f, 0.658177f, 0.883393f, 1.0f}, 0.001f},
+        {CM_SRGB, CM_PQ_2020, 2, {0.381862f, 0.477620f, 0.275390f, 1.0f}, 0.005f},
+        {CM_G22_2020, CM_SCRGB, 2, {-0.587540f, 1.132912f, -0.100602f, 1.0f}, 0.001f},
+    };
+    ID2D1ColorContext *contexts[CM_COUNT] = {NULL};
+    ID2D1DeviceContext5 *context5 = NULL;
+    struct d2d1_test_context ctx;
+    ID2D1DeviceContext *context;
+    unsigned int count, i, j;
+    ID2D1Effect *effect;
+    ID2D1ColorContext *cc;
+    WCHAR name[64];
+    ULONG refcount;
+    float out[4];
+    UINT32 v;
+    HRESULT hr;
+
+    if (!init_test_context(&ctx, d3d11))
+        return;
+    context = ctx.context;
+
+    hr = ID2D1DeviceContext_CreateEffect(context, &CLSID_D2D1ColorManagement, &effect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    if (FAILED(hr))
+    {
+        release_test_context(&ctx);
+        return;
+    }
+
+    check_system_properties(effect);
+
+    count = ID2D1Effect_GetPropertyCount(effect);
+    ok(count == 6, "Got unexpected property count %u.\n", count);
+    for (i = 0; i < ARRAY_SIZE(properties); ++i)
+    {
+        hr = ID2D1Effect_GetPropertyName(effect, properties[i].index, name, ARRAY_SIZE(name));
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        ok(!wcscmp(name, properties[i].name), "Unexpected name %s.\n", wine_dbgstr_w(name));
+        v = ID2D1Effect_GetType(effect, properties[i].index);
+        ok(v == properties[i].type, "Got unexpected type %u.\n", v);
+    }
+
+    cc = (void *)0xdeadbeef;
+    hr = ID2D1Effect_GetValue(effect, D2D1_COLORMANAGEMENT_PROP_SOURCE_COLOR_CONTEXT,
+            D2D1_PROPERTY_TYPE_COLOR_CONTEXT, (BYTE *)&cc, sizeof(cc));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(!cc, "Got unexpected context %p.\n", cc);
+    cc = (void *)0xdeadbeef;
+    hr = ID2D1Effect_GetValue(effect, D2D1_COLORMANAGEMENT_PROP_DESTINATION_COLOR_CONTEXT,
+            D2D1_PROPERTY_TYPE_COLOR_CONTEXT, (BYTE *)&cc, sizeof(cc));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(!cc, "Got unexpected context %p.\n", cc);
+    v = effect_get_enum_prop(effect, D2D1_COLORMANAGEMENT_PROP_SOURCE_RENDERING_INTENT);
+    ok(v == D2D1_COLORMANAGEMENT_RENDERING_INTENT_PERCEPTUAL, "Unexpected value %u.\n", v);
+    v = effect_get_enum_prop(effect, D2D1_COLORMANAGEMENT_PROP_DESTINATION_RENDERING_INTENT);
+    ok(v == D2D1_COLORMANAGEMENT_RENDERING_INTENT_PERCEPTUAL, "Unexpected value %u.\n", v);
+    v = effect_get_enum_prop(effect, D2D1_COLORMANAGEMENT_PROP_ALPHA_MODE);
+    ok(v == D2D1_COLORMANAGEMENT_ALPHA_MODE_PREMULTIPLIED, "Unexpected value %u.\n", v);
+    v = effect_get_enum_prop(effect, D2D1_COLORMANAGEMENT_PROP_QUALITY);
+    ok(v == D2D1_COLORMANAGEMENT_QUALITY_NORMAL, "Unexpected value %u.\n", v);
+
+    for (v = 0; v < 4; ++v)
+    {
+        hr = ID2D1Effect_SetValue(effect, D2D1_COLORMANAGEMENT_PROP_ALPHA_MODE,
+                D2D1_PROPERTY_TYPE_ENUM, (BYTE *)&v, sizeof(v));
+        ok(hr == (v == 1 || v == 2 ? S_OK : E_INVALIDARG), "Alpha mode %u: got unexpected hr %#lx.\n", v, hr);
+        hr = ID2D1Effect_SetValue(effect, D2D1_COLORMANAGEMENT_PROP_QUALITY,
+                D2D1_PROPERTY_TYPE_ENUM, (BYTE *)&v, sizeof(v));
+        ok(hr == (v <= 2 ? S_OK : E_INVALIDARG), "Quality %u: got unexpected hr %#lx.\n", v, hr);
+    }
+    for (v = 0; v < 5; ++v)
+    {
+        hr = ID2D1Effect_SetValue(effect, D2D1_COLORMANAGEMENT_PROP_SOURCE_RENDERING_INTENT,
+                D2D1_PROPERTY_TYPE_ENUM, (BYTE *)&v, sizeof(v));
+        ok(hr == (v <= 3 ? S_OK : E_INVALIDARG), "Intent %u: got unexpected hr %#lx.\n", v, hr);
+    }
+    effect_set_enum_prop(effect, D2D1_COLORMANAGEMENT_PROP_SOURCE_RENDERING_INTENT,
+            D2D1_COLORMANAGEMENT_RENDERING_INTENT_PERCEPTUAL);
+    effect_set_enum_prop(effect, D2D1_COLORMANAGEMENT_PROP_ALPHA_MODE, D2D1_COLORMANAGEMENT_ALPHA_MODE_PREMULTIPLIED);
+
+    hr = ID2D1DeviceContext_CreateColorContext(context, D2D1_COLOR_SPACE_SRGB, NULL, 0, &contexts[CM_SRGB]);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1DeviceContext_CreateColorContext(context, D2D1_COLOR_SPACE_SCRGB, NULL, 0, &contexts[CM_SCRGB]);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    /* The effect keeps its own reference, and hands out another. */
+    refcount = get_refcount(contexts[CM_SRGB]);
+    hr = ID2D1Effect_SetValue(effect, D2D1_COLORMANAGEMENT_PROP_SOURCE_COLOR_CONTEXT,
+            D2D1_PROPERTY_TYPE_COLOR_CONTEXT, (BYTE *)&contexts[CM_SRGB], sizeof(cc));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(get_refcount(contexts[CM_SRGB]) == refcount + 1, "Got unexpected refcount %lu.\n",
+            get_refcount(contexts[CM_SRGB]));
+    hr = ID2D1Effect_SetValue(effect, D2D1_COLORMANAGEMENT_PROP_SOURCE_COLOR_CONTEXT,
+            D2D1_PROPERTY_TYPE_COLOR_CONTEXT, (BYTE *)&contexts[CM_SRGB], sizeof(cc));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(get_refcount(contexts[CM_SRGB]) == refcount + 1, "Got unexpected refcount %lu.\n",
+            get_refcount(contexts[CM_SRGB]));
+    cc = NULL;
+    hr = ID2D1Effect_GetValue(effect, D2D1_COLORMANAGEMENT_PROP_SOURCE_COLOR_CONTEXT,
+            D2D1_PROPERTY_TYPE_COLOR_CONTEXT, (BYTE *)&cc, sizeof(cc));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(cc == contexts[CM_SRGB], "Got unexpected context %p.\n", cc);
+    ok(get_refcount(contexts[CM_SRGB]) == refcount + 2, "Got unexpected refcount %lu.\n",
+            get_refcount(contexts[CM_SRGB]));
+    if (cc)
+        ID2D1ColorContext_Release(cc);
+    cc = NULL;
+    hr = ID2D1Effect_SetValue(effect, D2D1_COLORMANAGEMENT_PROP_SOURCE_COLOR_CONTEXT,
+            D2D1_PROPERTY_TYPE_COLOR_CONTEXT, (BYTE *)&cc, sizeof(cc));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(get_refcount(contexts[CM_SRGB]) == refcount, "Got unexpected refcount %lu.\n",
+            get_refcount(contexts[CM_SRGB]));
+
+    if (FAILED(ID2D1DeviceContext_QueryInterface(context, &IID_ID2D1DeviceContext5, (void **)&context5)))
+    {
+        win_skip("ID2D1DeviceContext5 is not supported.\n");
+    }
+    else
+    {
+        for (i = 0; i < ARRAY_SIZE(dxgi_spaces); ++i)
+        {
+            hr = ID2D1DeviceContext5_CreateColorContextFromDxgiColorSpace(context5, dxgi_spaces[i],
+                    (ID2D1ColorContext1 **)&contexts[CM_G22_709 + i]);
+            ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        }
+    }
+
+    for (i = 0; i < ARRAY_SIZE(tests); ++i)
+    {
+        float tolerance = tests[i].format == DXGI_FORMAT_R32G32B32A32_FLOAT ? 0.0002f : 0.5f / 255.0f;
+
+        if ((tests[i].source != CM_NULL && !contexts[tests[i].source])
+                || (tests[i].destination != CM_NULL && !contexts[tests[i].destination]))
+            continue;
+        winetest_push_context("Test %u", i);
+        effect_set_enum_prop(effect, D2D1_COLORMANAGEMENT_PROP_QUALITY, tests[i].quality);
+        ID2D1Effect_SetValue(effect, D2D1_COLORMANAGEMENT_PROP_SOURCE_COLOR_CONTEXT,
+                D2D1_PROPERTY_TYPE_COLOR_CONTEXT, (BYTE *)&contexts[tests[i].source], sizeof(cc));
+        ID2D1Effect_SetValue(effect, D2D1_COLORMANAGEMENT_PROP_DESTINATION_COLOR_CONTEXT,
+                D2D1_PROPERTY_TYPE_COLOR_CONTEXT, (BYTE *)&contexts[tests[i].destination], sizeof(cc));
+        hr = render_effect_pixel(context, effect, effect, pixels[tests[i].pixel], tests[i].format, out);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        for (j = 0; j < 4; ++j)
+            ok(fabsf(out[j] - tests[i].expected[j]) <= tolerance, "Got unexpected colour {%.8e, %.8e, %.8e, %.8e}.\n",
+                    out[0], out[1], out[2], out[3]);
+        winetest_pop_context();
+    }
+
+    effect_set_enum_prop(effect, D2D1_COLORMANAGEMENT_PROP_QUALITY, D2D1_COLORMANAGEMENT_QUALITY_NORMAL);
+    effect_set_enum_prop(effect, D2D1_COLORMANAGEMENT_PROP_ALPHA_MODE, D2D1_COLORMANAGEMENT_ALPHA_MODE_STRAIGHT);
+    for (i = 0; i < ARRAY_SIZE(straight_tests); ++i)
+    {
+        winetest_push_context("Straight test %u", i);
+        ID2D1Effect_SetValue(effect, D2D1_COLORMANAGEMENT_PROP_SOURCE_COLOR_CONTEXT,
+                D2D1_PROPERTY_TYPE_COLOR_CONTEXT, (BYTE *)&contexts[straight_tests[i].source], sizeof(cc));
+        ID2D1Effect_SetValue(effect, D2D1_COLORMANAGEMENT_PROP_DESTINATION_COLOR_CONTEXT,
+                D2D1_PROPERTY_TYPE_COLOR_CONTEXT, (BYTE *)&contexts[straight_tests[i].destination], sizeof(cc));
+        hr = render_effect_pixel(context, effect, effect, pixels[straight_tests[i].pixel],
+                DXGI_FORMAT_R32G32B32A32_FLOAT, out);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        for (j = 0; j < 4; ++j)
+            ok(fabsf(out[j] - straight_tests[i].expected[j]) <= 0.0002f,
+                    "Got unexpected colour {%.8e, %.8e, %.8e, %.8e}.\n", out[0], out[1], out[2], out[3]);
+        winetest_pop_context();
+    }
+    effect_set_enum_prop(effect, D2D1_COLORMANAGEMENT_PROP_ALPHA_MODE, D2D1_COLORMANAGEMENT_ALPHA_MODE_PREMULTIPLIED);
+
+    if (context5)
+    {
+        for (i = 0; i < ARRAY_SIZE(bt2020_tests); ++i)
+        {
+            winetest_push_context("BT.2020 test %u", i);
+            ID2D1Effect_SetValue(effect, D2D1_COLORMANAGEMENT_PROP_SOURCE_COLOR_CONTEXT,
+                    D2D1_PROPERTY_TYPE_COLOR_CONTEXT, (BYTE *)&contexts[bt2020_tests[i].source], sizeof(cc));
+            ID2D1Effect_SetValue(effect, D2D1_COLORMANAGEMENT_PROP_DESTINATION_COLOR_CONTEXT,
+                    D2D1_PROPERTY_TYPE_COLOR_CONTEXT, (BYTE *)&contexts[bt2020_tests[i].destination], sizeof(cc));
+
+            effect_set_enum_prop(effect, D2D1_COLORMANAGEMENT_PROP_QUALITY, D2D1_COLORMANAGEMENT_QUALITY_NORMAL);
+            hr = render_effect_pixel(context, effect, effect, pixels[bt2020_tests[i].pixel],
+                    DXGI_FORMAT_R32G32B32A32_FLOAT, out);
+            todo_wine ok(hr == E_INVALIDARG, "Got unexpected hr %#lx.\n", hr);
+
+            effect_set_enum_prop(effect, D2D1_COLORMANAGEMENT_PROP_QUALITY, D2D1_COLORMANAGEMENT_QUALITY_BEST);
+            hr = render_effect_pixel(context, effect, effect, pixels[bt2020_tests[i].pixel],
+                    DXGI_FORMAT_R32G32B32A32_FLOAT, out);
+            ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+            for (j = 0; j < 4; ++j)
+                ok(fabsf(out[j] - bt2020_tests[i].expected[j]) <= bt2020_tests[i].tolerance,
+                        "Got unexpected colour {%.8e, %.8e, %.8e, %.8e}.\n", out[0], out[1], out[2], out[3]);
+            winetest_pop_context();
+        }
+        ID2D1DeviceContext5_Release(context5);
+    }
+
+    for (i = 0; i < ARRAY_SIZE(contexts); ++i)
+        if (contexts[i])
+            ID2D1ColorContext_Release(contexts[i]);
+    ID2D1Effect_Release(effect);
+    release_test_context(&ctx);
+}
