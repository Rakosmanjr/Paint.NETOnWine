+    ID2D1SolidColorBrush_Release(brush);
+
+    ID2D1GeometryRealization_Release(realization);
+    ID2D1GeometryRealization_Release(realization2);
+    ID2D1DeviceContext1_Release(device_context);
+    release_test_context(&ctx);
