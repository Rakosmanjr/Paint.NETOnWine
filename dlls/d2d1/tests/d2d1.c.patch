+static ID2D1StrokeStyle *create_stroke_style(ID2D1Factory *factory, D2D1_CAP_STYLE cap, D2D1_LINE_JOIN join,
+        float miter_limit)
+{
+    D2D1_STROKE_STYLE_PROPERTIES desc;
+    ID2D1StrokeStyle *style;
+    HRESULT hr;
+
+    desc.startCap = cap;
+    desc.endCap = cap;
+    desc.dashCap = D2D1_CAP_STYLE_FLAT;
+    desc.lineJoin = join;
+    desc.miterLimit = miter_limit;
+    desc.dashStyle = D2D1_DASH_STYLE_SOLID;
+    desc.dashOffset = 0.0f;
+    hr = ID2D1Factory_CreateStrokeStyle(factory, &desc, NULL, 0, &style);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    return style;
+}
