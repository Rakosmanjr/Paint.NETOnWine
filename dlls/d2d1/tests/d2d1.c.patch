+static HRESULT STDMETHODCALLTYPE passthrough_effect_impl_Initialize(ID2D1EffectImpl *iface,
+        ID2D1EffectContext *context, ID2D1TransformGraph *graph, UINT32 index)
+{
+    struct effect_impl *effect_impl = impl_from_ID2D1EffectImpl(iface);
+    HRESULT hr;
+
+    ID2D1EffectContext_AddRef(effect_impl->effect_context = context);
+
+    /* "index: The index of the input that will be passed through." Out of
+     * range is rejected and leaves the graph alone. */
+    hr = ID2D1TransformGraph_SetPassthroughGraph(graph, 2);
+    ok(hr == E_INVALIDARG, "Got unexpected hr %#lx.\n", hr);
+
+    return ID2D1TransformGraph_SetPassthroughGraph(graph, index);
+}
+
+static HRESULT STDMETHODCALLTYPE passthrough0_effect_impl_Initialize(ID2D1EffectImpl *iface,
+        ID2D1EffectContext *context, ID2D1TransformGraph *graph)
+{
+    return passthrough_effect_impl_Initialize(iface, context, graph, 0);
+}
+
+static HRESULT STDMETHODCALLTYPE passthrough1_effect_impl_Initialize(ID2D1EffectImpl *iface,
+        ID2D1EffectContext *context, ID2D1TransformGraph *graph)
+{
+    return passthrough_effect_impl_Initialize(iface, context, graph, 1);
+}
