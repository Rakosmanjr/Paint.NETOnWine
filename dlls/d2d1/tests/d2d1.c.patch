+static void test_command_list_clip_layer(BOOL d3d11)
+{
+    D2D1_LAYER_PARAMETERS1 layer_params;
+    ID2D1CommandList *command_list;
+    ID2D1SolidColorBrush *brush;
+    struct d2d1_test_context ctx;
+    struct resource_readback rb;
+    ID2D1DeviceContext *context;
+    ID2D1Image *target;
+    D2D1_COLOR_F colour;
+    D2D1_RECT_F rect;
+    DWORD value;
+    HRESULT hr;
+
+    if (!init_test_context(&ctx, d3d11))
+        return;
+
+    context = ctx.context;
+    if (!ctx.factory1)
+    {
+        win_skip("Command lists are not supported.\n");
+        release_test_context(&ctx);
+        return;
+    }
+
+    hr = ID2D1DeviceContext_CreateCommandList(context, &command_list);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    ID2D1DeviceContext_GetTarget(context, &target);
+    ID2D1DeviceContext_SetTarget(context, (ID2D1Image *)command_list);
+    ID2D1DeviceContext_BeginDraw(context);
+
+    set_color(&colour, 1.0f, 0.0f, 0.0f, 1.0f);
+    hr = ID2D1DeviceContext_CreateSolidColorBrush(context, &colour, NULL, &brush);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    /* A square clipped to its top left quarter. */
+    set_rect(&rect, 0.0f, 0.0f, 8.0f, 8.0f);
+    ID2D1DeviceContext_PushAxisAlignedClip(context, &rect, D2D1_ANTIALIAS_MODE_ALIASED);
+    set_rect(&rect, 0.0f, 0.0f, 16.0f, 16.0f);
+    ID2D1DeviceContext_FillRectangle(context, &rect, (ID2D1Brush *)brush);
+    ID2D1DeviceContext_PopAxisAlignedClip(context);
+
+    /* A second square limited by a layer's content bounds. */
+    memset(&layer_params, 0, sizeof(layer_params));
+    set_rect(&layer_params.contentBounds, 32.0f, 0.0f, 40.0f, 8.0f);
+    set_matrix_identity(&layer_params.maskTransform);
+    layer_params.maskAntialiasMode = D2D1_ANTIALIAS_MODE_ALIASED;
+    layer_params.opacity = 1.0f;
+    ID2D1DeviceContext_PushLayer(context, &layer_params, NULL);
+    set_rect(&rect, 32.0f, 0.0f, 48.0f, 16.0f);
+    ID2D1DeviceContext_FillRectangle(context, &rect, (ID2D1Brush *)brush);
+    ID2D1DeviceContext_PopLayer(context);
+
+    hr = ID2D1DeviceContext_EndDraw(context, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1DeviceContext_SetTarget(context, target);
+    if (target)
+        ID2D1Image_Release(target);
+    hr = ID2D1CommandList_Close(command_list);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    /* A command list is replayed "with no loss of fidelity", so the clip and
+     * the layer it recorded apply when it is drawn. */
+    ID2D1DeviceContext_BeginDraw(context);
+    ID2D1DeviceContext_Clear(context, NULL);
+    ID2D1DeviceContext_DrawImage(context, (ID2D1Image *)command_list, NULL, NULL, 0, 0);
+    hr = ID2D1DeviceContext_EndDraw(context, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    get_surface_readback(&ctx, &rb);
+    value = get_readback_colour(&rb, 4, 4);
+    ok(compare_colour(value, 0xffff0000, 1), "Got unexpected colour 0x%08lx inside the clip.\n", value);
+    value = get_readback_colour(&rb, 12, 12);
+    ok(compare_colour(value, 0x00000000, 1), "Got unexpected colour 0x%08lx outside the clip.\n", value);
+    value = get_readback_colour(&rb, 36, 4);
+    ok(compare_colour(value, 0xffff0000, 1), "Got unexpected colour 0x%08lx inside the layer.\n", value);
+    value = get_readback_colour(&rb, 44, 12);
+    ok(compare_colour(value, 0x00000000, 1), "Got unexpected colour 0x%08lx outside the layer.\n", value);
+    release_resource_readback(&rb);
+
+    ID2D1SolidColorBrush_Release(brush);
+    ID2D1CommandList_Release(command_list);
+    release_test_context(&ctx);
+}
