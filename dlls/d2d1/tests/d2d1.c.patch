+/* Winding number of the sample (x, y), in sixteenths, with respect to a
+ * closed polygon. Edges are half-open in y, so a sample level with a vertex
+ * is counted once. */
+static int coverage_polygon_winding(const struct coverage_polygon *polygon, LONGLONG x, LONGLONG y)
