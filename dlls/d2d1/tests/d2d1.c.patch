+static void draw_effect_image(ID2D1DeviceContext *context, ID2D1Effect *effect, const D2D1_POINT_2F *offset,
+        const D2D1_RECT_F *image_rect, HRESULT expected_hr)
+{
+    ID2D1Image *output;
+    HRESULT hr;
+
+    ID2D1Effect_GetOutput(effect, &output);
+    ID2D1DeviceContext_BeginDraw(context);
+    ID2D1DeviceContext_DrawImage(context, output, offset, image_rect, D2D1_INTERPOLATION_MODE_LINEAR,
+            D2D1_COMPOSITE_MODE_SOURCE_OVER);
+    hr = ID2D1DeviceContext_EndDraw(context, NULL, NULL);
+    ok(hr == expected_hr, "Got unexpected hr %#lx, expected %#lx.\n", hr, expected_hr);
+    ID2D1Image_Release(output);
+}
