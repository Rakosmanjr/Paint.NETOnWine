+
+static HRESULT passthrough_effect_impl_create(IUnknown **effect_impl, const ID2D1EffectImplVtbl *vtbl)
+{
+    struct effect_impl *object;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+
+    object->ID2D1EffectImpl_iface.lpVtbl = vtbl;
+    object->refcount = 1;
+
+    *effect_impl = (IUnknown *)&object->ID2D1EffectImpl_iface;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE passthrough0_effect_impl_create(IUnknown **effect_impl)
+{
+    return passthrough_effect_impl_create(effect_impl, &passthrough0_effect_impl_vtbl);
+}
