+            "Got unexpected DXGI colour space %u.\n", ID2D1ColorContext1_GetDXGIColorSpace(context1));
+    ok(!!ID2D1ColorContext1_GetProfileSize(context1), "Got no profile.\n");
+    hr = ID2D1ColorContext1_GetSimpleColorProfile(context1, &out);
+    ok(hr == E_INVALIDARG, "Got unexpected hr %#lx.\n", hr);
+    ID2D1ColorContext1_Release(context1);
+    ID2D1ColorContext_Release(cc);
+
+    hr = ID2D1DeviceContext5_CreateColorContext(dc5, D2D1_COLOR_SPACE_SCRGB, NULL, 0, &cc);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1ColorContext_QueryInterface(cc, &IID_ID2D1ColorContext1, (void **)&context1);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(ID2D1ColorContext1_GetColorContextType(context1) == D2D1_COLOR_CONTEXT_TYPE_ICC,
+            "Got unexpected type %u.\n", ID2D1ColorContext1_GetColorContextType(context1));
+    ok(ID2D1ColorContext1_GetDXGIColorSpace(context1) == DXGI_COLOR_SPACE_RGB_FULL_G10_NONE_P709,
+            "Got unexpected DXGI colour space %u.\n", ID2D1ColorContext1_GetDXGIColorSpace(context1));
+    hr = ID2D1ColorContext1_GetSimpleColorProfile(context1, &out);
+    ok(hr == E_INVALIDARG, "Got unexpected hr %#lx.\n", hr);
+    ID2D1ColorContext1_Release(context1);
+    ID2D1ColorContext_Release(cc);
+
+    /* A context for a DXGI colour space carries no profile of its own. */
+    for (i = 0; i < ARRAY_SIZE(dxgi_tests); ++i)
+    {
+        winetest_push_context("DXGI colour space %u", dxgi_tests[i].dxgi);
+        context1 = NULL;
+        hr = ID2D1DeviceContext5_CreateColorContextFromDxgiColorSpace(dc5, dxgi_tests[i].dxgi, &context1);
+        ok(hr == dxgi_tests[i].hr, "Got unexpected hr %#lx.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            ok(ID2D1ColorContext1_GetColorContextType(context1) == D2D1_COLOR_CONTEXT_TYPE_DXGI,
+                    "Got unexpected type %u.\n", ID2D1ColorContext1_GetColorContextType(context1));
+            ok(ID2D1ColorContext1_GetDXGIColorSpace(context1) == dxgi_tests[i].dxgi,
+                    "Got unexpected DXGI colour space %u.\n", ID2D1ColorContext1_GetDXGIColorSpace(context1));
+            ok(ID2D1ColorContext1_GetColorSpace(context1) == dxgi_tests[i].space,
+                    "Got unexpected colour space %u.\n", ID2D1ColorContext1_GetColorSpace(context1));
+            ok(!ID2D1ColorContext1_GetProfileSize(context1), "Got unexpected profile size %u.\n",
+                    ID2D1ColorContext1_GetProfileSize(context1));
+            hr = ID2D1ColorContext1_GetSimpleColorProfile(context1, &out);
+            ok(hr == E_INVALIDARG, "Got unexpected hr %#lx.\n", hr);
+            ID2D1ColorContext1_Release(context1);
+        }
+        winetest_pop_context();
+    }
+
+    /* "Retrieves a set simple color profile": the one the context was made
+     * from. */
+    profile.redPrimary.x = 0.64f;
+    profile.redPrimary.y = 0.33f;
+    profile.greenPrimary.x = 0.30f;
+    profile.greenPrimary.y = 0.60f;
+    profile.bluePrimary.x = 0.15f;
+    profile.bluePrimary.y = 0.06f;
+    profile.whitePointXZ.x = 0.9505f;
+    profile.whitePointXZ.y = 1.0890f;
+    profile.gamma = D2D1_GAMMA1_G2084;
+    hr = ID2D1DeviceContext5_CreateColorContextFromSimpleColorProfile(dc5, &profile, &context1);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    if (FAILED(hr))
+    {
+        ID2D1DeviceContext5_Release(dc5);
+        release_test_context(&ctx);
+        return;
+    }
+    ok(ID2D1ColorContext1_GetColorContextType(context1) == D2D1_COLOR_CONTEXT_TYPE_SIMPLE,
+            "Got unexpected type %u.\n", ID2D1ColorContext1_GetColorContextType(context1));
+    ok(ID2D1ColorContext1_GetDXGIColorSpace(context1) == DXGI_COLOR_SPACE_CUSTOM,
+            "Got unexpected DXGI colour space %u.\n", ID2D1ColorContext1_GetDXGIColorSpace(context1));
+    ok(ID2D1ColorContext1_GetColorSpace(context1) == D2D1_COLOR_SPACE_CUSTOM,
+            "Got unexpected colour space %u.\n", ID2D1ColorContext1_GetColorSpace(context1));
+    ok(!ID2D1ColorContext1_GetProfileSize(context1), "Got unexpected profile size %u.\n",
+            ID2D1ColorContext1_GetProfileSize(context1));
+    memset(&out, 0xcc, sizeof(out));
+    hr = ID2D1ColorContext1_GetSimpleColorProfile(context1, &out);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(!memcmp(&out, &profile, sizeof(out)), "Got a different profile back.\n");
+    ID2D1ColorContext1_Release(context1);
+
+    ID2D1DeviceContext5_Release(dc5);
+    release_test_context(&ctx);
+}
