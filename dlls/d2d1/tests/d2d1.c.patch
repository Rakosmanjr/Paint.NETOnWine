+/* A draw transform that records the rect mapping calls made into it. */
+struct mapping_transform
+{
+    ID2D1DrawTransform ID2D1DrawTransform_iface;
+    LONG refcount;
+    const char *name;
+    unsigned int input_count;
+    LONG margin;
+};
+
+static char mapping_log[2048];
+/* The transform moves its input by this much. */
+static LONG mapping_offset_x, mapping_offset_y;
+
+static void mapping_log_append(const char *fmt, ...)
+{
+    size_t len = strlen(mapping_log);
+    va_list args;
+
+    va_start(args, fmt);
+    vsnprintf(mapping_log + len, sizeof(mapping_log) - len, fmt, args);
+    va_end(args);
+}
+
+static void mapping_log_rect(const D2D1_RECT_L *rect)
+{
+    mapping_log_append("(%ld,%ld,%ld,%ld)", rect->left, rect->top, rect->right, rect->bottom);
+}
+
+static inline struct mapping_transform *impl_from_mapping_ID2D1DrawTransform(ID2D1DrawTransform *iface)
+{
+    return CONTAINING_RECORD(iface, struct mapping_transform, ID2D1DrawTransform_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE mapping_transform_QueryInterface(ID2D1DrawTransform *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_ID2D1DrawTransform)
+            || IsEqualGUID(iid, &IID_ID2D1Transform)
+            || IsEqualGUID(iid, &IID_ID2D1TransformNode)
+            || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        ID2D1DrawTransform_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE mapping_transform_AddRef(ID2D1DrawTransform *iface)
+{
+    struct mapping_transform *transform = impl_from_mapping_ID2D1DrawTransform(iface);
+    return InterlockedIncrement(&transform->refcount);
+}
+
+static ULONG STDMETHODCALLTYPE mapping_transform_Release(ID2D1DrawTransform *iface)
+{
+    struct mapping_transform *transform = impl_from_mapping_ID2D1DrawTransform(iface);
+    ULONG refcount = InterlockedDecrement(&transform->refcount);
+
+    if (!refcount)
+        free(transform);
+    return refcount;
+}
+
+static UINT32 STDMETHODCALLTYPE mapping_transform_GetInputCount(ID2D1DrawTransform *iface)
+{
+    struct mapping_transform *transform = impl_from_mapping_ID2D1DrawTransform(iface);
+    return transform->input_count;
+}
+
+static HRESULT STDMETHODCALLTYPE mapping_transform_MapOutputRectToInputRects(ID2D1DrawTransform *iface,
+        const D2D1_RECT_L *output_rect, D2D1_RECT_L *input_rects, UINT32 input_rect_count)
+{
+    struct mapping_transform *transform = impl_from_mapping_ID2D1DrawTransform(iface);
+    unsigned int i;
+
+    mapping_log_append("%s:out", transform->name);
+    mapping_log_rect(output_rect);
+    mapping_log_append("x%u;", input_rect_count);
+
+    for (i = 0; i < input_rect_count; ++i)
+    {
+        input_rects[i].left = output_rect->left - transform->margin - mapping_offset_x;
+        input_rects[i].top = output_rect->top - transform->margin - mapping_offset_y;
+        input_rects[i].right = output_rect->right + transform->margin - mapping_offset_x;
+        input_rects[i].bottom = output_rect->bottom + transform->margin - mapping_offset_y;
+    }
+
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE mapping_transform_MapInputRectsToOutputRect(ID2D1DrawTransform *iface,
+        const D2D1_RECT_L *input_rects, const D2D1_RECT_L *input_opaque_rects, UINT32 input_rect_count,
+        D2D1_RECT_L *output_rect, D2D1_RECT_L *output_opaque_rect)
+{
+    struct mapping_transform *transform = impl_from_mapping_ID2D1DrawTransform(iface);
+    unsigned int i;
+
+    mapping_log_append("%s:in", transform->name);
+    for (i = 0; i < input_rect_count; ++i)
+        mapping_log_rect(&input_rects[i]);
+    mapping_log_append("o");
+    for (i = 0; i < input_rect_count; ++i)
+        mapping_log_rect(&input_opaque_rects[i]);
+    mapping_log_append("x%u;", input_rect_count);
+
+    output_rect->left = input_rects[0].left - transform->margin + mapping_offset_x;
+    output_rect->top = input_rects[0].top - transform->margin + mapping_offset_y;
+    output_rect->right = input_rects[0].right + transform->margin + mapping_offset_x;
+    output_rect->bottom = input_rects[0].bottom + transform->margin + mapping_offset_y;
+    memset(output_opaque_rect, 0, sizeof(*output_opaque_rect));
+
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE mapping_transform_MapInvalidRect(ID2D1DrawTransform *iface,
+        UINT32 index, D2D1_RECT_L input_rect, D2D1_RECT_L *output_rect)
+{
+    struct mapping_transform *transform = impl_from_mapping_ID2D1DrawTransform(iface);
+
+    mapping_log_append("%s:inv%u;", transform->name, index);
+    *output_rect = input_rect;
+    return S_OK;
+}
