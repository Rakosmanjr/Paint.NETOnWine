+static void test_is_dxgi_format_supported(BOOL d3d11)
+{
+    static const struct
+    {
+        DXGI_FORMAT format;
+        BOOL supported;
+    }
+    tests[] =
+    {
+        {DXGI_FORMAT_B8G8R8A8_UNORM,      TRUE},
+        {DXGI_FORMAT_R8G8B8A8_UNORM,      TRUE},
+        {DXGI_FORMAT_A8_UNORM,            TRUE},
+        {DXGI_FORMAT_R16G16B16A16_FLOAT,  TRUE},
+        {DXGI_FORMAT_R32G32B32A32_FLOAT,  TRUE},
+        {DXGI_FORMAT_R8G8B8A8_TYPELESS,   FALSE},
+        {DXGI_FORMAT_B8G8R8A8_TYPELESS,   FALSE},
+        {DXGI_FORMAT_R8G8B8A8_UINT,       FALSE},
+        {DXGI_FORMAT_R8G8B8A8_SINT,       FALSE},
+        {DXGI_FORMAT_UNKNOWN,             FALSE},
+    };
+
+    struct d2d1_test_context ctx;
+    ID2D1DeviceContext *context;
+    unsigned int i;
+    BOOL supported;
+
+    if (!init_test_context(&ctx, d3d11))
+        return;
+
+    if (!(context = ctx.context))
+    {
+        win_skip("ID2D1DeviceContext is not supported.\n");
+        release_test_context(&ctx);
+        return;
+    }
+
+    for (i = 0; i < ARRAY_SIZE(tests); ++i)
+    {
+        winetest_push_context("format %#x", tests[i].format);
+        supported = ID2D1DeviceContext_IsDxgiFormatSupported(context, tests[i].format);
+        ok(supported == tests[i].supported, "Got unexpected result %d.\n", supported);
+        winetest_pop_context();
+    }
+
+    release_test_context(&ctx);
+}
