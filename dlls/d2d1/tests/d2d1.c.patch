+/* A transform whose output is larger than its input, so that the shader
+ * samples where the input image does not exist. */
+#define EFFECT_INPUT_BOUNDS_EXPAND 8
+
+static HRESULT STDMETHODCALLTYPE effect_impl_expand_transform_MapOutputRectToInputRects(
+        ID2D1DrawTransform *iface, const D2D1_RECT_L *output_rect, D2D1_RECT_L *input_rects,
+        UINT32 input_rect_count)
+{
+    if (input_rect_count != 1)
+        return E_INVALIDARG;
+
+    /* Ask for the whole output region, more than the input covers. */
+    input_rects[0] = *output_rect;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE effect_impl_expand_transform_MapInputRectsToOutputRect(
+        ID2D1DrawTransform *iface, const D2D1_RECT_L *input_rects, const D2D1_RECT_L *input_opaque_rects,
+        UINT32 input_rect_count, D2D1_RECT_L *output_rect, D2D1_RECT_L *output_opaque_rect)
+{
+    if (input_rect_count != 1)
+        return E_INVALIDARG;
+
+    output_rect->left = input_rects[0].left - EFFECT_INPUT_BOUNDS_EXPAND;
+    output_rect->top = input_rects[0].top - EFFECT_INPUT_BOUNDS_EXPAND;
+    output_rect->right = input_rects[0].right + EFFECT_INPUT_BOUNDS_EXPAND;
+    output_rect->bottom = input_rects[0].bottom + EFFECT_INPUT_BOUNDS_EXPAND;
+    memset(output_opaque_rect, 0, sizeof(*output_opaque_rect));
+
+    return S_OK;
+}
+
+static const ID2D1DrawTransformVtbl effect_impl_expand_transform_vtbl =
+{
+    effect_impl_draw_transform_QueryInterface,
+    effect_impl_draw_transform_AddRef,
+    effect_impl_draw_transform_Release,
+    effect_impl_draw_transform_GetInputCount,
+    effect_impl_expand_transform_MapOutputRectToInputRects,
+    effect_impl_expand_transform_MapInputRectsToOutputRect,
+    effect_impl_draw_transform_MapInvalidRect,
+    effect_impl_draw_transform_SetDrawInfo,
+};
+
+static HRESULT STDMETHODCALLTYPE expand_effect_impl_create(IUnknown **effect_impl)
+{
+    struct effect_impl *object;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+
+    object->ID2D1EffectImpl_iface.lpVtbl = &custom_effect_impl_vtbl;
+    object->ID2D1DrawTransform_iface.lpVtbl = &effect_impl_expand_transform_vtbl;
+    object->refcount = 1;
+    object->pixel_shader = &GUID_TestSampleShader;
+
+    *effect_impl = (IUnknown *)&object->ID2D1EffectImpl_iface;
+    return S_OK;
+}
