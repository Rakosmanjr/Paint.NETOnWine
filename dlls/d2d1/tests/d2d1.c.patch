+    effect_impl_draw_transform_MapOutputRectToInputRects,
+    effect_impl_draw_transform_MapInputRectsToOutputRect,
+    effect_impl_draw_transform_MapInvalidRect,
+    late_draw_transform_SetDrawInfo,
+};
