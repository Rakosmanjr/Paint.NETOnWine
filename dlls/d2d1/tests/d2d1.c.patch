+    static const D2D1_FILTER point = D2D1_FILTER_MIN_MAG_MIP_POINT;
+    static const D2D1_FILTER linear = D2D1_FILTER_MIN_MAG_MIP_LINEAR;
+    static const D2D1_FILTER min_linear = D2D1_FILTER_MIN_LINEAR_MAG_MIP_POINT;
+    static const D2D1_FILTER mag_linear = D2D1_FILTER_MIN_POINT_MAG_LINEAR_MIP_POINT;
