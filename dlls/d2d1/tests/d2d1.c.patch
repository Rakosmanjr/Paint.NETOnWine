+/* A WIC bitmap render target draws over what the bitmap already holds,
+ * including changes made to it between draws. */
+static void test_wic_target_content(BOOL d3d11)
+{
+    D2D1_RENDER_TARGET_PROPERTIES desc;
+    IWICImagingFactory *wic_factory;
+    IWICBitmapLock *lock;
+    ID2D1SolidColorBrush *brush;
+    struct d2d1_test_context ctx;
+    IWICBitmap *wic_bitmap;
+    DWORD pixels[16 * 16];
+    ID2D1RenderTarget *rt;
+    D2D1_COLOR_F colour;
+    D2D1_RECT_F rect;
+    unsigned int i;
+    DWORD pixel;
+    HRESULT hr;
+
+    if (!init_test_context(&ctx, d3d11))
+        return;
+
+    CoInitializeEx(NULL, COINIT_APARTMENTTHREADED);
+    hr = CoCreateInstance(&CLSID_WICImagingFactory, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IWICImagingFactory, (void **)&wic_factory);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    for (i = 0; i < ARRAY_SIZE(pixels); ++i)
+        pixels[i] = 0xff00ff00;
+    hr = IWICImagingFactory_CreateBitmapFromMemory(wic_factory, 16, 16, &GUID_WICPixelFormat32bppPBGRA,
+            16 * sizeof(*pixels), sizeof(pixels), (BYTE *)pixels, &wic_bitmap);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    IWICImagingFactory_Release(wic_factory);
+
+    desc.type = D2D1_RENDER_TARGET_TYPE_DEFAULT;
+    desc.pixelFormat.format = DXGI_FORMAT_UNKNOWN;
+    desc.pixelFormat.alphaMode = D2D1_ALPHA_MODE_UNKNOWN;
+    desc.dpiX = 96.0f;
+    desc.dpiY = 96.0f;
+    desc.usage = D2D1_RENDER_TARGET_USAGE_NONE;
+    desc.minLevel = D2D1_FEATURE_LEVEL_DEFAULT;
+    hr = ID2D1Factory_CreateWicBitmapRenderTarget(ctx.factory, wic_bitmap, &desc, &rt);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    set_color(&colour, 1.0f, 0.0f, 0.0f, 1.0f);
+    hr = ID2D1RenderTarget_CreateSolidColorBrush(rt, &colour, NULL, &brush);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    ID2D1RenderTarget_BeginDraw(rt);
+    set_rect(&rect, 0.0f, 0.0f, 4.0f, 4.0f);
+    ID2D1RenderTarget_FillRectangle(rt, &rect, (ID2D1Brush *)brush);
+    hr = ID2D1RenderTarget_EndDraw(rt, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    pixel = get_wic_bitmap_pixel(wic_bitmap, 2, 2);
+    ok(pixel == 0xffff0000, "Got unexpected pixel 0x%08lx inside the fill.\n", pixel);
+    pixel = get_wic_bitmap_pixel(wic_bitmap, 10, 10);
+    ok(pixel == 0xff00ff00, "Got unexpected pixel 0x%08lx outside the fill.\n", pixel);
+
+    /* A pixel changed through the bitmap itself survives the next draw. */
+    set_wic_bitmap_pixel(wic_bitmap, 12, 12, 0xff0000ff);
+    ID2D1RenderTarget_BeginDraw(rt);
+    set_rect(&rect, 4.0f, 4.0f, 8.0f, 8.0f);
+    ID2D1RenderTarget_FillRectangle(rt, &rect, (ID2D1Brush *)brush);
+    hr = ID2D1RenderTarget_EndDraw(rt, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    pixel = get_wic_bitmap_pixel(wic_bitmap, 12, 12);
+    ok(pixel == 0xff0000ff, "Got unexpected pixel 0x%08lx changed between draws.\n", pixel);
+    pixel = get_wic_bitmap_pixel(wic_bitmap, 2, 2);
+    ok(pixel == 0xffff0000, "Got unexpected pixel 0x%08lx from the first draw.\n", pixel);
+    pixel = get_wic_bitmap_pixel(wic_bitmap, 6, 6);
+    ok(pixel == 0xffff0000, "Got unexpected pixel 0x%08lx from the second draw.\n", pixel);
+    pixel = get_wic_bitmap_pixel(wic_bitmap, 10, 2);
+    ok(pixel == 0xff00ff00, "Got unexpected pixel 0x%08lx never drawn to.\n", pixel);
+
+    /* Flushing outside a draw has nothing to write back. */
+    set_wic_bitmap_pixel(wic_bitmap, 2, 2, 0xff0000ff);
+    set_wic_bitmap_pixel(wic_bitmap, 13, 13, 0xff0000ff);
+    hr = ID2D1RenderTarget_Flush(rt, NULL, NULL);
+    ok(hr == D2DERR_WRONG_STATE, "Got unexpected hr %#lx.\n", hr);
+    pixel = get_wic_bitmap_pixel(wic_bitmap, 2, 2);
+    ok(pixel == 0xff0000ff, "Got unexpected pixel 0x%08lx after flushing.\n", pixel);
+    pixel = get_wic_bitmap_pixel(wic_bitmap, 13, 13);
+    ok(pixel == 0xff0000ff, "Got unexpected pixel 0x%08lx after flushing.\n", pixel);
+
+    /* Flushing inside a draw. */
+    ID2D1RenderTarget_BeginDraw(rt);
+    set_rect(&rect, 8.0f, 8.0f, 10.0f, 10.0f);
+    ID2D1RenderTarget_FillRectangle(rt, &rect, (ID2D1Brush *)brush);
+    hr = ID2D1RenderTarget_Flush(rt, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = IWICBitmap_Lock(wic_bitmap, NULL, WICBitmapLockRead, &lock);
+    ok(hr == WINCODEC_ERR_ALREADYLOCKED, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1RenderTarget_EndDraw(rt, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    pixel = get_wic_bitmap_pixel(wic_bitmap, 9, 9);
+    ok(pixel == 0xffff0000, "Got unexpected pixel 0x%08lx after ending a flushed draw.\n", pixel);
+    pixel = get_wic_bitmap_pixel(wic_bitmap, 13, 13);
+    ok(pixel == 0xff0000ff, "Got unexpected pixel 0x%08lx after ending a flushed draw.\n", pixel);
+
+    ID2D1SolidColorBrush_Release(brush);
+    ID2D1RenderTarget_Release(rt);
+    IWICBitmap_Release(wic_bitmap);
+    release_test_context(&ctx);
+}
