+/* Records each PrepareForRender() call: "Count" is the number of calls and
+ * "History" their change types, two bits each, oldest first. */
+static HRESULT STDMETHODCALLTYPE counting_effect_impl_PrepareForRender(ID2D1EffectImpl *iface,
+        D2D1_CHANGE_TYPE type)
+{
+    struct effect_impl *effect_impl = impl_from_ID2D1EffectImpl(iface);
+
+    ++effect_impl->prepare_count;
+    effect_impl->prepare_history = effect_impl->prepare_history << 2 | type;
+    return S_OK;
+}
