+    layer_desc.opacity = 1.0f;
+    layer_desc.opacityBrush = NULL;
+    layer_desc.layerOptions = D2D1_LAYER_OPTIONS1_NONE;
+    ID2D1DeviceContext_PushLayer(context, &layer_desc, NULL);
+
+    set_rect(&rect, 0.0f, 0.0f, 640.0f, 480.0f);
+    ID2D1RenderTarget_FillRectangle(rt, &rect, (ID2D1Brush *)brush);
+
+    ID2D1DeviceContext_PopLayer(context);
+    hr = ID2D1RenderTarget_EndDraw(rt, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    get_surface_readback(&ctx, &rb);
+    colour = get_readback_colour(&rb, 150, 150);
+    ok(compare_colour(colour, 0xffff0000, 1), "Got unexpected colour 0x%08lx inside bounds.\n", colour);
+    colour = get_readback_colour(&rb, 50, 50);
+    ok(compare_colour(colour, 0xffffffff, 1), "Got unexpected colour 0x%08lx outside bounds.\n", colour);
+    release_resource_readback(&rb);
+
+    ID2D1SolidColorBrush_Release(brush);
+    ID2D1DeviceContext_Release(context);
+    release_test_context(&ctx);
