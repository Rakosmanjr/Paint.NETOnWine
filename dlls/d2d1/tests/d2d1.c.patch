+    mapping_transform_GetInputCount,
+    mapping_transform_MapOutputRectToInputRects,
+    mapping_transform_MapInputRectsToOutputRect,
+    mapping_transform_MapInvalidRect,
+    mapping_transform_SetDrawInfo,
+};
+
+static struct mapping_transform *create_mapping_transform(const char *name, unsigned int input_count, LONG margin)
+{
+    struct mapping_transform *transform;
+
+    transform = calloc(1, sizeof(*transform));
+    transform->ID2D1DrawTransform_iface.lpVtbl = &mapping_transform_vtbl;
+    transform->refcount = 1;
+    transform->name = name;
+    transform->input_count = input_count;
+    transform->margin = margin;
+    return transform;
+}
+
+/* How the effect lays out its graph. */
+enum mapping_layout
+{
+    /* A single node T. */
+    MAPPING_LAYOUT_SINGLE,
+    /* A chain: the effect input feeds A, A feeds B. */
+    MAPPING_LAYOUT_CHAIN,
+    /* B has two inputs: the effect input directly, and through A. */
+    MAPPING_LAYOUT_TWO_INPUTS,
+    /* The node for a nested effect feeds B. */
+    MAPPING_LAYOUT_NESTED,
+};
+
+static enum mapping_layout mapping_layout;
+static LONG mapping_margin;
+static ID2D1Effect *mapping_nested_effect;
+
+struct mapping_effect
+{
+    ID2D1EffectImpl ID2D1EffectImpl_iface;
+    LONG refcount;
+};
+
+static inline struct mapping_effect *impl_from_mapping_ID2D1EffectImpl(ID2D1EffectImpl *iface)
+{
+    return CONTAINING_RECORD(iface, struct mapping_effect, ID2D1EffectImpl_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE mapping_effect_QueryInterface(ID2D1EffectImpl *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_ID2D1EffectImpl) || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        ID2D1EffectImpl_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE mapping_effect_AddRef(ID2D1EffectImpl *iface)
+{
+    struct mapping_effect *effect = impl_from_mapping_ID2D1EffectImpl(iface);
+    return InterlockedIncrement(&effect->refcount);
+}
+
+static ULONG STDMETHODCALLTYPE mapping_effect_Release(ID2D1EffectImpl *iface)
+{
+    struct mapping_effect *effect = impl_from_mapping_ID2D1EffectImpl(iface);
+    ULONG refcount = InterlockedDecrement(&effect->refcount);
+
+    if (!refcount)
+        free(effect);
+    return refcount;
+}
+
+static HRESULT STDMETHODCALLTYPE mapping_effect_Initialize(ID2D1EffectImpl *iface,
+        ID2D1EffectContext *context, ID2D1TransformGraph *graph)
+{
+    struct mapping_transform *a, *b;
+    ID2D1TransformNode *node;
+    HRESULT hr;
+
+    switch (mapping_layout)
+    {
+        case MAPPING_LAYOUT_SINGLE:
+            a = create_mapping_transform("T", 1, mapping_margin);
+            hr = ID2D1TransformGraph_SetSingleTransformNode(graph, (ID2D1TransformNode *)&a->ID2D1DrawTransform_iface);
+            ID2D1DrawTransform_Release(&a->ID2D1DrawTransform_iface);
+            return hr;
+
+        case MAPPING_LAYOUT_CHAIN:
+            a = create_mapping_transform("A", 1, mapping_margin);
+            b = create_mapping_transform("B", 1, mapping_margin);
+            ID2D1TransformGraph_AddNode(graph, (ID2D1TransformNode *)&a->ID2D1DrawTransform_iface);
+            ID2D1TransformGraph_AddNode(graph, (ID2D1TransformNode *)&b->ID2D1DrawTransform_iface);
+            ID2D1TransformGraph_ConnectToEffectInput(graph, 0, (ID2D1TransformNode *)&a->ID2D1DrawTransform_iface, 0);
+            ID2D1TransformGraph_ConnectNode(graph, (ID2D1TransformNode *)&a->ID2D1DrawTransform_iface,
+                    (ID2D1TransformNode *)&b->ID2D1DrawTransform_iface, 0);
+            hr = ID2D1TransformGraph_SetOutputNode(graph, (ID2D1TransformNode *)&b->ID2D1DrawTransform_iface);
+            ID2D1DrawTransform_Release(&a->ID2D1DrawTransform_iface);
+            ID2D1DrawTransform_Release(&b->ID2D1DrawTransform_iface);
+            return hr;
+
+        case MAPPING_LAYOUT_TWO_INPUTS:
+            a = create_mapping_transform("A", 1, 0);
+            b = create_mapping_transform("B", 2, 0);
+            ID2D1TransformGraph_AddNode(graph, (ID2D1TransformNode *)&a->ID2D1DrawTransform_iface);
+            ID2D1TransformGraph_AddNode(graph, (ID2D1TransformNode *)&b->ID2D1DrawTransform_iface);
+            ID2D1TransformGraph_ConnectToEffectInput(graph, 0, (ID2D1TransformNode *)&a->ID2D1DrawTransform_iface, 0);
+            ID2D1TransformGraph_ConnectToEffectInput(graph, 0, (ID2D1TransformNode *)&b->ID2D1DrawTransform_iface, 0);
+            ID2D1TransformGraph_ConnectNode(graph, (ID2D1TransformNode *)&a->ID2D1DrawTransform_iface,
+                    (ID2D1TransformNode *)&b->ID2D1DrawTransform_iface, 1);
+            hr = ID2D1TransformGraph_SetOutputNode(graph, (ID2D1TransformNode *)&b->ID2D1DrawTransform_iface);
+            ID2D1DrawTransform_Release(&a->ID2D1DrawTransform_iface);
+            ID2D1DrawTransform_Release(&b->ID2D1DrawTransform_iface);
+            return hr;
+
+        case MAPPING_LAYOUT_NESTED:
+            b = create_mapping_transform("B", 1, 0);
+            hr = ID2D1EffectContext_CreateTransformNodeFromEffect(context, mapping_nested_effect, &node);
+            ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+            ID2D1TransformGraph_AddNode(graph, node);
+            ID2D1TransformGraph_AddNode(graph, (ID2D1TransformNode *)&b->ID2D1DrawTransform_iface);
+            ID2D1TransformGraph_ConnectToEffectInput(graph, 0, node, 0);
+            ID2D1TransformGraph_ConnectNode(graph, node, (ID2D1TransformNode *)&b->ID2D1DrawTransform_iface, 0);
+            hr = ID2D1TransformGraph_SetOutputNode(graph, (ID2D1TransformNode *)&b->ID2D1DrawTransform_iface);
+            ID2D1TransformNode_Release(node);
+            ID2D1DrawTransform_Release(&b->ID2D1DrawTransform_iface);
+            return hr;
+    }
+
+    return E_FAIL;
+}
