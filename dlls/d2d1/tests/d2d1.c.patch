+/* Draws "effect" and reports whether its 16x16 input came out where the input
+ * is (passthrough) or 10 pixels to the right of it (the offset node). */
+static const char *draw_passthrough_or_offset(struct d2d1_test_context *ctx, ID2D1Effect *effect)
+{
+    struct resource_readback rb;
+    DWORD left, right;
+    ID2D1Image *output;
+    HRESULT hr;
+
+    ID2D1Effect_GetOutput(effect, &output);
+    ID2D1DeviceContext_BeginDraw(ctx->context);
+    ID2D1DeviceContext_Clear(ctx->context, NULL);
+    ID2D1DeviceContext_DrawImage(ctx->context, output, NULL, NULL, 0, 0);
+    hr = ID2D1DeviceContext_EndDraw(ctx->context, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1Image_Release(output);
+
+    get_surface_readback(ctx, &rb);
+    left = get_readback_colour(&rb, 5, 5);
+    right = get_readback_colour(&rb, 20, 5);
+    release_resource_readback(&rb);
+
+    if (left && !right)
+        return "passthrough";
+    if (!left && right)
+        return "offset";
+    return "other";
+}
+
+/* Changes the transform graph one step at a time, each step selected by the
+ * "Integer" property. D2D only accepts graph changes from the effect's own
+ * callbacks, so they are made from PrepareForRender(), which follows a
+ * property change. */
+static HRESULT STDMETHODCALLTYPE graph_step_effect_impl_PrepareForRender(ID2D1EffectImpl *iface,
+        D2D1_CHANGE_TYPE type)
+{
+    struct effect_impl *effect_impl = impl_from_ID2D1EffectImpl(iface);
+    ID2D1TransformGraph *graph = effect_impl->transform_graph;
+    static const D2D1_RECT_L bounds = {2, 3, 8, 40};
+    ID2D1BoundsAdjustmentTransform *bounds_transform;
+    ID2D1TransformNode *node, *node2;
+    POINT offset = {10, 0};
+    POINT zero = {0, 0};
+    HRESULT hr;
+
+    if (effect_impl->integer == effect_impl->graph_step)
+        return S_OK;
+    effect_impl->graph_step = effect_impl->integer;
+
+    if (!effect_impl->nodes[0])
+    {
+        hr = ID2D1EffectContext_CreateOffsetTransform(effect_impl->effect_context, offset,
+                (ID2D1OffsetTransform **)&effect_impl->nodes[0]);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        hr = ID2D1EffectContext_CreateOffsetTransform(effect_impl->effect_context, zero,
+                (ID2D1OffsetTransform **)&effect_impl->nodes[1]);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    }
+    node = effect_impl->nodes[0];
+    node2 = effect_impl->nodes[1];
+
+    switch (effect_impl->graph_step)
+    {
+        case 1:
+            /* The graph keeps its nodes and connections while it passes an
+             * input through. */
+            ID2D1TransformGraph_Clear(graph);
+            hr = ID2D1TransformGraph_AddNode(graph, node);
+            ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+            hr = ID2D1TransformGraph_AddNode(graph, node2);
+            ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+            hr = ID2D1TransformGraph_ConnectToEffectInput(graph, 0, node, 0);
+            ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+            hr = ID2D1TransformGraph_ConnectNode(graph, node, node2, 0);
+            ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+            hr = ID2D1TransformGraph_SetOutputNode(graph, node2);
+            ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+            hr = ID2D1TransformGraph_SetPassthroughGraph(graph, 0);
+            ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+            hr = ID2D1TransformGraph_AddNode(graph, node);
+            ok(hr == E_INVALIDARG, "Got unexpected hr %#lx.\n", hr);
+            hr = ID2D1TransformGraph_ConnectNode(graph, node, node2, 0);
+            ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+            break;
+
+        case 2:
+            /* Connecting an effect input leaves the passthrough in place. */
+            hr = ID2D1TransformGraph_ConnectToEffectInput(graph, 0, node, 0);
+            ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+            break;
+
+        case 3:
+            /* Setting an output node ends it. */
+            hr = ID2D1TransformGraph_SetOutputNode(graph, node);
+            ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+            break;
+
+        case 4:
+            /* So does replacing the graph with a single node. */
+            hr = ID2D1TransformGraph_SetPassthroughGraph(graph, 0);
+            ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+            hr = ID2D1TransformGraph_SetSingleTransformNode(graph, node);
+            ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+            hr = ID2D1TransformGraph_SetOutputNode(graph, node2);
+            ok(hr == HRESULT_FROM_WIN32(ERROR_NOT_FOUND), "Got unexpected hr %#lx.\n", hr);
+            break;
+
+        case 5:
+            /* Removing the output node does not affect a passthrough. */
+            hr = ID2D1TransformGraph_SetPassthroughGraph(graph, 0);
+            ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+            hr = ID2D1TransformGraph_RemoveNode(graph, node);
+            ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+            hr = ID2D1TransformGraph_RemoveNode(graph, node);
+            ok(hr == HRESULT_FROM_WIN32(ERROR_NOT_FOUND), "Got unexpected hr %#lx.\n", hr);
+            break;
+
+        case 7:
+            /* A bounds adjustment transform replaces the bounds of its input
+             * and leaves the pixels inside them as they are. */
+            hr = ID2D1EffectContext_CreateBoundsAdjustmentTransform(effect_impl->effect_context,
+                    &bounds, &bounds_transform);
+            ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+            hr = ID2D1TransformGraph_SetSingleTransformNode(graph, (ID2D1TransformNode *)bounds_transform);
+            ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+            ID2D1BoundsAdjustmentTransform_Release(bounds_transform);
+            break;
+
+        case 6:
+            /* Clear() removes the nodes. */
+            hr = ID2D1TransformGraph_AddNode(graph, node);
+            ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+            ID2D1TransformGraph_Clear(graph);
+            hr = ID2D1TransformGraph_SetOutputNode(graph, node);
+            ok(hr == HRESULT_FROM_WIN32(ERROR_NOT_FOUND), "Got unexpected hr %#lx.\n", hr);
+            hr = ID2D1TransformGraph_SetPassthroughGraph(graph, 0);
+            ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+            break;
+    }
+
+    return S_OK;
+}
+
+static const ID2D1EffectImplVtbl graph_step_effect_impl_vtbl =
+{
+    effect_impl_QueryInterface,
+    effect_impl_AddRef,
+    effect_impl_Release,
+    regraph_effect_impl_Initialize,
+    graph_step_effect_impl_PrepareForRender,
+    effect_impl_SetGraph,
+};
