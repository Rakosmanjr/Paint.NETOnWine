+static HRESULT STDMETHODCALLTYPE mapping_effect_SetGraph(ID2D1EffectImpl *iface, ID2D1TransformGraph *graph)
+{
+    return E_NOTIMPL;
+}
+
+static const ID2D1EffectImplVtbl mapping_effect_vtbl =
+{
+    mapping_effect_QueryInterface,
+    mapping_effect_AddRef,
+    mapping_effect_Release,
+    mapping_effect_Initialize,
+    mapping_effect_PrepareForRender,
+    mapping_effect_SetGraph,
+};
