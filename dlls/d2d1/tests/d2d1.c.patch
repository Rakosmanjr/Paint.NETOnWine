+/* Feeds a 1x1 premultiplied float input to "first", draws the output of
+ * "last" and reads the result back from a target of the given format. */
+static HRESULT render_effect_pixel(ID2D1DeviceContext *context, ID2D1Effect *first, ID2D1Effect *last,
+        const float *in, DXGI_FORMAT target_format, float *out)
+{
+    D2D1_BITMAP_PROPERTIES1 desc = {{0}};
+    ID2D1Bitmap1 *input, *target, *readback;
+    D2D1_SIZE_U size = {1, 1};
+    ID2D1Image *prev, *output;
+    D2D1_MAPPED_RECT map;
+    HRESULT hr, draw_hr;
+
+    memset(out, 0, 4 * sizeof(*out));
+    desc.pixelFormat.format = DXGI_FORMAT_R32G32B32A32_FLOAT;
+    desc.pixelFormat.alphaMode = D2D1_ALPHA_MODE_PREMULTIPLIED;
+    desc.dpiX = desc.dpiY = 96.0f;
+    hr = ID2D1DeviceContext_CreateBitmap(context, size, in, 4 * sizeof(*in), &desc, &input);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    desc.pixelFormat.format = target_format;
+    desc.bitmapOptions = D2D1_BITMAP_OPTIONS_TARGET;
+    hr = ID2D1DeviceContext_CreateBitmap(context, size, NULL, 0, &desc, &target);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    desc.bitmapOptions = D2D1_BITMAP_OPTIONS_CPU_READ | D2D1_BITMAP_OPTIONS_CANNOT_DRAW;
+    hr = ID2D1DeviceContext_CreateBitmap(context, size, NULL, 0, &desc, &readback);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    ID2D1Effect_SetInput(first, 0, (ID2D1Image *)input, FALSE);
+    ID2D1Effect_GetOutput(last, &output);
+    ID2D1DeviceContext_GetTarget(context, &prev);
+    ID2D1DeviceContext_SetTarget(context, (ID2D1Image *)target);
+    ID2D1DeviceContext_BeginDraw(context);
+    ID2D1DeviceContext_Clear(context, NULL);
+    ID2D1DeviceContext_DrawImage(context, output, NULL, NULL, 0, D2D1_COMPOSITE_MODE_SOURCE_COPY);
+    draw_hr = ID2D1DeviceContext_EndDraw(context, NULL, NULL);
+    ID2D1DeviceContext_SetTarget(context, prev);
+    if (prev)
+        ID2D1Image_Release(prev);
+    ID2D1Image_Release(output);
+
+    hr = ID2D1Bitmap1_CopyFromBitmap(readback, NULL, (ID2D1Bitmap *)target, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1Bitmap1_Map(readback, D2D1_MAP_OPTIONS_READ, &map);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        if (target_format == DXGI_FORMAT_R32G32B32A32_FLOAT)
+        {
+            memcpy(out, map.bits, 4 * sizeof(*out));
+        }
+        else
+        {
+            out[0] = map.bits[2] / 255.0f;
+            out[1] = map.bits[1] / 255.0f;
+            out[2] = map.bits[0] / 255.0f;
+            out[3] = map.bits[3] / 255.0f;
+        }
+        ID2D1Bitmap1_Unmap(readback);
+    }
+    ID2D1Bitmap1_Release(readback);
+    ID2D1Bitmap1_Release(target);
+    ID2D1Bitmap1_Release(input);
+    return draw_hr;
+}
