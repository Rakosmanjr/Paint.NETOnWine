+static void test_layer_geometric_mask(BOOL d3d11)
+{
+    ID2D1RectangleGeometry *geometry;
+    D2D1_LAYER_PARAMETERS layer_desc;
+    struct d2d1_test_context ctx;
+    ID2D1SolidColorBrush *brush;
+    struct resource_readback rb;
+    ID2D1RenderTarget *rt;
+    D2D1_COLOR_F colour_f;
+    ID2D1Factory *factory;
+    ID2D1Layer *layer;
+    D2D1_RECT_F rect;
+    DWORD colour;
+    HRESULT hr;
+
+    if (!init_test_context(&ctx, d3d11))
+        return;
+    rt = ctx.rt;
+    factory = ctx.factory;
+
+    set_rect(&rect, 100.0f, 100.0f, 200.0f, 200.0f);
+    hr = ID2D1Factory_CreateRectangleGeometry(factory, &rect, &geometry);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1RenderTarget_CreateLayer(rt, NULL, &layer);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    set_color(&colour_f, 1.0f, 0.0f, 0.0f, 1.0f);
+    hr = ID2D1RenderTarget_CreateSolidColorBrush(rt, &colour_f, NULL, &brush);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    ID2D1RenderTarget_BeginDraw(rt);
+    set_color(&colour_f, 1.0f, 1.0f, 1.0f, 1.0f);
+    ID2D1RenderTarget_Clear(rt, &colour_f);
+
+    /* "The geometric mask specifies the area of the layer that is composited
+     * into the render target." The mask transform is applied to it. */
+    set_rect(&layer_desc.contentBounds, -FLT_MAX, -FLT_MAX, FLT_MAX, FLT_MAX);
+    layer_desc.geometricMask = (ID2D1Geometry *)geometry;
+    layer_desc.maskAntialiasMode = D2D1_ANTIALIAS_MODE_ALIASED;
+    set_matrix_identity(&layer_desc.maskTransform);
+    layer_desc.opacity = 1.0f;
+    layer_desc.opacityBrush = NULL;
+    layer_desc.layerOptions = D2D1_LAYER_OPTIONS_NONE;
+    ID2D1RenderTarget_PushLayer(rt, &layer_desc, layer);
+
+    set_rect(&rect, 0.0f, 0.0f, 640.0f, 480.0f);
+    ID2D1RenderTarget_FillRectangle(rt, &rect, (ID2D1Brush *)brush);
+
+    ID2D1RenderTarget_PopLayer(rt);
+
+    /* "A value that specifies the transform that is applied to the geometric
+     * mask when composing the layer." */
+    set_matrix_identity(&layer_desc.maskTransform);
+    translate_matrix(&layer_desc.maskTransform, 200.0f, 0.0f);
+    ID2D1RenderTarget_PushLayer(rt, &layer_desc, layer);
+    set_rect(&rect, 0.0f, 0.0f, 640.0f, 480.0f);
+    ID2D1RenderTarget_FillRectangle(rt, &rect, (ID2D1Brush *)brush);
+    ID2D1RenderTarget_PopLayer(rt);
+
+    hr = ID2D1RenderTarget_EndDraw(rt, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    get_surface_readback(&ctx, &rb);
+    colour = get_readback_colour(&rb, 150, 150);
+    ok(compare_colour(colour, 0xffff0000, 1), "Got unexpected colour 0x%08lx inside mask.\n", colour);
+    colour = get_readback_colour(&rb, 250, 250);
+    ok(compare_colour(colour, 0xffffffff, 1), "Got unexpected colour 0x%08lx outside mask.\n", colour);
+    /* The second layer's mask is the same geometry moved right by 200. */
+    colour = get_readback_colour(&rb, 350, 150);
+    ok(compare_colour(colour, 0xffff0000, 1), "Got unexpected colour 0x%08lx inside moved mask.\n", colour);
+    colour = get_readback_colour(&rb, 450, 150);
+    ok(compare_colour(colour, 0xffffffff, 1), "Got unexpected colour 0x%08lx outside moved mask.\n", colour);
+    release_resource_readback(&rb);
+
+    ID2D1SolidColorBrush_Release(brush);
+    ID2D1Layer_Release(layer);
+    ID2D1RectangleGeometry_Release(geometry);
+    release_test_context(&ctx);
+}
