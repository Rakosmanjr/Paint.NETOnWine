+static void icc_put32(BYTE *p, DWORD v) { p[0] = v >> 24; p[1] = v >> 16; p[2] = v >> 8; p[3] = v; }
+static void icc_put16(BYTE *p, WORD v) { p[0] = v >> 8; p[1] = v; }
+static DWORD icc_s15(float v) { return (DWORD)(INT32)floorf(v * 65536.0f + 0.5f); }
+
+/* Builds an RGB display profile from primaries (XYZ, D50-adapted) and one
+ * tone curve shared by all three channels: a "curv" with "count" entries,
+ * or a "para" of type para_type with the given parameters. */
+static UINT32 build_icc_profile(BYTE *buf, const float xyz[3][3], int count, const WORD *curve,
+        int para_type, const float *params)
+{
+    static const unsigned int para_counts[] = {1, 3, 4, 5, 7};
+    static const char *xyz_tags[] = {"rXYZ", "gXYZ", "bXYZ"};
+    static const char *trc_tags[] = {"rTRC", "gTRC", "bTRC"};
+    UINT32 off, trc_off, trc_len, i, j, n = 7;
+    BYTE *t;
+
+    memset(buf, 0, 2048);
+    icc_put32(buf + 8, 0x02100000);
+    memcpy(buf + 12, "mntrRGB XYZ ", 12);
+    memcpy(buf + 36, "acsp", 4);
+    icc_put32(buf + 68, icc_s15(0.9642f));
+    icc_put32(buf + 72, icc_s15(1.0f));
+    icc_put32(buf + 76, icc_s15(0.8249f));
+    icc_put32(buf + 128, n);
+    off = 128 + 4 + 12 * n;
+
+    t = buf + 132;
+    memcpy(t, "wtpt", 4);
+    icc_put32(t + 4, off);
+    icc_put32(t + 8, 20);
+    memcpy(buf + off, "XYZ ", 4);
+    icc_put32(buf + off + 8, icc_s15(0.9642f));
+    icc_put32(buf + off + 12, icc_s15(1.0f));
+    icc_put32(buf + off + 16, icc_s15(0.8249f));
+    off += 20;
+    for (i = 0; i < 3; ++i)
+    {
+        t = buf + 132 + 12 * (1 + i);
+        memcpy(t, xyz_tags[i], 4);
+        icc_put32(t + 4, off);
+        icc_put32(t + 8, 20);
+        memcpy(buf + off, "XYZ ", 4);
+        for (j = 0; j < 3; ++j)
+            icc_put32(buf + off + 8 + 4 * j, icc_s15(xyz[i][j]));
+        off += 20;
+    }
+
+    trc_off = off;
+    if (para_type >= 0)
+    {
+        memcpy(buf + off, "para", 4);
+        icc_put16(buf + off + 8, para_type);
+        for (j = 0; j < para_counts[para_type]; ++j)
+            icc_put32(buf + off + 12 + 4 * j, icc_s15(params[j]));
+        trc_len = 12 + 4 * para_counts[para_type];
+    }
+    else
+    {
+        memcpy(buf + off, "curv", 4);
+        icc_put32(buf + off + 8, count);
+        for (j = 0; j < count; ++j)
+            icc_put16(buf + off + 12 + 2 * j, curve[j]);
+        trc_len = 12 + 2 * count;
+    }
+    off += (trc_len + 3) & ~3;
+    for (i = 0; i < 3; ++i)
+    {
+        t = buf + 132 + 12 * (4 + i);
+        memcpy(t, trc_tags[i], 4);
+        icc_put32(t + 4, trc_off);
+        icc_put32(t + 8, trc_len);
+    }
+    icc_put32(buf, off);
+    return off;
+}
