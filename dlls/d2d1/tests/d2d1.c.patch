+/* An effect that changes its graph from PrepareForRender(), which is where
+ * D2D has an effect "reevaluate any transform graph changes". */
+static HRESULT STDMETHODCALLTYPE regraph_effect_impl_Initialize(ID2D1EffectImpl *iface,
+        ID2D1EffectContext *context, ID2D1TransformGraph *graph)
+{
+    struct effect_impl *effect_impl = impl_from_ID2D1EffectImpl(iface);
+
+    ID2D1EffectContext_AddRef(effect_impl->effect_context = context);
+    ID2D1TransformGraph_AddRef(effect_impl->transform_graph = graph);
+
+    return ID2D1TransformGraph_SetPassthroughGraph(graph, 0);
+}
+
+static HRESULT STDMETHODCALLTYPE regraph_effect_impl_PrepareForRender(ID2D1EffectImpl *iface,
+        D2D1_CHANGE_TYPE type)
+{
+    struct effect_impl *effect_impl = impl_from_ID2D1EffectImpl(iface);
+
+    if (!effect_impl->transform_graph)
+        return E_FAIL;
+
+    return ID2D1TransformGraph_SetPassthroughGraph(effect_impl->transform_graph, 1);
+}
+
+static const ID2D1EffectImplVtbl regraph_effect_impl_vtbl =
+{
+    effect_impl_QueryInterface,
+    effect_impl_AddRef,
+    effect_impl_Release,
+    regraph_effect_impl_Initialize,
+    regraph_effect_impl_PrepareForRender,
+    effect_impl_SetGraph,
+};
