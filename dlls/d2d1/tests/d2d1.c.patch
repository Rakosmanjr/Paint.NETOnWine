+struct coverage_polygon
+{
+    const D2D1_POINT_2F *points;
+    unsigned int count;
+};
+
+enum coverage_rule
+{
+    COVERAGE_RULE_NONZERO,
+    COVERAGE_RULE_EVEN_ODD,
+    COVERAGE_RULE_UNION,
+};
+
+/* Vertices are snapped up to the next 1/16 pixel before rasterization;
+ * coordinates are kept in sixteenths so that the sample tests are exact. */
+static LONGLONG coverage_snap(float v)
+{
+    return ceilf(v * 16.0f);
+}
+
+/* Winding number of the sample (x, y), in sixteenths, with respect to a
+ * closed polygon. Edges are half-open in y, so a sample level with a vertex
+ * is counted once. */
+static int coverage_polygon_winding(const struct coverage_polygon *polygon, LONGLONG x, LONGLONG y)
+{
+    int winding = 0;
+    unsigned int i;
+
+    for (i = 0; i < polygon->count; ++i)
+    {
+        const D2D1_POINT_2F *a = &polygon->points[i];
+        const D2D1_POINT_2F *b = &polygon->points[(i + 1) % polygon->count];
+        LONGLONG ax = coverage_snap(a->x), ay = coverage_snap(a->y);
+        LONGLONG bx = coverage_snap(b->x), by = coverage_snap(b->y);
+        LONGLONG num, den;
+
+        if ((ay <= y) == (by <= y))
+            continue;
+        /* x < ax + (y - ay) * (bx - ax) / (by - ay) */
+        den = by - ay;
+        num = ax * den + (y - ay) * (bx - ax);
+        if (den < 0)
+        {
+            den = -den;
+            num = -num;
+        }
+        if (x * den < num)
+            winding += by > ay ? 1 : -1;
+    }
+
+    return winding;
+}
+
+/* Antialiased coverage is the number of samples on an 8x8 grid within the
+ * pixel that fall inside the shape. */
+static unsigned int coverage_sample_count(const struct coverage_polygon *polygons, unsigned int polygon_count,
+        enum coverage_rule rule, unsigned int x, unsigned int y)
+{
+    unsigned int i, j, k, count = 0;
+
+    for (j = 0; j < 8; ++j)
+    {
+        for (i = 0; i < 8; ++i)
+        {
+            LONGLONG sx = x * 16 + 2 * i + 1, sy = y * 16 + 2 * j + 1;
+            BOOL inside = FALSE;
+            int winding = 0;
+
+            for (k = 0; k < polygon_count; ++k)
+            {
+                int w = coverage_polygon_winding(&polygons[k], sx, sy);
+
+                if (rule == COVERAGE_RULE_UNION)
+                    inside = inside || (w & 1);
+                else
+                    winding += w;
+            }
+            if (rule == COVERAGE_RULE_NONZERO)
+                inside = !!winding;
+            else if (rule == COVERAGE_RULE_EVEN_ODD)
+                inside = winding & 1;
+            if (inside)
+                ++count;
+        }
+    }
+
+    return count;
+}
+
+static unsigned int coverage_alpha(unsigned int sample_count)
+{
+    return (sample_count * 255 + 32) / 64;
+}
+
+/* An antialiased clip scales the pixel by its own coverage of it. */
+static unsigned int coverage_clip_alpha(unsigned int alpha, const D2D1_RECT_F *clip, unsigned int x, unsigned int y)
+{
+    D2D1_POINT_2F points[4];
+    struct coverage_polygon polygon = {points, 4};
+
+    set_point(&points[0], clip->left, clip->top);
+    set_point(&points[1], clip->right, clip->top);
+    set_point(&points[2], clip->right, clip->bottom);
+    set_point(&points[3], clip->left, clip->bottom);
+
+    return alpha * coverage_sample_count(&polygon, 1, COVERAGE_RULE_NONZERO, x, y) / 64;
+}
+
+static void coverage_rect_polygon(D2D1_POINT_2F *points, const D2D1_RECT_F *rect)
+{
+    set_point(&points[0], rect->left, rect->top);
+    set_point(&points[1], rect->right, rect->top);
+    set_point(&points[2], rect->right, rect->bottom);
+    set_point(&points[3], rect->left, rect->bottom);
+}
+
+/* A stroked line of the given width, with flat caps. */
+static void coverage_line_polygon(D2D1_POINT_2F *points, D2D1_POINT_2F p0, D2D1_POINT_2F p1, float width)
+{
+    float dx = p1.x - p0.x, dy = p1.y - p0.y, l = sqrtf(dx * dx + dy * dy);
+    float nx = -dy / l * width * 0.5f, ny = dx / l * width * 0.5f;
+
+    set_point(&points[0], p0.x + nx, p0.y + ny);
+    set_point(&points[1], p1.x + nx, p1.y + ny);
+    set_point(&points[2], p1.x - nx, p1.y - ny);
+    set_point(&points[3], p0.x - nx, p0.y - ny);
+}
+
+/* Curves are flattened by halving a Bézier until its control points are
+ * within the flattening tolerance of being evenly spaced on a line. */
+static unsigned int coverage_flatten_cubic(D2D1_POINT_2F *points, unsigned int count,
+        D2D1_POINT_2F p0, D2D1_POINT_2F p1, D2D1_POINT_2F p2, D2D1_POINT_2F p3)
+{
+    D2D1_POINT_2F q01, q12, q23, q012, q123, q;
+    float d;
+
+    d = fabsf(p1.x - (p0.x + p2.x) / 2.0f) + fabsf(p1.y - (p0.y + p2.y) / 2.0f)
+            + fabsf(p2.x - (p1.x + p3.x) / 2.0f) + fabsf(p2.y - (p1.y + p3.y) / 2.0f);
+    if (d < 0.25f)
+    {
+        points[count++] = p3;
+        return count;
+    }
+
+    set_point(&q01, (p0.x + p1.x) / 2.0f, (p0.y + p1.y) / 2.0f);
+    set_point(&q12, (p1.x + p2.x) / 2.0f, (p1.y + p2.y) / 2.0f);
+    set_point(&q23, (p2.x + p3.x) / 2.0f, (p2.y + p3.y) / 2.0f);
+    set_point(&q012, (q01.x + q12.x) / 2.0f, (q01.y + q12.y) / 2.0f);
+    set_point(&q123, (q12.x + q23.x) / 2.0f, (q12.y + q23.y) / 2.0f);
+    set_point(&q, (q012.x + q123.x) / 2.0f, (q012.y + q123.y) / 2.0f);
+    count = coverage_flatten_cubic(points, count, p0, q01, q012, q);
+    return coverage_flatten_cubic(points, count, q, q123, q23, p3);
+}
+
+/* A circle as four quarter-turn Béziers, flattened. */
+#define COVERAGE_CIRCLE_POINTS 256
+static unsigned int coverage_circle_polygon(D2D1_POINT_2F *points, float cx, float cy, float r)
+{
+    static const float k = 0.5522848f;
+    D2D1_POINT_2F p0, p1, p2, p3;
+    unsigned int i, count = 0;
+
+    for (i = 0; i < 4; ++i)
+    {
+        float a0 = i * M_PI / 2.0f, a1 = (i + 1) * M_PI / 2.0f;
+
+        set_point(&p0, cx + r * cosf(a0), cy + r * sinf(a0));
+        set_point(&p1, cx + r * (cosf(a0) - k * sinf(a0)), cy + r * (sinf(a0) + k * cosf(a0)));
+        set_point(&p2, cx + r * (cosf(a1) + k * sinf(a1)), cy + r * (sinf(a1) - k * cosf(a1)));
+        set_point(&p3, cx + r * cosf(a1), cy + r * sinf(a1));
+        count = coverage_flatten_cubic(points, count, p0, p1, p2, p3);
+    }
+
+    return count;
+}
+
+#define check_coverage(a, b, c, d, e, f, g, h, i) check_coverage_(__LINE__, a, b, c, d, e, f, g, h, i)
+static void check_coverage_(unsigned int line, const DWORD *pixels, unsigned int pitch,
+        unsigned int w, unsigned int h, const struct coverage_polygon *polygons, unsigned int polygon_count,
+        enum coverage_rule rule, const D2D1_RECT_F *clip, unsigned int max_diff)
+{
+    unsigned int x, y, count, expected, alpha, diff, failures = 0;
+    DWORD pixel;
+
+    for (y = 0; y < h; ++y)
+    {
+        for (x = 0; x < w; ++x)
+        {
+            count = coverage_sample_count(polygons, polygon_count, rule, x, y);
+            expected = coverage_alpha(count);
+            if (clip)
+                expected = coverage_clip_alpha(expected, clip, x, y);
+            pixel = pixels[y * pitch + x];
+            alpha = pixel >> 24;
+            diff = alpha > expected ? alpha - expected : expected - alpha;
+            /* The brush is white, so every channel carries the coverage. */
+            if (diff > max_diff || pixel != alpha * 0x01010101)
+            {
+                if (failures++ < 8)
+                    trace("%u: pixel (%u, %u) is %#lx, expected alpha %u (%u samples).\n",
+                            line, x, y, pixel, expected, count);
+            }
+        }
+    }
+    ok_(__FILE__, line)(!failures, "%u pixels differ from the expected coverage.\n", failures);
+}
+
+static void read_coverage(struct d2d1_test_context *ctx, DWORD *pixels, unsigned int w, unsigned int h)
+{
+    struct resource_readback rb;
+    unsigned int x, y;
+
+    get_surface_readback(ctx, &rb);
+    for (y = 0; y < h; ++y)
+        for (x = 0; x < w; ++x)
+            pixels[y * w + x] = get_readback_colour(&rb, x, y);
+    release_resource_readback(&rb);
+}
