+static void test_layer_errors(BOOL d3d11)
+{
+    D2D1_LAYER_PARAMETERS layer_desc;
+    struct d2d1_test_context ctx;
+    ID2D1RenderTarget *rt;
+    ID2D1Layer *layer;
+    HRESULT hr;
+
+    if (!init_test_context(&ctx, d3d11))
+        return;
+    rt = ctx.rt;
+
+    hr = ID2D1RenderTarget_CreateLayer(rt, NULL, &layer);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    set_rect(&layer_desc.contentBounds, -FLT_MAX, -FLT_MAX, FLT_MAX, FLT_MAX);
+    layer_desc.geometricMask = NULL;
+    layer_desc.maskAntialiasMode = D2D1_ANTIALIAS_MODE_ALIASED;
+    set_matrix_identity(&layer_desc.maskTransform);
+    layer_desc.opacity = 1.0f;
+    layer_desc.opacityBrush = NULL;
+    layer_desc.layerOptions = D2D1_LAYER_OPTIONS_NONE;
+
+    /* "If Flush is called before all outstanding layers are popped, the
+     * render target is placed into an error state, and an error is
+     * returned." */
+    ID2D1RenderTarget_BeginDraw(rt);
+    ID2D1RenderTarget_PushLayer(rt, &layer_desc, layer);
+    hr = ID2D1RenderTarget_Flush(rt, NULL, NULL);
+    ok(FAILED(hr), "Got unexpected hr %#lx flushing with a layer pushed.\n", hr);
+    ID2D1RenderTarget_PopLayer(rt);
+    hr = ID2D1RenderTarget_EndDraw(rt, NULL, NULL);
+    ok(FAILED(hr), "Got unexpected hr %#lx.\n", hr);
+
+    /* "The error state can be cleared by a call to EndDraw." */
+    ID2D1RenderTarget_BeginDraw(rt);
+    hr = ID2D1RenderTarget_EndDraw(rt, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx after clearing the error state.\n", hr);
+
+    /* "You must call the PopLayer method before you call the EndDraw
+     * method." */
+    ID2D1RenderTarget_BeginDraw(rt);
+    ID2D1RenderTarget_PushLayer(rt, &layer_desc, layer);
+    hr = ID2D1RenderTarget_EndDraw(rt, NULL, NULL);
+    ok(FAILED(hr), "Got unexpected hr %#lx ending a draw with a layer pushed.\n", hr);
+
+    /* "If there are more PopLayer calls than PushLayer calls, the render
+     * target is placed into an error state." */
+    ID2D1RenderTarget_BeginDraw(rt);
+    ID2D1RenderTarget_PopLayer(rt);
+    hr = ID2D1RenderTarget_EndDraw(rt, NULL, NULL);
+    ok(FAILED(hr), "Got unexpected hr %#lx popping a layer that was not pushed.\n", hr);
+
+    /* "A particular ID2D1Layer resource can be active only at one time." */
+    ID2D1RenderTarget_BeginDraw(rt);
+    ID2D1RenderTarget_PushLayer(rt, &layer_desc, layer);
+    ID2D1RenderTarget_PushLayer(rt, &layer_desc, layer);
+    ID2D1RenderTarget_PopLayer(rt);
+    ID2D1RenderTarget_PopLayer(rt);
+    hr = ID2D1RenderTarget_EndDraw(rt, NULL, NULL);
+    ok(FAILED(hr), "Got unexpected hr %#lx pushing one layer twice.\n", hr);
+
+    ID2D1Layer_Release(layer);
+    release_test_context(&ctx);
+}
