+static HRESULT STDMETHODCALLTYPE mapping_effect_PrepareForRender(ID2D1EffectImpl *iface, D2D1_CHANGE_TYPE type)
+{
+    mapping_log_append("P%u;", type);
+    return S_OK;
+}
