+static void test_effect_input_bounds(BOOL d3d11)
+{
+    static const WCHAR *description =
+        L"<?xml version='1.0'?>                                                       \
+            <Effect>                                                                  \
+                <Property name='DisplayName' type='string' value='Bounds'/>           \
+                <Property name='Author'      type='string' value='The Wine Project'/> \
+                <Property name='Category'    type='string' value='Test'/>             \
+                <Property name='Description' type='string' value='Test effect.'/>     \
+                <Inputs>                                                              \
+                    <Input name='Source'/>                                            \
+                </Inputs>                                                             \
+            </Effect>                                                                 \
+        ";
+
+    /* Passes the sampled input straight through, so that what the sampler
+     * returns outside the input image is what lands in the target. */
+    static const char ps_code[] =
+        "Texture2D InputTexture : register(t0);\n"
+        "SamplerState InputSampler : register(s0);\n"
+        "\n"
+        "float4 main(float4 clip : SV_POSITION, float4 scene : SCENE_POSITION,\n"
+        "        float4 uv : TEXCOORD0) : SV_TARGET\n"
+        "{\n"
+        "    return InputTexture.Sample(InputSampler, uv.xy);\n"
+        "}";
+    static const DWORD input_pixels[] =
+    {
+        0xffffffff, 0xffffffff, 0xffffffff, 0xffffffff,
+        0xffffffff, 0xffffffff, 0xffffffff, 0xffffffff,
+        0xffffffff, 0xffffffff, 0xffffffff, 0xffffffff,
+        0xffffffff, 0xffffffff, 0xffffffff, 0xffffffff,
+    };
+
+    D2D1_BITMAP_PROPERTIES1 bitmap_desc;
+    struct d2d1_test_context ctx;
+    struct resource_readback rb;
+    ID2D1DeviceContext *context;
+    ID2D1Factory1 *factory;
+    ID2D1Bitmap1 *bitmap;
+    ID2D1Effect *effect;
+    ID2D1Image *output;
+    D2D1_SIZE_U size;
+    D2D1_RECT_F bounds;
+    DWORD colour;
+    HRESULT hr;
+
+    if (!init_test_context(&ctx, d3d11))
+        return;
+
+    context = ctx.context;
+    if (!(factory = ctx.factory1))
+    {
+        win_skip("ID2D1Factory1 is not supported.\n");
+        release_test_context(&ctx);
+        return;
+    }
+
+    preload_shader("ps_4_0", ps_code, &GUID_TestSampleShader, &ctx);
+
+    hr = ID2D1Factory1_RegisterEffectFromString(factory, &CLSID_TestEffect, description,
+            NULL, 0, expand_effect_impl_create);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    hr = ID2D1DeviceContext_CreateEffect(context, &CLSID_TestEffect, &effect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    set_size_u(&size, 4, 4);
+    bitmap_desc.pixelFormat.format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    bitmap_desc.pixelFormat.alphaMode = D2D1_ALPHA_MODE_PREMULTIPLIED;
+    bitmap_desc.dpiX = 96.0f;
+    bitmap_desc.dpiY = 96.0f;
+    bitmap_desc.bitmapOptions = D2D1_BITMAP_OPTIONS_NONE;
+    bitmap_desc.colorContext = NULL;
+    hr = ID2D1DeviceContext_CreateBitmap(context, size, input_pixels,
+            4 * sizeof(*input_pixels), &bitmap_desc, &bitmap);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    ID2D1Effect_SetInput(effect, 0, (ID2D1Image *)bitmap, FALSE);
+    ID2D1Effect_GetOutput(effect, &output);
+
+    /* The transform enlarges its output, so the effect covers more than its
+     * input does. */
+    hr = ID2D1DeviceContext_GetImageLocalBounds(context, output, &bounds);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(compare_rect(&bounds, -8.0f, -8.0f, 12.0f, 12.0f, 0),
+            "Got unexpected bounds {%.8e, %.8e, %.8e, %.8e}.\n",
+            bounds.left, bounds.top, bounds.right, bounds.bottom);
+
+    ID2D1DeviceContext_BeginDraw(context);
+    ID2D1DeviceContext_Clear(context, NULL);
+    ID2D1DeviceContext_DrawImage(context, output, NULL, NULL, 0, 0);
+    hr = ID2D1DeviceContext_EndDraw(context, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    get_surface_readback(&ctx, &rb);
+    /* Where the input image exists, the shader samples it. */
+    colour = get_readback_colour(&rb, 1, 1);
+    ok(compare_colour(colour, 0xffffffff, 1),
+            "Got unexpected colour 0x%08lx inside the input.\n", colour);
+    colour = get_readback_colour(&rb, 2, 2);
+    ok(compare_colour(colour, 0xffffffff, 1),
+            "Got unexpected colour 0x%08lx inside the input.\n", colour);
+    /* "Direct2D automatically samples transparent black pixels where the
+     * input image doesn't exist." */
+    colour = get_readback_colour(&rb, 6, 6);
+    ok(compare_colour(colour, 0x00000000, 1),
+            "Got unexpected colour 0x%08lx outside the input.\n", colour);
+    colour = get_readback_colour(&rb, 9, 9);
+    ok(compare_colour(colour, 0x00000000, 1),
+            "Got unexpected colour 0x%08lx outside the input.\n", colour);
+    release_resource_readback(&rb);
+
+    ID2D1Image_Release(output);
+    ID2D1Bitmap1_Release(bitmap);
+    ID2D1Effect_Release(effect);
+    hr = ID2D1Factory1_UnregisterEffect(factory, &CLSID_TestEffect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    release_test_context(&ctx);
+}
