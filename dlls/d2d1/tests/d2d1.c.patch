+static void test_transform_graph_passthrough(BOOL d3d11)
+{
+    static const struct
+    {
+        const char *result;
+        D2D1_RECT_F bounds;
+    }
+    steps[] =
+    {
+        {"passthrough", {0.0f, 0.0f, 16.0f, 16.0f}},
+        {"passthrough", {0.0f, 0.0f, 16.0f, 16.0f}},
+        {"offset",      {10.0f, 0.0f, 26.0f, 16.0f}},
+        {"offset",      {10.0f, 0.0f, 26.0f, 16.0f}},
+        {"passthrough", {0.0f, 0.0f, 16.0f, 16.0f}},
+        {"passthrough", {0.0f, 0.0f, 16.0f, 16.0f}},
+        {"passthrough", {2.0f, 3.0f, 8.0f, 40.0f}},
+    };
+    D2D1_BITMAP_PROPERTIES1 bitmap_desc;
+    struct d2d1_test_context ctx;
+    D2D1_RECT_F bounds;
+    ID2D1Factory1 *factory;
+    DWORD pixels[16 * 16];
+    ID2D1Image *output;
+    ID2D1Bitmap1 *bitmap;
+    ID2D1Effect *effect;
+    const char *result;
+    D2D1_SIZE_U size;
+    unsigned int i;
+    HRESULT hr;
+
+    const D2D1_PROPERTY_BINDING binding[] =
+    {
+        {L"Integer", effect_impl_set_integer, effect_impl_get_integer},
+    };
+
+    if (!init_test_context(&ctx, d3d11))
+        return;
+
+    if (!(factory = ctx.factory1))
+    {
+        win_skip("ID2D1Factory1 is not supported.\n");
+        release_test_context(&ctx);
+        return;
+    }
+
+    hr = ID2D1Factory1_RegisterEffectFromString(factory, &CLSID_TestEffect,
+            effect_xml_c, binding, ARRAY_SIZE(binding), graph_step_effect_impl_create);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1DeviceContext_CreateEffect(ctx.context, &CLSID_TestEffect, &effect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    for (i = 0; i < ARRAY_SIZE(pixels); ++i)
+        pixels[i] = 0xffff0000;
+    set_size_u(&size, 16, 16);
+    bitmap_desc.pixelFormat.format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    bitmap_desc.pixelFormat.alphaMode = D2D1_ALPHA_MODE_PREMULTIPLIED;
+    bitmap_desc.dpiX = 96.0f;
+    bitmap_desc.dpiY = 96.0f;
+    bitmap_desc.bitmapOptions = D2D1_BITMAP_OPTIONS_NONE;
+    bitmap_desc.colorContext = NULL;
+    hr = ID2D1DeviceContext_CreateBitmap(ctx.context, size, pixels, sizeof(*pixels) * 16, &bitmap_desc, &bitmap);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1Effect_SetInput(effect, 0, (ID2D1Image *)bitmap, FALSE);
+
+    for (i = 0; i < ARRAY_SIZE(steps); ++i)
+    {
+        UINT step = i + 1;
+
+        winetest_push_context("Step %u", step);
+        hr = ID2D1Effect_SetValueByName(effect, L"Integer", D2D1_PROPERTY_TYPE_UINT32,
+                (const BYTE *)&step, sizeof(step));
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        result = draw_passthrough_or_offset(&ctx, effect);
+        ok(!strcmp(result, steps[i].result), "Got unexpected result %s.\n", result);
+
+        ID2D1Effect_GetOutput(effect, &output);
+        hr = ID2D1DeviceContext_GetImageLocalBounds(ctx.context, output, &bounds);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        ok(compare_rect(&bounds, steps[i].bounds.left, steps[i].bounds.top,
+                steps[i].bounds.right, steps[i].bounds.bottom, 0),
+                "Got unexpected bounds {%.8e, %.8e, %.8e, %.8e}.\n",
+                bounds.left, bounds.top, bounds.right, bounds.bottom);
+        ID2D1Image_Release(output);
+        winetest_pop_context();
+    }
+
+    ID2D1Bitmap1_Release(bitmap);
+    ID2D1Effect_Release(effect);
+    hr = ID2D1Factory1_UnregisterEffect(factory, &CLSID_TestEffect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    release_test_context(&ctx);
+}
