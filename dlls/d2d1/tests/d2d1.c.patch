+    steps[] =
+    {
+        {"passthrough", {0.0f, 0.0f, 16.0f, 16.0f}},
+        {"passthrough", {0.0f, 0.0f, 16.0f, 16.0f}},
+        {"offset",      {10.0f, 0.0f, 26.0f, 16.0f}},
