+static struct rect_sink *impl_from_ID2D1CommandSink(ID2D1CommandSink *iface)
+{
+    return CONTAINING_RECORD(iface, struct rect_sink, ID2D1CommandSink_iface);
+}
+
+static void many_commands_rect(unsigned int i, D2D1_RECT_F *rect)
+{
+    set_rect(rect, (i % 8) * 4.0f, (i / 8) * 4.0f, (i % 8) * 4.0f + 4.0f, (i / 8) * 4.0f + 4.0f);
+}
