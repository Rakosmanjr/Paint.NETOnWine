+/* An effect that only puts a draw transform in its graph from
+ * PrepareForRender(), and puts it back each time it is asked. */
+static HRESULT STDMETHODCALLTYPE late_draw_effect_impl_Initialize(ID2D1EffectImpl *iface,
+        ID2D1EffectContext *context, ID2D1TransformGraph *graph)
+{
+    struct effect_impl *effect_impl = impl_from_ID2D1EffectImpl(iface);
+
+    ID2D1EffectContext_AddRef(effect_impl->effect_context = context);
+    ID2D1TransformGraph_AddRef(effect_impl->transform_graph = graph);
+
+    return ID2D1TransformGraph_SetPassthroughGraph(graph, 0);
+}
+
+static HRESULT STDMETHODCALLTYPE late_draw_effect_impl_PrepareForRender(ID2D1EffectImpl *iface,
+        D2D1_CHANGE_TYPE type)
+{
+    struct effect_impl *effect_impl = impl_from_ID2D1EffectImpl(iface);
+
+    ++effect_impl->prepare_count;
+    ID2D1TransformGraph_Clear(effect_impl->transform_graph);
+    return ID2D1TransformGraph_SetSingleTransformNode(effect_impl->transform_graph,
+            (ID2D1TransformNode *)&effect_impl->ID2D1DrawTransform_iface);
+}
+
+static const ID2D1EffectImplVtbl late_draw_effect_impl_vtbl =
+{
+    effect_impl_QueryInterface,
+    effect_impl_AddRef,
+    effect_impl_Release,
+    late_draw_effect_impl_Initialize,
+    late_draw_effect_impl_PrepareForRender,
+    effect_impl_SetGraph,
+};
+
+static HRESULT STDMETHODCALLTYPE late_draw_transform_SetDrawInfo(ID2D1DrawTransform *iface,
+        ID2D1DrawInfo *info)
+{
+    struct effect_impl *effect_impl = impl_from_ID2D1DrawTransform(iface);
+
+    ++effect_impl->graph_step;
+    return ID2D1DrawInfo_SetPixelShader(info, &GUID_TestGreenShader, 0);
+}
