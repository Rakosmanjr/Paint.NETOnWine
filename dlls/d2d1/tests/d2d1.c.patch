+    filter_effect_hr[1] = ID2D1DrawInfo_SetInputDescription(info, 0, input_desc);
+    input_desc.filter = *filter_effect_filter;
+    filter_effect_hr[2] = ID2D1DrawInfo_SetInputDescription(info, 0, input_desc);
