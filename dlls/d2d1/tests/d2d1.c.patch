+    {
+        const D2D1_FILTER *filter;
+        DWORD colour;
+    }
+    tests[] =
+    {
+        {NULL,        0xffbf0040},
+        {&point,      0xffff0000},
+        {&linear,     0xffbf0040},
+        {&min_linear, 0xffff0000},
+        {&mag_linear, 0xffbf0040},
+    };
+    static const DWORD pixels[2] = {0xffff0000, 0xff0000ff};
+    D2D1_BITMAP_PROPERTIES1 bitmap_desc;
+    struct d2d1_test_context ctx;
+    struct resource_readback rb;
+    ID2D1DeviceContext *context;
+    ID2D1Factory1 *factory;
+    ID2D1Bitmap1 *bitmap;
+    ID2D1Image *output;
+    ID2D1Effect *effect;
+    D2D1_SIZE_U size;
+    unsigned int i;
+    DWORD colour;
+    HRESULT hr;
+
+    if (!init_test_context(&ctx, d3d11))
