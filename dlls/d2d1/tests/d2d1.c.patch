+static void check_prepare_calls_(unsigned int line, ID2D1Effect *effect, UINT32 count, UINT32 history)
+{
+    UINT32 value;
+    HRESULT hr;
+
+    hr = ID2D1Effect_GetValueByName(effect, L"Count", D2D1_PROPERTY_TYPE_UINT32, (BYTE *)&value, sizeof(value));
+    ok_(__FILE__, line)(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok_(__FILE__, line)(value == count, "Got %u calls, expected %u.\n", value, count);
+    hr = ID2D1Effect_GetValueByName(effect, L"History", D2D1_PROPERTY_TYPE_UINT32, (BYTE *)&value, sizeof(value));
+    ok_(__FILE__, line)(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok_(__FILE__, line)(value == history, "Got history %#x, expected %#x.\n", value, history);
+}
+#define check_prepare_calls(a, b, c) check_prepare_calls_(__LINE__, a, b, c)
+
+static void draw_effect_output(ID2D1DeviceContext *context, ID2D1Effect *effect)
+{
+    ID2D1Image *output;
+    HRESULT hr;
+
+    ID2D1Effect_GetOutput(effect, &output);
+    ID2D1DeviceContext_BeginDraw(context);
+    ID2D1DeviceContext_DrawImage(context, output, NULL, NULL, 0, 0);
+    hr = ID2D1DeviceContext_EndDraw(context, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1Image_Release(output);
+}
