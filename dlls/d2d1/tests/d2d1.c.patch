+#define check_mapping_log(expected) check_mapping_log_(__LINE__, expected)
+static void check_mapping_log_(unsigned int line, const char *expected)
+{
+    ok_(__FILE__, line)(!strcmp(mapping_log, expected), "Got mapping calls \"%s\", expected \"%s\".\n",
+            mapping_log, expected);
+    mapping_log[0] = 0;
+}
