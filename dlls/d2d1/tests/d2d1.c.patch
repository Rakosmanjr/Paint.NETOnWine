+static HRESULT STDMETHODCALLTYPE mapping_effect_create(IUnknown **effect_impl)
+{
+    struct mapping_effect *object;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+
+    object->ID2D1EffectImpl_iface.lpVtbl = &mapping_effect_vtbl;
+    object->refcount = 1;
+    *effect_impl = (IUnknown *)&object->ID2D1EffectImpl_iface;
+    return S_OK;
+}
