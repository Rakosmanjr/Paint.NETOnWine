+static void test_rendering_controls(BOOL d3d11)
+{
+    D2D1_RENDERING_CONTROLS controls, previous;
+    struct d2d1_test_context ctx;
+    ID2D1DeviceContext *context;
+
+    if (!init_test_context(&ctx, d3d11))
+        return;
+
+    if (!(context = ctx.context))
+    {
+        win_skip("ID2D1DeviceContext is not supported.\n");
+        release_test_context(&ctx);
+        return;
+    }
+
+    /* The caller reads these to decide how to divide its own work, so they
+     * have to be written even when nothing has been set. */
+    memset(&previous, 0xcd, sizeof(previous));
+    ID2D1DeviceContext_GetRenderingControls(context, &previous);
+    ok(previous.bufferPrecision != 0xcdcdcdcd, "Buffer precision was not set.\n");
+    ok(previous.tileSize.width != 0xcdcdcdcd && previous.tileSize.width,
+            "Got unexpected tile width %u.\n", previous.tileSize.width);
+    ok(previous.tileSize.height != 0xcdcdcdcd && previous.tileSize.height,
+            "Got unexpected tile height %u.\n", previous.tileSize.height);
+
+    controls.bufferPrecision = D2D1_BUFFER_PRECISION_16BPC_FLOAT;
+    controls.tileSize.width = 64;
+    controls.tileSize.height = 32;
+    ID2D1DeviceContext_SetRenderingControls(context, &controls);
+
+    memset(&controls, 0xcd, sizeof(controls));
+    ID2D1DeviceContext_GetRenderingControls(context, &controls);
+    ok(controls.bufferPrecision == D2D1_BUFFER_PRECISION_16BPC_FLOAT,
+            "Got unexpected buffer precision %#x.\n", controls.bufferPrecision);
+    ok(controls.tileSize.width == 64, "Got unexpected tile width %u.\n", controls.tileSize.width);
+    ok(controls.tileSize.height == 32, "Got unexpected tile height %u.\n", controls.tileSize.height);
+
+    ID2D1DeviceContext_SetRenderingControls(context, &previous);
+
+    release_test_context(&ctx);
+}
