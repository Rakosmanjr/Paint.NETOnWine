+/* Bring what is already on the destination into the surface, so that anything
+ * left undrawn still ends up back on the device context unchanged. When the
+ * copy is blended back, GDI has no alpha channel to give and the content
+ * would blend away. Mark it opaque: it stands for content that is already on
+ * the device context, and a target that ignores alpha is opaque anyway. */
+static void d2d_dc_render_target_copy_in(struct d2d_dc_render_target *render_target, HDC surface_hdc)
+{
+    const RECT *dst_rect = &render_target->dst_rect;
+    int i, w = dst_rect->right - dst_rect->left, h = dst_rect->bottom - dst_rect->top;
+    BITMAPINFO info = {{0}};
+    HBITMAP bitmap, prev;
+    DWORD *bits;
+    HDC hdc;
+
+    if (w <= 0 || h <= 0)
+        return;
+
+    if (!(hdc = CreateCompatibleDC(NULL)))
+        return;
+
+    info.bmiHeader.biSize = sizeof(info.bmiHeader);
+    info.bmiHeader.biWidth = w;
+    info.bmiHeader.biHeight = -h;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+
+    if ((bitmap = CreateDIBSection(hdc, &info, DIB_RGB_COLORS, (void **)&bits, NULL, 0)))
+    {
+        prev = SelectObject(hdc, bitmap);
+        BitBlt(hdc, 0, 0, w, h, render_target->hdc, dst_rect->left, dst_rect->top, SRCCOPY);
+        for (i = 0; i < w * h; ++i)
+            bits[i] |= 0xff000000;
+        BitBlt(surface_hdc, 0, 0, w, h, hdc, 0, 0, SRCCOPY);
+        SelectObject(hdc, prev);
+        DeleteObject(bitmap);
+    }
+
+    DeleteDC(hdc);
+}
+
+static void d2d_dc_render_target_begin_draw(IUnknown *outer_unknown)
+{
+    struct d2d_dc_render_target *render_target = impl_from_IUnknown(outer_unknown);
+    HDC hdc;
+
+    if (!render_target->dxgi_surface)
+        return;
+
+    if (SUCCEEDED(IDXGISurface1_GetDC(render_target->dxgi_surface, TRUE, &hdc)))
+    {
+        d2d_dc_render_target_copy_in(render_target, hdc);
+        IDXGISurface1_ReleaseDC(render_target->dxgi_surface, NULL);
+    }
+}
