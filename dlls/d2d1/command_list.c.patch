+static void d2d_command_rebase_pointer(void *field, ptrdiff_t delta)
+{
+    char **ptr = field;
+
+    if (*ptr)
+        *ptr += delta;
+}
+
+/* Commands with variable-sized data point into the command storage itself.
+ * Growing the storage can move it, which leaves those pointers referring to
+ * the old allocation until they are moved by the same amount. */
+static void d2d_command_list_rebase(struct d2d_command_list *command_list, ptrdiff_t delta)
+{
+    struct d2d_command *command;
+    size_t offset;
+
+    for (offset = 0; offset < command_list->size; offset += command->size)
+    {
+        command = (struct d2d_command *)((char *)command_list->data + offset);
+
+        switch (command->op)
+        {
+            case D2D_COMMAND_DRAW_GLYPH_RUN:
+            {
+                struct d2d_command_draw_glyph_run *c = (void *)command;
+
+                d2d_command_rebase_pointer(&c->run.glyphIndices, delta);
+                d2d_command_rebase_pointer(&c->run.glyphAdvances, delta);
+                d2d_command_rebase_pointer(&c->run.glyphOffsets, delta);
+                d2d_command_rebase_pointer(&c->run_desc, delta);
+                if (c->run_desc)
+                {
+                    d2d_command_rebase_pointer(&c->run_desc->localeName, delta);
+                    d2d_command_rebase_pointer(&c->run_desc->string, delta);
+                    d2d_command_rebase_pointer(&c->run_desc->clusterMap, delta);
+                }
+                break;
+            }
+
+            case D2D_COMMAND_DRAW_BITMAP:
+            {
+                struct d2d_command_draw_bitmap *c = (void *)command;
+
+                d2d_command_rebase_pointer(&c->dst_rect, delta);
+                d2d_command_rebase_pointer(&c->src_rect, delta);
+                d2d_command_rebase_pointer(&c->perspective_transform, delta);
+                break;
+            }
+
+            case D2D_COMMAND_DRAW_IMAGE:
+            {
+                struct d2d_command_draw_image *c = (void *)command;
+
+                d2d_command_rebase_pointer(&c->target_offset, delta);
+                d2d_command_rebase_pointer(&c->image_rect, delta);
+                break;
+            }
+
+            case D2D_COMMAND_FILL_OPACITY_MASK:
+            {
+                struct d2d_command_fill_opacity_mask *c = (void *)command;
+
+                d2d_command_rebase_pointer(&c->dst_rect, delta);
+                d2d_command_rebase_pointer(&c->src_rect, delta);
+                break;
+            }
+
+            default:
+                break;
+        }
+    }
+}
