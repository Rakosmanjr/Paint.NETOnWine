+void d2d_command_list_draw_command(const struct d2d_command *command,
+        struct d2d_device_context *context, const D2D1_MATRIX_3X2_F *offset)
+{
+    TRACE("command %p, context %p\n", command, context);
+
+    switch (command->op)
+    {
+        case D2D_COMMAND_SET_ANTIALIAS_MODE:
+        {
+            const struct d2d_command_set_antialias_mode *c = (void *) command;
+            ID2D1DeviceContext6_SetAntialiasMode(&context->ID2D1DeviceContext6_iface, c->mode);
+            break;
+        }
+        case D2D_COMMAND_SET_TAGS:
+        {
+            const struct d2d_command_set_tags *c = (void *) command;
+            ID2D1DeviceContext6_SetTags(&context->ID2D1DeviceContext6_iface, c->tag1, c->tag2);
+            break;
+        }
+        case D2D_COMMAND_SET_TEXT_ANTIALIAS_MODE:
+        {
+            const struct d2d_command_set_text_antialias_mode *c = (void *) command;
+            ID2D1DeviceContext6_SetTextAntialiasMode(&context->ID2D1DeviceContext6_iface, c->mode);
+            break;
+        }
+        case D2D_COMMAND_SET_TEXT_RENDERING_PARAMS:
+        {
+            const struct d2d_command_set_text_rendering_params *c = (void *) command;
+            ID2D1DeviceContext6_SetTextRenderingParams(&context->ID2D1DeviceContext6_iface, c->params);
+            break;
+        }
+        case D2D_COMMAND_SET_TRANSFORM:
+        {
+            const struct d2d_command_set_transform *c = (void *) command;
+            D2D1_MATRIX_3X2_F transform = c->transform;
+
+            /* The list is replayed at an offset from where it was recorded. */
+            d2d_matrix_multiply(&transform, offset);
+            ID2D1DeviceContext6_SetTransform(&context->ID2D1DeviceContext6_iface, &transform);
+            break;
+        }
+        case D2D_COMMAND_SET_PRIMITIVE_BLEND:
+        {
+            const struct d2d_command_set_primitive_blend *c = (void *) command;
+            ID2D1DeviceContext6_SetPrimitiveBlend(&context->ID2D1DeviceContext6_iface, c->primitive_blend);
+            break;
+        }
+        case D2D_COMMAND_SET_UNIT_MODE:
+        {
+            const struct d2d_command_set_unit_mode *c = (void *) command;
+            ID2D1DeviceContext6_SetUnitMode(&context->ID2D1DeviceContext6_iface, c->mode);
+            break;
+        }
+        case D2D_COMMAND_CLEAR:
+        {
+            const struct d2d_command_clear *c = (void *) command;
+            ID2D1DeviceContext6_Clear(&context->ID2D1DeviceContext6_iface, &c->color);
+            break;
+        }
+        case D2D_COMMAND_DRAW_GLYPH_RUN:
+        {
+            const struct d2d_command_draw_glyph_run *c = (void *) command;
+            ID2D1DeviceContext6_DrawGlyphRun(&context->ID2D1DeviceContext6_iface, c->origin, &c->run, c->run_desc, c->brush, c->measuring_mode);
+            break;
+        }
+        case D2D_COMMAND_DRAW_LINE:
+        {
+            const struct d2d_command_draw_line *c = (void *) command;
+            ID2D1DeviceContext6_DrawLine(&context->ID2D1DeviceContext6_iface, c->p0, c->p1, c->brush, c->stroke_width, c->stroke_style);
+            break;
+        }
+        case D2D_COMMAND_DRAW_GEOMETRY:
+        {
+            const struct d2d_command_draw_geometry *c = (void *) command;
+            ID2D1DeviceContext6_DrawGeometry(&context->ID2D1DeviceContext6_iface, c->geometry, c->brush, c->stroke_width, c->stroke_style);
+            break;
+        }
+        case D2D_COMMAND_DRAW_RECTANGLE:
+        {
+            const struct d2d_command_draw_rectangle *c = (void *) command;
+            ID2D1DeviceContext6_DrawRectangle(&context->ID2D1DeviceContext6_iface, &c->rect, c->brush, c->stroke_width, c->stroke_style);
+            break;
+        }
+        case D2D_COMMAND_DRAW_BITMAP:
+        {
+            const struct d2d_command_draw_bitmap *c = (void *) command;
+            ID2D1DeviceContext6_DrawBitmap(&context->ID2D1DeviceContext6_iface, c->bitmap, c->dst_rect, c->opacity, c->interpolation_mode, c->src_rect, c->perspective_transform);
+            break;
+        }
+        case D2D_COMMAND_DRAW_IMAGE:
+        {
+            const struct d2d_command_draw_image *c = (void *) command;
+            ID2D1DeviceContext6_DrawImage(&context->ID2D1DeviceContext6_iface, c->image, c->target_offset, c->image_rect, c->interpolation_mode, c->composite_mode);
+            break;
+        }
+        case D2D_COMMAND_FILL_MESH:
+        {
+            const struct d2d_command_fill_mesh *c = (void *) command;
+            ID2D1DeviceContext6_FillMesh(&context->ID2D1DeviceContext6_iface, c->mesh, c->brush);
+            break;
+        }
+        case D2D_COMMAND_FILL_OPACITY_MASK:
+        {
+            const struct d2d_command_fill_opacity_mask *c = (void *) command;
+            ID2D1DeviceContext6_FillOpacityMask(&context->ID2D1DeviceContext6_iface, c->bitmap, c->brush, c->dst_rect, c->src_rect);
+            break;
+        }
+        case D2D_COMMAND_FILL_GEOMETRY:
+        {
+            const struct d2d_command_fill_geometry *c = (void *) command;
+            ID2D1DeviceContext6_FillGeometry(&context->ID2D1DeviceContext6_iface, c->geometry, c->brush, c->opacity_brush);
+            break;
+        }
+        case D2D_COMMAND_FILL_RECTANGLE:
+        {
+            const struct d2d_command_fill_rectangle *c = (void *) command;
+            ID2D1DeviceContext6_FillRectangle(&context->ID2D1DeviceContext6_iface, &c->rect, c->brush);
+            break;
+        }
+        case D2D_COMMAND_DRAW_SPRITE_BATCH:
+        {
+            const struct d2d_command_draw_sprite_batch *c = (void *) command;
+            ID2D1DeviceContext6_DrawSpriteBatch(&context->ID2D1DeviceContext6_iface, c->sprite_batch,
+                    c->start_index, c->sprite_count, c->bitmap, c->interpolation_mode, c->sprite_options);
+            break;
+        }
+        case D2D_COMMAND_PUSH_CLIP:
+        {
+            const struct d2d_command_push_clip *c = (void *) command;
+            ID2D1DeviceContext6_PushAxisAlignedClip(&context->ID2D1DeviceContext6_iface, &c->rect, c->mode);
+            break;
+        }
+        case D2D_COMMAND_POP_CLIP:
+            ID2D1DeviceContext6_PopAxisAlignedClip(&context->ID2D1DeviceContext6_iface);
+            break;
+        case D2D_COMMAND_PUSH_LAYER:
+        {
+            const struct d2d_command_push_layer *c = (void *) command;
+            ID2D1DeviceContext6_PushLayer(&context->ID2D1DeviceContext6_iface, &c->params, NULL);
+            break;
+        }
+        case D2D_COMMAND_POP_LAYER:
+            ID2D1DeviceContext6_PopLayer(&context->ID2D1DeviceContext6_iface);
+            break;
+
+        default:
+            FIXME("Unhandled command %u.\n", command->op);
+    }
+}
