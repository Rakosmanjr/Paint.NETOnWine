+/* The bounds of a list are those of its content: what each primitive
+ * covers under the transform in force when it was recorded, limited by the
+ * clips and layers enclosing it. They are kept up to date as commands are
+ * recorded, in list space. */
+
+static void d2d_command_list_add_bounds(struct d2d_command_list *command_list, const D2D1_RECT_F *rect)
+{
+    D2D1_RECT_F r = *rect;
+
+    if (command_list->clip_count)
+        d2d_rect_intersect(&r, &command_list->clips[command_list->clip_count - 1]);
+    if (d2d_rect_is_empty(&r))
+        return;
+
+    if (d2d_rect_is_empty(&command_list->bounds))
+        command_list->bounds = r;
+    else
+        d2d_rect_union(&command_list->bounds, &r);
+}
+
+static bool d2d_rect_is_infinite(const D2D1_RECT_F *rect)
+{
+    return rect->left <= -FLT_MAX && rect->top <= -FLT_MAX && rect->right >= FLT_MAX && rect->bottom >= FLT_MAX;
+}
+
+/* Add a rect given in the space of the current transform. An infinite rect
+ * is not taken through the transform, as scaling it would overflow. */
+static void d2d_command_list_add_rect_bounds(struct d2d_command_list *command_list, const D2D1_RECT_F *rect)
+{
+    D2D1_RECT_F r;
+
+    if (d2d_rect_is_infinite(rect))
+        r = *rect;
+    else
+        d2d_rect_transform_bounds(&r, &command_list->transform, rect);
+    d2d_command_list_add_bounds(command_list, &r);
+}
+
+static void d2d_command_list_add_geometry_bounds(struct d2d_command_list *command_list, ID2D1Geometry *geometry)
+{
+    struct d2d_polyline_set set;
+    D2D1_RECT_F bounds;
+
+    if (SUCCEEDED(ID2D1Geometry_GetBounds(geometry, &command_list->transform, &bounds)))
+    {
+        d2d_command_list_add_bounds(command_list, &bounds);
+        return;
+    }
+
+    d2d_polyline_set_init(&set, D2D1_DEFAULT_FLATTENING_TOLERANCE);
+    if (SUCCEEDED(d2d_polyline_set_add_geometry(&set, geometry, &command_list->transform,
+            D2D1_DEFAULT_FLATTENING_TOLERANCE)))
+    {
+        d2d_polyline_set_get_bounds(&set, &bounds);
+        d2d_command_list_add_bounds(command_list, &bounds);
+    }
+    d2d_polyline_set_cleanup(&set);
+}
+
+/* The bounds of a stroke are those of its outline, built the way it is
+ * drawn: a normal stroke is widened in the space it is given in and then
+ * transformed; a fixed-width or hairline stroke is widened after the
+ * transform. A hairline is a pixel wide, which here is taken as a DIP. */
+static void d2d_command_list_add_stroke_bounds(struct d2d_command_list *command_list, ID2D1Geometry *geometry,
+        const D2D1_POINT_2F *points, unsigned int point_count, bool closed, float stroke_width,
+        ID2D1StrokeStyle *stroke_style)
+{
+    const D2D1_STROKE_STYLE_PROPERTIES1 *style = d2d_stroke_style_properties(stroke_style);
+    const D2D1_MATRIX_3X2_F *flatten_transform, *stroke_transform;
+    struct d2d_polyline_set path, outline;
+    ID2D1SimplifiedGeometrySink *sink;
+    D2D1_RECT_F bounds;
+    float scale, tolerance;
+    unsigned int i;
+    HRESULT hr;
+
+    scale = d2d_matrix_scale_bound(&command_list->transform);
+    if (!(scale > 0.0f))
+        return;
+
+    if (style->transformType == D2D1_STROKE_TRANSFORM_TYPE_NORMAL)
+    {
+        flatten_transform = NULL;
+        stroke_transform = &command_list->transform;
+        tolerance = D2D1_DEFAULT_FLATTENING_TOLERANCE / scale;
+    }
+    else
+    {
+        if (style->transformType == D2D1_STROKE_TRANSFORM_TYPE_HAIRLINE)
+            stroke_width = 1.0f;
+        flatten_transform = &command_list->transform;
+        stroke_transform = &identity;
+        tolerance = D2D1_DEFAULT_FLATTENING_TOLERANCE;
+    }
+
+    d2d_polyline_set_init(&path, tolerance);
+    d2d_polyline_set_init(&outline, tolerance);
+
+    if (geometry)
+    {
+        hr = d2d_polyline_set_add_geometry(&path, geometry, flatten_transform, tolerance);
+    }
+    else
+    {
+        D2D1_POINT_2F p;
+
+        sink = &path.ID2D1SimplifiedGeometrySink_iface;
+        for (i = 0; i < point_count; ++i)
+        {
+            p = points[i];
+            if (flatten_transform)
+                d2d_point_transform(&p, flatten_transform, points[i].x, points[i].y);
+            if (!i)
+                ID2D1SimplifiedGeometrySink_BeginFigure(sink, p, D2D1_FIGURE_BEGIN_HOLLOW);
+            else
+                ID2D1SimplifiedGeometrySink_AddLines(sink, &p, 1);
+        }
+        ID2D1SimplifiedGeometrySink_EndFigure(sink, closed ? D2D1_FIGURE_END_CLOSED : D2D1_FIGURE_END_OPEN);
+        hr = ID2D1SimplifiedGeometrySink_Close(sink);
+    }
+
+    if (SUCCEEDED(hr) && SUCCEEDED(hr = d2d_polyline_set_stroke(&path, stroke_width, stroke_style, stroke_transform,
+            D2D1_DEFAULT_FLATTENING_TOLERANCE, &outline)))
+    {
+        d2d_polyline_set_get_bounds(&outline, &bounds);
+        d2d_command_list_add_bounds(command_list, &bounds);
+    }
+    else
+    {
+        WARN("Failed to build stroke outline, hr %#lx.\n", hr);
+    }
+
+    d2d_polyline_set_cleanup(&outline);
+    d2d_polyline_set_cleanup(&path);
+}
+
+/* The bounds of an image drawn at an offset, in the space of the current
+ * transform. An image whose bounds are unknown is taken to cover the plane. */
+static void d2d_command_list_add_image_bounds(struct d2d_command_list *command_list,
+        struct d2d_device_context *context, ID2D1Image *image, const D2D1_POINT_2F *offset,
+        const D2D1_RECT_F *image_rect)
+{
+    D2D1_RECT_F bounds;
+
+    if (FAILED(ID2D1DeviceContext6_GetImageLocalBounds(&context->ID2D1DeviceContext6_iface, image, &bounds)))
+        d2d_rect_set(&bounds, -FLT_MAX, -FLT_MAX, FLT_MAX, FLT_MAX);
+    if (image_rect)
+        d2d_rect_intersect(&bounds, image_rect);
+    if (d2d_rect_is_empty(&bounds))
+        return;
+    if (offset && !d2d_rect_is_infinite(&bounds))
+    {
+        bounds.left += offset->x;
+        bounds.right += offset->x;
+        bounds.top += offset->y;
+        bounds.bottom += offset->y;
+    }
+    d2d_command_list_add_rect_bounds(command_list, &bounds);
+}
