+void d2d_command_list_draw(ID2D1CommandList *iface, struct d2d_device_context *context,
+        const D2D1_POINT_2F *origin)
+{
+    struct d2d_command_list *command_list = impl_from_ID2D1CommandList(iface);
+    D2D1_DRAWING_STATE_DESCRIPTION1 prev_state;
+    D2D1_MATRIX_3X2_F offset;
+    const void *data, *end;
+
+    TRACE("iface %p, context %p, origin %p\n", iface, context, origin);
+
+    if (command_list->state != D2D_COMMAND_LIST_STATE_CLOSED) return;
+
+    /* Drawing a list is not supposed to disturb the state of the context it
+     * is drawn on, but replaying it sets the state the list recorded. */
+    prev_state = context->drawing_state;
+
+    /* "The method respects the current device context state, including
+     * transforms." What the list recorded is in its own space; where that
+     * lands is decided by the offset it is drawn at and by the transform
+     * that is current now, not by the one that was current when it was
+     * recorded. */
+    offset._11 = 1.0f;
+    offset._12 = 0.0f;
+    offset._21 = 0.0f;
+    offset._22 = 1.0f;
+    offset._31 = origin ? origin->x : 0.0f;
+    offset._32 = origin ? origin->y : 0.0f;
+    d2d_matrix_multiply(&offset, &prev_state.transform);
+
+    ID2D1DeviceContext6_SetTransform(&context->ID2D1DeviceContext6_iface, &offset);
+
+    data = command_list->data;
+    end = (char *)command_list->data + command_list->size;
+    while (data < end)
+    {
+        const struct d2d_command *command = data;
+
+        d2d_command_list_draw_command(command, context, &offset);
+
+        data = (char *)data + command->size;
+    }
+
+    context->drawing_state = prev_state;
+}
