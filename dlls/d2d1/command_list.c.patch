+/* A glyph run is bounded by its advances and the font's ascent and descent.
+ * Glyph offsets and ink outside the advance box are not accounted for. */
+static void d2d_command_list_add_glyph_run_bounds(struct d2d_command_list *command_list,
+        D2D1_POINT_2F origin, const DWRITE_GLYPH_RUN *run)
+{
+    DWRITE_GLYPH_METRICS *glyph_metrics;
+    DWRITE_FONT_METRICS metrics;
+    float scale, width = 0.0f;
+    D2D1_RECT_F rect;
+    unsigned int i;
+
+    if (!run->fontFace || !run->glyphCount)
+        return;
+
+    IDWriteFontFace_GetMetrics(run->fontFace, &metrics);
+    if (!metrics.designUnitsPerEm)
+        return;
+    scale = run->fontEmSize / metrics.designUnitsPerEm;
+
+    if (run->glyphAdvances)
+    {
+        for (i = 0; i < run->glyphCount; ++i)
+            width += run->glyphAdvances[i];
+    }
+    else if ((glyph_metrics = calloc(run->glyphCount, sizeof(*glyph_metrics))))
+    {
+        if (SUCCEEDED(IDWriteFontFace_GetDesignGlyphMetrics(run->fontFace, run->glyphIndices,
+                run->glyphCount, glyph_metrics, run->isSideways)))
+        {
+            for (i = 0; i < run->glyphCount; ++i)
+                width += glyph_metrics[i].advanceWidth * scale;
+        }
+        free(glyph_metrics);
+    }
+
+    if (run->bidiLevel & 1)
+        d2d_rect_set(&rect, origin.x - width, origin.y - metrics.ascent * scale,
+                origin.x, origin.y + metrics.descent * scale);
+    else
+        d2d_rect_set(&rect, origin.x, origin.y - metrics.ascent * scale,
+                origin.x + width, origin.y + metrics.descent * scale);
+    d2d_command_list_add_rect_bounds(command_list, &rect);
+}
+
+/* Push a clip given in list space; it limits everything recorded until the
+ * matching pop. */
+static void d2d_command_list_push_clip_bounds(struct d2d_command_list *command_list, const D2D1_RECT_F *rect)
+{
+    D2D1_RECT_F r = *rect;
+
+    if (!d2d_array_reserve((void **)&command_list->clips, &command_list->clips_size,
+            command_list->clip_count + 1, sizeof(*command_list->clips)))
+    {
+        command_list->state = D2D_COMMAND_LIST_STATE_ERROR;
+        return;
+    }
+
+    if (command_list->clip_count)
+        d2d_rect_intersect(&r, &command_list->clips[command_list->clip_count - 1]);
+    command_list->clips[command_list->clip_count++] = r;
+}
+
+static void d2d_command_list_pop_clip_bounds(struct d2d_command_list *command_list)
+{
+    if (command_list->clip_count)
+        --command_list->clip_count;
+}
+
+void d2d_command_list_get_bounds(const struct d2d_command_list *command_list, D2D1_RECT_F *bounds)
+{
+    if (d2d_rect_is_empty(&command_list->bounds))
+        d2d_rect_set(bounds, INFINITY, INFINITY, FLT_MAX, FLT_MAX);
+    else
+        *bounds = command_list->bounds;
+}
