+#include "d2d1_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(d2d);
+
+/* Antialiased coverage is the fraction of an 8x8 grid of samples within the
+ * pixel that the shape covers, the samples sitting at the centres of the
+ * grid cells. The alpha produced for a given number of covered samples is
+ * (n * 255 + 32) / 64. Before sampling, every vertex is moved up to the
+ * next 1/16 of a pixel. */
+#define D2D_COVERAGE_GRID 8
+#define D2D_COVERAGE_SNAP 16
+
+float d2d_coverage_snap(float v)
+{
+    return ceilf(v * D2D_COVERAGE_SNAP) / D2D_COVERAGE_SNAP;
+}
+
+static inline struct d2d_polyline_set *impl_from_ID2D1SimplifiedGeometrySink(ID2D1SimplifiedGeometrySink *iface)
+{
+    return CONTAINING_RECORD(iface, struct d2d_polyline_set, ID2D1SimplifiedGeometrySink_iface);
+}
+
+static bool d2d_polyline_set_begin(struct d2d_polyline_set *set, bool closed, bool hollow)
+{
+    struct d2d_polyline *line;
+
+    if (!d2d_array_reserve((void **)&set->lines, &set->lines_size, set->line_count + 1, sizeof(*set->lines)))
+    {
+        set->hr = E_OUTOFMEMORY;
+        return false;
+    }
+
+    line = &set->lines[set->line_count++];
+    line->start = set->point_count;
+    line->count = 0;
+    line->closed = closed;
+    line->hollow = hollow;
+
+    return true;
+}
+
+static bool d2d_polyline_set_add_point(struct d2d_polyline_set *set, D2D1_POINT_2F point)
+{
+    if (!d2d_array_reserve((void **)&set->points, &set->points_size, set->point_count + 1, sizeof(*set->points)))
+    {
+        set->hr = E_OUTOFMEMORY;
+        return false;
+    }
+
+    set->points[set->point_count++] = point;
+    ++set->lines[set->line_count - 1].count;
+
+    return true;
+}
+
+static D2D1_POINT_2F d2d_polyline_set_last_point(const struct d2d_polyline_set *set)
+{
+    return set->points[set->point_count - 1];
+}
+
+/* Polygons are built with a consistent orientation so that a non-zero fill
+ * of their union is the union of their interiors. */
+static void d2d_polyline_set_orient_last(struct d2d_polyline_set *set)
+{
+    struct d2d_polyline *line = &set->lines[set->line_count - 1];
+    D2D1_POINT_2F *points = &set->points[line->start];
+    size_t i, j;
+    float area = 0.0f;
+
+    for (i = 0; i < line->count; ++i)
+    {
+        const D2D1_POINT_2F *a = &points[i], *b = &points[(i + 1) % line->count];
+        area += a->x * b->y - b->x * a->y;
+    }
+
+    if (area >= 0.0f)
+        return;
+
+    for (i = 0, j = line->count - 1; i < j; ++i, --j)
+    {
+        D2D1_POINT_2F tmp = points[i];
+        points[i] = points[j];
+        points[j] = tmp;
+    }
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_polyline_sink_QueryInterface(ID2D1SimplifiedGeometrySink *iface,
+        REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_ID2D1SimplifiedGeometrySink)
+            || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        *out = iface;
+        return S_OK;
+    }
+
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_polyline_sink_AddRef(ID2D1SimplifiedGeometrySink *iface)
+{
+    return 2;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_polyline_sink_Release(ID2D1SimplifiedGeometrySink *iface)
+{
+    return 1;
+}
+
+static void STDMETHODCALLTYPE d2d_polyline_sink_SetFillMode(ID2D1SimplifiedGeometrySink *iface, D2D1_FILL_MODE mode)
+{
+    struct d2d_polyline_set *set = impl_from_ID2D1SimplifiedGeometrySink(iface);
+
+    set->fill_mode = mode;
+}
+
+static void STDMETHODCALLTYPE d2d_polyline_sink_SetSegmentFlags(ID2D1SimplifiedGeometrySink *iface,
+        D2D1_PATH_SEGMENT flags)
+{
+}
+
+static void STDMETHODCALLTYPE d2d_polyline_sink_BeginFigure(ID2D1SimplifiedGeometrySink *iface,
+        D2D1_POINT_2F start_point, D2D1_FIGURE_BEGIN figure_begin)
+{
+    struct d2d_polyline_set *set = impl_from_ID2D1SimplifiedGeometrySink(iface);
+
+    if (FAILED(set->hr))
+        return;
+
+    if (!d2d_polyline_set_begin(set, false, figure_begin == D2D1_FIGURE_BEGIN_HOLLOW))
+        return;
+    d2d_polyline_set_add_point(set, start_point);
+}
+
+static void STDMETHODCALLTYPE d2d_polyline_sink_AddLines(ID2D1SimplifiedGeometrySink *iface,
+        const D2D1_POINT_2F *points, UINT32 count)
+{
+    struct d2d_polyline_set *set = impl_from_ID2D1SimplifiedGeometrySink(iface);
+    unsigned int i;
+
+    if (FAILED(set->hr) || !set->line_count)
+        return;
+
+    for (i = 0; i < count; ++i)
+    {
+        if (!d2d_polyline_set_add_point(set, points[i]))
+            return;
+    }
+}
+
+static void d2d_polyline_set_flatten_cubic(struct d2d_polyline_set *set, const D2D1_POINT_2F *p0,
+        const D2D1_BEZIER_SEGMENT *b, float tolerance)
+{
+    D2D1_BEZIER_SEGMENT b0, b1;
+    D2D1_POINT_2F q;
+    float d;
+
+    /* The deviation of the control points from the positions they would
+     * have if evenly spaced along a straight line bounds the distance of
+     * the curve from its chord. */
+    d2d_point_lerp(&q, p0, &b->point2, 0.5f);
+    d2d_point_subtract(&q, &b->point1, &q);
+    d = fabsf(q.x) + fabsf(q.y);
+    d2d_point_lerp(&q, &b->point1, &b->point3, 0.5f);
+    d2d_point_subtract(&q, &b->point2, &q);
+    d += fabsf(q.x) + fabsf(q.y);
+    if (d < tolerance)
+    {
+        d2d_polyline_set_add_point(set, b->point3);
+        return;
+    }
+
+    d2d_point_lerp(&q, &b->point1, &b->point2, 0.5f);
+
+    b1.point3 = b->point3;
+    d2d_point_lerp(&b1.point2, &b1.point3, &b->point2, 0.5f);
+    d2d_point_lerp(&b1.point1, &b1.point2, &q, 0.5f);
+
+    d2d_point_lerp(&b0.point1, p0, &b->point1, 0.5f);
+    d2d_point_lerp(&b0.point2, &b0.point1, &q, 0.5f);
+    d2d_point_lerp(&b0.point3, &b0.point2, &b1.point1, 0.5f);
+
+    d2d_polyline_set_flatten_cubic(set, p0, &b0, tolerance);
+    d2d_polyline_set_flatten_cubic(set, &b0.point3, &b1, tolerance);
+}
+
+static void STDMETHODCALLTYPE d2d_polyline_sink_AddBeziers(ID2D1SimplifiedGeometrySink *iface,
+        const D2D1_BEZIER_SEGMENT *beziers, UINT32 count)
+{
+    struct d2d_polyline_set *set = impl_from_ID2D1SimplifiedGeometrySink(iface);
+    D2D1_POINT_2F p;
+    unsigned int i;
+
+    if (FAILED(set->hr) || !set->line_count)
+        return;
+
+    for (i = 0; i < count && SUCCEEDED(set->hr); ++i)
+    {
+        p = d2d_polyline_set_last_point(set);
+        d2d_polyline_set_flatten_cubic(set, &p, &beziers[i], set->tolerance);
+    }
+}
+
+static void STDMETHODCALLTYPE d2d_polyline_sink_EndFigure(ID2D1SimplifiedGeometrySink *iface,
+        D2D1_FIGURE_END figure_end)
+{
+    struct d2d_polyline_set *set = impl_from_ID2D1SimplifiedGeometrySink(iface);
+
+    if (FAILED(set->hr) || !set->line_count)
+        return;
+
+    set->lines[set->line_count - 1].closed = figure_end == D2D1_FIGURE_END_CLOSED;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_polyline_sink_Close(ID2D1SimplifiedGeometrySink *iface)
+{
+    struct d2d_polyline_set *set = impl_from_ID2D1SimplifiedGeometrySink(iface);
+
+    return set->hr;
+}
+
+static const struct ID2D1SimplifiedGeometrySinkVtbl d2d_polyline_sink_vtbl =
+{
+    d2d_polyline_sink_QueryInterface,
+    d2d_polyline_sink_AddRef,
+    d2d_polyline_sink_Release,
+    d2d_polyline_sink_SetFillMode,
+    d2d_polyline_sink_SetSegmentFlags,
+    d2d_polyline_sink_BeginFigure,
+    d2d_polyline_sink_AddLines,
+    d2d_polyline_sink_AddBeziers,
+    d2d_polyline_sink_EndFigure,
+    d2d_polyline_sink_Close,
+};
+
+void d2d_polyline_set_init(struct d2d_polyline_set *set, float tolerance)
+{
+    memset(set, 0, sizeof(*set));
+    set->ID2D1SimplifiedGeometrySink_iface.lpVtbl = &d2d_polyline_sink_vtbl;
+    set->fill_mode = D2D1_FILL_MODE_ALTERNATE;
+    set->tolerance = tolerance;
+    set->hr = S_OK;
+}
+
+void d2d_polyline_set_cleanup(struct d2d_polyline_set *set)
+{
+    free(set->points);
+    free(set->lines);
+}
+
+HRESULT d2d_polyline_set_add_geometry(struct d2d_polyline_set *set, ID2D1Geometry *geometry,
+        const D2D1_MATRIX_3X2_F *transform, float tolerance)
+{
+    HRESULT hr;
+
+    set->tolerance = tolerance;
+    if (FAILED(hr = ID2D1Geometry_Simplify(geometry, D2D1_GEOMETRY_SIMPLIFICATION_OPTION_LINES,
+            transform, tolerance, &set->ID2D1SimplifiedGeometrySink_iface)))
+        return hr;
+
+    return set->hr;
+}
+
+/* The bounds of every point in the set; empty if there are none. */
+void d2d_polyline_set_get_bounds(const struct d2d_polyline_set *set, D2D1_RECT_F *bounds)
+{
+    size_t i;
+
+    d2d_rect_set(bounds, FLT_MAX, FLT_MAX, -FLT_MAX, -FLT_MAX);
+    for (i = 0; i < set->point_count; ++i)
+        d2d_rect_expand(bounds, &set->points[i]);
+}
+
+/* The properties a stroke is built with: those of the style, or the
+ * defaults for a stroke drawn without one. */
+const D2D1_STROKE_STYLE_PROPERTIES1 *d2d_stroke_style_properties(ID2D1StrokeStyle *stroke_style)
+{
+    static const D2D1_STROKE_STYLE_PROPERTIES1 default_style =
+    {
+        D2D1_CAP_STYLE_FLAT, D2D1_CAP_STYLE_FLAT, D2D1_CAP_STYLE_FLAT, D2D1_LINE_JOIN_MITER, 10.0f,
+        D2D1_DASH_STYLE_SOLID, 0.0f, D2D1_STROKE_TRANSFORM_TYPE_NORMAL,
+    };
+    const struct d2d_stroke_style *style = unsafe_impl_from_ID2D1StrokeStyle(stroke_style);
+
+    return style ? &style->desc : &default_style;
+}
+
+/* Whether the set is a single axis-aligned rectangle, which has a closed
+ * form for its coverage. */
+bool d2d_polyline_set_is_rect(const struct d2d_polyline_set *set, D2D1_RECT_F *rect)
+{
+    const struct d2d_polyline *line = NULL;
+    const D2D1_POINT_2F *p;
+    size_t i, count;
+
+    for (i = 0; i < set->line_count; ++i)
+    {
+        if (set->lines[i].hollow || set->lines[i].count < 2)
+            continue;
+        if (line)
+            return false;
+        line = &set->lines[i];
+    }
+    if (!line)
+        return false;
+
+    p = &set->points[line->start];
+    count = line->count;
+    if (count == 5 && p[4].x == p[0].x && p[4].y == p[0].y)
+        count = 4;
+    if (count != 4)
+        return false;
+
+    if (!((p[0].x == p[3].x && p[1].x == p[2].x && p[0].y == p[1].y && p[2].y == p[3].y)
+            || (p[0].y == p[3].y && p[1].y == p[2].y && p[0].x == p[1].x && p[2].x == p[3].x)))
+        return false;
+
+    rect->left = min(p[0].x, p[2].x);
+    rect->top = min(p[0].y, p[2].y);
+    rect->right = max(p[0].x, p[2].x);
+    rect->bottom = max(p[0].y, p[2].y);
+
+    return true;
+}
+
+struct d2d_stroke
+{
+    struct d2d_polyline_set *out;
+    const D2D1_STROKE_STYLE_PROPERTIES1 *style;
+    const float *dashes;
+    UINT32 dash_count;
+    const D2D1_MATRIX_3X2_F *transform;
+    float half_width;
+    /* Flattening tolerance in the output space. */
+    float tolerance;
+};
+
+static bool d2d_stroke_add_point(struct d2d_stroke *stroke, float x, float y)
+{
+    D2D1_POINT_2F p;
+
+    d2d_point_transform(&p, stroke->transform, x, y);
+    return d2d_polyline_set_add_point(stroke->out, p);
+}
+
+static bool d2d_stroke_begin(struct d2d_stroke *stroke)
+{
+    return d2d_polyline_set_begin(stroke->out, true, false);
+}
+
+static void d2d_stroke_end(struct d2d_stroke *stroke)
+{
+    d2d_polyline_set_orient_last(stroke->out);
+}
+
+/* Points along the circle of the stroke's half-width around the centre,
+ * from angle "from" through "sweep" radians, ending with the end point. The
+ * arc is built from cubic Béziers of at most a quarter turn each, flattened
+ * in the output space the same way a geometry's curves are. */
+static bool d2d_stroke_add_arc(struct d2d_stroke *stroke, const D2D1_POINT_2F *centre, float from, float sweep)
+{
+    unsigned int i, count;
+    float h = stroke->half_width, a0, a1, k;
+    D2D1_BEZIER_SEGMENT b;
+    D2D1_POINT_2F p0;
+
+    count = max(1, ceilf(fabsf(sweep) / (M_PI / 2.0f) - 1e-3f));
+    for (i = 0; i < count; ++i)
+    {
+        a0 = from + sweep * i / count;
+        a1 = from + sweep * (i + 1) / count;
+        k = 4.0f / 3.0f * tanf((a1 - a0) / 4.0f);
+        d2d_point_transform(&p0, stroke->transform, centre->x + h * cosf(a0), centre->y + h * sinf(a0));
+        d2d_point_transform(&b.point1, stroke->transform,
+                centre->x + h * (cosf(a0) - k * sinf(a0)), centre->y + h * (sinf(a0) + k * cosf(a0)));
+        d2d_point_transform(&b.point2, stroke->transform,
+                centre->x + h * (cosf(a1) + k * sinf(a1)), centre->y + h * (sinf(a1) - k * cosf(a1)));
+        d2d_point_transform(&b.point3, stroke->transform, centre->x + h * cosf(a1), centre->y + h * sinf(a1));
+        d2d_polyline_set_flatten_cubic(stroke->out, &p0, &b, stroke->tolerance);
+        if (FAILED(stroke->out->hr))
+            return false;
+    }
+
+    return true;
+}
+
+static bool d2d_stroke_add_segment(struct d2d_stroke *stroke, const D2D1_POINT_2F *p0,
+        const D2D1_POINT_2F *p1, const D2D1_POINT_2F *n)
+{
+    float h = stroke->half_width;
+
+    return d2d_stroke_begin(stroke)
+            && d2d_stroke_add_point(stroke, p0->x + n->x * h, p0->y + n->y * h)
+            && d2d_stroke_add_point(stroke, p1->x + n->x * h, p1->y + n->y * h)
+            && d2d_stroke_add_point(stroke, p1->x - n->x * h, p1->y - n->y * h)
+            && d2d_stroke_add_point(stroke, p0->x - n->x * h, p0->y - n->y * h)
+            && (d2d_stroke_end(stroke), true);
+}
+
+/* The cap at "p" of a segment leaving it in direction "d". */
+static bool d2d_stroke_add_cap(struct d2d_stroke *stroke, D2D1_CAP_STYLE cap,
+        const D2D1_POINT_2F *p, const D2D1_POINT_2F *d)
+{
+    float h = stroke->half_width, nx = -d->y, ny = d->x;
+
+    switch (cap)
+    {
+        case D2D1_CAP_STYLE_SQUARE:
+            return d2d_stroke_begin(stroke)
+                    && d2d_stroke_add_point(stroke, p->x + nx * h, p->y + ny * h)
+                    && d2d_stroke_add_point(stroke, p->x + nx * h - d->x * h, p->y + ny * h - d->y * h)
+                    && d2d_stroke_add_point(stroke, p->x - nx * h - d->x * h, p->y - ny * h - d->y * h)
+                    && d2d_stroke_add_point(stroke, p->x - nx * h, p->y - ny * h)
+                    && (d2d_stroke_end(stroke), true);
+
+        case D2D1_CAP_STYLE_ROUND:
+            /* n is d turned a quarter turn, so a further half turn from n
+             * passes through -d. */
+            return d2d_stroke_begin(stroke)
+                    && d2d_stroke_add_point(stroke, p->x + nx * h, p->y + ny * h)
+                    && d2d_stroke_add_arc(stroke, p, atan2f(ny, nx), M_PI)
+                    && (d2d_stroke_end(stroke), true);
+
+        case D2D1_CAP_STYLE_TRIANGLE:
+            return d2d_stroke_begin(stroke)
+                    && d2d_stroke_add_point(stroke, p->x + nx * h, p->y + ny * h)
+                    && d2d_stroke_add_point(stroke, p->x - d->x * h, p->y - d->y * h)
+                    && d2d_stroke_add_point(stroke, p->x - nx * h, p->y - ny * h)
+                    && (d2d_stroke_end(stroke), true);
+
+        default:
+            return true;
+    }
+}
+
+/* The join at "p" between a segment arriving in direction "d0" and one
+ * leaving in direction "d1". The segments themselves cover the inside of
+ * the turn; this fills the wedge on the outside. */
+static bool d2d_stroke_add_join(struct d2d_stroke *stroke, const D2D1_POINT_2F *p,
+        const D2D1_POINT_2F *d0, const D2D1_POINT_2F *d1)
+{
+    float h = stroke->half_width, cross, dot, s, l, ratio;
+    D2D1_POINT_2F n0, n1, a, b, m;
+    D2D1_LINE_JOIN join;
+
+    cross = d0->x * d1->y - d0->y * d1->x;
+    dot = d2d_point_dot(d0, d1);
+    if (fabsf(cross) < 1e-6f)
+    {
+        if (dot > 0.0f)
+            return true;
+        /* The path doubles back on itself. A miter would be infinitely
+         * long and a bevel has no area, so only a round join shows: the
+         * half disc beyond the vertex, which is what a round cap of the
+         * arriving segment would draw. */
+        if (stroke->style->lineJoin != D2D1_LINE_JOIN_ROUND)
+            return true;
+        d2d_point_set(&n0, -d0->x, -d0->y);
+        return d2d_stroke_add_cap(stroke, D2D1_CAP_STYLE_ROUND, p, &n0);
+    }
+
+    /* Normals point to the left of the direction of travel, which is the
+     * inside of a left turn. */
+    s = cross > 0.0f ? -1.0f : 1.0f;
+    d2d_point_set(&n0, -d0->y * s, d0->x * s);
+    d2d_point_set(&n1, -d1->y * s, d1->x * s);
+    d2d_point_set(&a, p->x + n0.x * h, p->y + n0.y * h);
+    d2d_point_set(&b, p->x + n1.x * h, p->y + n1.y * h);
+
+    join = stroke->style->lineJoin;
+    if (join == D2D1_LINE_JOIN_MITER || join == D2D1_LINE_JOIN_MITER_OR_BEVEL)
+    {
+        float limit = max(stroke->style->miterLimit, 1.0f);
+
+        /* The miter point lies along n0 + n1, at h / cos(θ/2) from p,
+         * θ being the angle between the normals. The miter limit is the
+         * ratio of that distance to h. */
+        m.x = n0.x + n1.x;
+        m.y = n0.y + n1.y;
+        l = d2d_point_dot(&m, &m);
+        ratio = l > 1e-12f ? 2.0f / sqrtf(l) : INFINITY;
+        if (ratio <= limit)
+        {
+            m.x = p->x + m.x * 2.0f * h / l;
+            m.y = p->y + m.y * 2.0f * h / l;
+            return d2d_stroke_begin(stroke)
+                    && d2d_stroke_add_point(stroke, p->x, p->y)
+                    && d2d_stroke_add_point(stroke, a.x, a.y)
+                    && d2d_stroke_add_point(stroke, m.x, m.y)
+                    && d2d_stroke_add_point(stroke, b.x, b.y)
+                    && (d2d_stroke_end(stroke), true);
+        }
+        if (join == D2D1_LINE_JOIN_MITER && ratio != INFINITY)
+        {
+            /* Beyond the limit a plain miter is cut off at the limit, by a
+             * line perpendicular to the bisector. a and b lie at
+             * h·cos(θ/2) along the bisector, the miter point at ratio·h. */
+            float f = (limit - sqrtf(l) / 2.0f) / (ratio - sqrtf(l) / 2.0f);
+            D2D1_POINT_2F a2, b2;
+
+            m.x = p->x + m.x * 2.0f * h / l;
+            m.y = p->y + m.y * 2.0f * h / l;
+            d2d_point_lerp(&a2, &a, &m, f);
+            d2d_point_lerp(&b2, &b, &m, f);
+            return d2d_stroke_begin(stroke)
+                    && d2d_stroke_add_point(stroke, p->x, p->y)
+                    && d2d_stroke_add_point(stroke, a.x, a.y)
+                    && d2d_stroke_add_point(stroke, a2.x, a2.y)
+                    && d2d_stroke_add_point(stroke, b2.x, b2.y)
+                    && d2d_stroke_add_point(stroke, b.x, b.y)
+                    && (d2d_stroke_end(stroke), true);
+        }
+        join = D2D1_LINE_JOIN_BEVEL;
+    }
+
+    if (join == D2D1_LINE_JOIN_ROUND)
+    {
+        float from = atan2f(n0.y, n0.x), sweep = atan2f(n1.y, n1.x) - from;
+
+        if (sweep > M_PI)
+            sweep -= 2.0f * M_PI;
+        else if (sweep < -M_PI)
+            sweep += 2.0f * M_PI;
+
+        return d2d_stroke_begin(stroke)
+                && d2d_stroke_add_point(stroke, p->x, p->y)
+                && d2d_stroke_add_point(stroke, a.x, a.y)
+                && d2d_stroke_add_arc(stroke, p, from, sweep)
+                && (d2d_stroke_end(stroke), true);
+    }
+
+    return d2d_stroke_begin(stroke)
+            && d2d_stroke_add_point(stroke, p->x, p->y)
+            && d2d_stroke_add_point(stroke, a.x, a.y)
+            && d2d_stroke_add_point(stroke, b.x, b.y)
+            && (d2d_stroke_end(stroke), true);
+}
+
+/* An open polyline takes "start_cap" and "end_cap" at its ends. */
+static bool d2d_stroke_add_polyline(struct d2d_stroke *stroke, const D2D1_POINT_2F *src, size_t src_count,
+        bool closed, D2D1_CAP_STYLE start_cap, D2D1_CAP_STYLE end_cap)
+{
+    D2D1_POINT_2F *points, d, d_prev = {0.0f, 0.0f}, d_first = {0.0f, 0.0f}, n;
+    size_t i, count = 0;
+    bool ret = false;
+    float l;
+
+    if (!(points = malloc(src_count * sizeof(*points))))
+        return false;
+
+    /* Repeated points have no direction; drop them. */
+    for (i = 0; i < src_count; ++i)
+    {
+        if (count && points[count - 1].x == src[i].x && points[count - 1].y == src[i].y)
+            continue;
+        points[count++] = src[i];
+    }
+    if (closed && count > 1 && points[count - 1].x == points[0].x && points[count - 1].y == points[0].y)
+        --count;
+
+    if (count == 1 && !closed)
+    {
+        /* A dot has no direction. A round cap is a disc regardless, and a
+         * square cap is taken to be axis-aligned. */
+        if (start_cap == D2D1_CAP_STYLE_ROUND)
+        {
+            ret = d2d_stroke_begin(stroke)
+                    && d2d_stroke_add_arc(stroke, &points[0], 0.0f, 2.0f * M_PI)
+                    && (d2d_stroke_end(stroke), true);
+        }
+        else if (start_cap == D2D1_CAP_STYLE_SQUARE)
+        {
+            d2d_point_set(&d, 1.0f, 0.0f);
+            ret = d2d_stroke_add_cap(stroke, D2D1_CAP_STYLE_SQUARE, &points[0], &d);
+            d2d_point_set(&d, -1.0f, 0.0f);
+            ret = ret && d2d_stroke_add_cap(stroke, D2D1_CAP_STYLE_SQUARE, &points[0], &d);
+        }
+        else
+        {
+            ret = true;
+        }
+        goto done;
+    }
+    if (count < 2)
+    {
+        ret = true;
+        goto done;
+    }
+
+    for (i = 0; i + 1 < count || (closed && i < count); ++i)
+    {
+        const D2D1_POINT_2F *p0 = &points[i], *p1 = &points[(i + 1) % count];
+
+        d2d_point_subtract(&d, p1, p0);
+        l = sqrtf(d2d_point_dot(&d, &d));
+        d.x /= l;
+        d.y /= l;
+        d2d_point_set(&n, -d.y, d.x);
+
+        if (!d2d_stroke_add_segment(stroke, p0, p1, &n))
+            goto done;
+
+        if (i)
+        {
+            if (!d2d_stroke_add_join(stroke, p0, &d_prev, &d))
+                goto done;
+        }
+        else
+        {
+            d_first = d;
+            if (!closed && !d2d_stroke_add_cap(stroke, start_cap, p0, &d))
+                goto done;
+        }
+        d_prev = d;
+    }
+
+    if (closed)
+        ret = d2d_stroke_add_join(stroke, &points[0], &d_prev, &d_first);
+    else
+    {
+        d2d_point_set(&d, -d_prev.x, -d_prev.y);
+        ret = d2d_stroke_add_cap(stroke, end_cap, &points[count - 1], &d);
+    }
+
+done:
+    free(points);
+    return ret;
+}
+
+struct d2d_dash
+{
+    D2D1_POINT_2F *points;
+    size_t count, size;
+};
+
+static bool d2d_dash_add_point(struct d2d_dash *dash, const D2D1_POINT_2F *p)
+{
+    if (!d2d_array_reserve((void **)&dash->points, &dash->size, dash->count + 1, sizeof(*dash->points)))
+        return false;
+    dash->points[dash->count++] = *p;
+    return true;
+}
+
+/* Strokes one dash. A dash of no length is drawn as its two caps, facing
+ * along "d", so that a flat cap leaves nothing. */
+static bool d2d_stroke_add_dash(struct d2d_stroke *stroke, const struct d2d_dash *dash,
+        const D2D1_POINT_2F *d, D2D1_CAP_STYLE start_cap, D2D1_CAP_STYLE end_cap)
+{
+    D2D1_POINT_2F back;
+    size_t i;
+
+    for (i = 1; i < dash->count; ++i)
+    {
+        if (dash->points[i].x != dash->points[0].x || dash->points[i].y != dash->points[0].y)
+            return d2d_stroke_add_polyline(stroke, dash->points, dash->count, false, start_cap, end_cap);
+    }
+
+    d2d_point_set(&back, -d->x, -d->y);
+    return d2d_stroke_add_cap(stroke, start_cap, &dash->points[0], d)
+            && d2d_stroke_add_cap(stroke, end_cap, &dash->points[0], &back);
+}
+
+/* Strokes the dashes of a polyline. The pattern is in units of the stroke
+ * width; a pattern with an odd number of entries repeats with "on" and
+ * "off" swapped. It starts afresh on each figure, at "dashOffset" into the
+ * pattern. Dashes take the dash cap, except at the ends of an open figure,
+ * which keep the figure's own caps. On a closed figure, a dash running
+ * through the start point is one dash. */
+static bool d2d_stroke_add_dashed_polyline(struct d2d_stroke *stroke, const D2D1_POINT_2F *points,
+        size_t count, bool closed)
+{
+    const D2D1_STROKE_STYLE_PROPERTIES1 *style = stroke->style;
+    float width = stroke->half_width * 2.0f, period = 0.0f, pos, remaining, l, t;
+    D2D1_POINT_2F d = {1.0f, 0.0f}, first_d = {1.0f, 0.0f}, q;
+    struct d2d_dash dash = {0}, first = {0};
+    unsigned int i, index, pattern_count;
+    bool on, at_start, ret = false;
+    D2D1_CAP_STYLE start_cap;
+    size_t s;
+
+    pattern_count = stroke->dash_count & 1 ? stroke->dash_count * 2 : stroke->dash_count;
+    for (i = 0; i < pattern_count; ++i)
+        period += stroke->dashes[i % stroke->dash_count] * width;
+    if (!(period > 0.0f))
+        return d2d_stroke_add_polyline(stroke, points, count, closed, style->startCap, style->endCap);
+
+    pos = fmodf(style->dashOffset * width, period);
+    if (pos < 0.0f)
+        pos += period;
+    for (index = 0;; index = (index + 1) % pattern_count)
+    {
+        remaining = stroke->dashes[index % stroke->dash_count] * width;
+        if (pos < remaining || (!pos && !remaining))
+            break;
+        pos -= remaining;
+    }
+    remaining -= pos;
+    on = !(index & 1);
+    at_start = on;
+    if (on && !d2d_dash_add_point(&dash, &points[0]))
+        goto done;
+
+    for (s = 0; s + 1 < count || (closed && s < count); ++s)
+    {
+        const D2D1_POINT_2F *p0 = &points[s], *p1 = &points[(s + 1) % count];
+
+        d2d_point_subtract(&d, p1, p0);
+        if (!(l = sqrtf(d2d_point_dot(&d, &d))))
+            continue;
+        d.x /= l;
+        d.y /= l;
+
+        /* A change at the end of a segment is made at the start of the
+         * next one, so a dash reaching the end of an open figure keeps
+         * the end cap. */
+        for (t = 0.0f; remaining < l - t;)
+        {
+            t += remaining;
+            d2d_point_set(&q, p0->x + d.x * t, p0->y + d.y * t);
+            if (on)
+            {
+                if (!d2d_dash_add_point(&dash, &q))
+                    goto done;
+                if (at_start && closed)
+                {
+                    /* Kept, to be joined to a dash that runs to the end. */
+                    first = dash;
+                    first_d = d;
+                    memset(&dash, 0, sizeof(dash));
+                }
+                else
+                {
+                    start_cap = at_start ? style->startCap : style->dashCap;
+                    if (!d2d_stroke_add_dash(stroke, &dash, &d, start_cap, style->dashCap))
+                        goto done;
+                    dash.count = 0;
+                }
+                at_start = false;
+            }
+            index = (index + 1) % pattern_count;
+            remaining = stroke->dashes[index % stroke->dash_count] * width;
+            on = !on;
+            if (on && !d2d_dash_add_point(&dash, &q))
+                goto done;
+        }
+        remaining -= l - t;
+        if (on && !d2d_dash_add_point(&dash, p1))
+            goto done;
+    }
+
+    /* A dash ending exactly at the start of a closed figure is not joined
+     * to the first one. */
+    if (on && closed && !remaining && !at_start)
+    {
+        if (!d2d_stroke_add_dash(stroke, &dash, &d, style->dashCap, style->dashCap))
+            goto done;
+        on = false;
+    }
+    if (on)
+    {
+        if (at_start)
+        {
+            /* The pattern stays on for the whole figure. */
+            ret = d2d_stroke_add_polyline(stroke, points, count, closed, style->startCap, style->endCap);
+            goto done;
+        }
+        for (s = 1; s < first.count; ++s)
+        {
+            if (!d2d_dash_add_point(&dash, &first.points[s]))
+                goto done;
+        }
+        if (first.count)
+            d = first_d;
+        first.count = 0;
+        if (!d2d_stroke_add_dash(stroke, &dash, &d, style->dashCap, closed ? style->dashCap : style->endCap))
+            goto done;
+    }
+    if (first.count && !d2d_stroke_add_dash(stroke, &first, &first_d, style->dashCap, style->dashCap))
+        goto done;
+    ret = true;
+
+done:
+    free(first.points);
+    free(dash.points);
+    return ret;
+}
+
+/* Builds the outline of a stroke along the polylines as a set of overlapping
+ * polygons; their non-zero fill is the stroke. The polylines are in the
+ * space the stroke width applies in, and the result is transformed into
+ * the space it is rasterized in, where "tolerance" applies. */
+HRESULT d2d_polyline_set_stroke(const struct d2d_polyline_set *path, float width,
+        ID2D1StrokeStyle *stroke_style, const D2D1_MATRIX_3X2_F *transform,
+        float tolerance, struct d2d_polyline_set *out)
+{
+    const struct d2d_stroke_style *style_impl = unsafe_impl_from_ID2D1StrokeStyle(stroke_style);
+    struct d2d_stroke stroke;
+    bool dashed;
+    size_t i;
+
+    out->fill_mode = D2D1_FILL_MODE_WINDING;
+    if (width <= 0.0f)
+        return S_OK;
+
+    stroke.out = out;
+    stroke.style = d2d_stroke_style_properties(stroke_style);
+    stroke.dashes = style_impl ? style_impl->dashes : NULL;
+    stroke.dash_count = style_impl ? style_impl->dash_count : 0;
+    stroke.transform = transform;
+    stroke.half_width = width * 0.5f;
+    stroke.tolerance = tolerance;
+
+    dashed = stroke.style->dashStyle != D2D1_DASH_STYLE_SOLID && stroke.dash_count;
+    for (i = 0; i < path->line_count; ++i)
+    {
+        const struct d2d_polyline *line = &path->lines[i];
+        const D2D1_POINT_2F *points = &path->points[line->start];
+
+        if (!(dashed ? d2d_stroke_add_dashed_polyline(&stroke, points, line->count, line->closed)
+                : d2d_stroke_add_polyline(&stroke, points, line->count, line->closed,
+                stroke.style->startCap, stroke.style->endCap)))
+            return FAILED(out->hr) ? out->hr : E_OUTOFMEMORY;
+    }
+
+    return S_OK;
+}
+
+/* Coordinates are kept in sixteenths of a pixel, relative to the mask's
+ * origin, so that sample tests are exact. */
+struct d2d_raster_edge
+{
+    LONGLONG x0, y0, x1, y1;
+    int dir;
+};
+
+struct d2d_raster_crossing
+{
+    LONGLONG num, den;
+    double x;
+    int dir;
+};
+
+static int __cdecl d2d_raster_edge_compare(const void *a, const void *b)
+{
+    const struct d2d_raster_edge *e0 = a, *e1 = b;
+
+    if (e0->y0 < e1->y0)
+        return -1;
+    return e0->y0 > e1->y0;
+}
+
+static bool d2d_raster_inside(D2D1_FILL_MODE fill_mode, int winding)
+{
+    if (fill_mode == D2D1_FILL_MODE_WINDING)
+        return !!winding;
+    return winding & 1;
+}
+
+/* ⌈a / b⌉ for b > 0. */
+static LONGLONG d2d_ceil_div(LONGLONG a, LONGLONG b)
+{
+    LONGLONG q = a / b;
+
+    if (a % b > 0)
+        ++q;
+    return q;
+}
+
+/* ⌊a / b⌋ for b > 0. */
+static LONGLONG d2d_floor_div(LONGLONG a, LONGLONG b)
+{
+    LONGLONG q = a / b;
+
+    if (a % b < 0)
+        --q;
+    return q;
+}
+
+/* Adds the samples of one sub-scanline between the crossings a and b to the
+ * row's counts. Samples lie at odd sixteenths; one at s is inside when
+ * a <= s < b. Whole pixels inside the span are recorded as a running
+ * difference and summed when the row is resolved. */
+static void d2d_raster_add_span(int *acc, int *diff, unsigned int width,
+        const struct d2d_raster_crossing *a, const struct d2d_raster_crossing *b)
+{
+    LONGLONG ka, kb;
+    int pa, pb;
+
+    /* The first sample index k with 2k + 1 >= a, and the first with
+     * 2k + 1 >= b. */
+    ka = d2d_ceil_div(d2d_ceil_div(a->num, a->den) - 1, 2);
+    kb = d2d_floor_div(d2d_ceil_div(b->num, b->den), 2);
+    ka = min(max(ka, 0), (LONGLONG)width * D2D_COVERAGE_GRID);
+    kb = min(max(kb, 0), (LONGLONG)width * D2D_COVERAGE_GRID);
+    if (ka >= kb)
+        return;
+
+    pa = ka / D2D_COVERAGE_GRID;
+    pb = (kb - 1) / D2D_COVERAGE_GRID;
+    if (pa == pb)
+    {
+        acc[pa] += kb - ka;
+        return;
+    }
+
+    acc[pa] += D2D_COVERAGE_GRID - ka % D2D_COVERAGE_GRID;
+    acc[pb] += (kb - 1) % D2D_COVERAGE_GRID + 1;
+    if (pb > pa + 1)
+    {
+        diff[pa + 1] += D2D_COVERAGE_GRID;
+        diff[pb] -= D2D_COVERAGE_GRID;
+    }
+}
+
+/* Snaps a coordinate to sixteenths, within a range that keeps the products
+ * below representable. */
+static LONGLONG d2d_raster_coordinate(float v)
+{
+    v = ceilf(v * D2D_COVERAGE_SNAP);
+    if (!(v > -1073741824.0f))
+        return -1073741824;
+    if (!(v < 1073741824.0f))
+        return 1073741824;
+    return v;
+}
+
+/* Rasterizes the polygons into an 8-bit coverage mask covering the part of
+ * their bounds inside "clip". A mask of zero width or height means nothing
+ * is covered. */
+HRESULT d2d_polyline_set_rasterize(const struct d2d_polyline_set *set, const RECT *clip,
+        struct d2d_coverage_mask *mask)
+{
+    struct d2d_raster_crossing *crossings = NULL, span_start = {0};
+    struct d2d_raster_edge *edges = NULL;
+    size_t i, j, edge_count = 0, active_count, crossing_count, next;
+    LONGLONG xmin = LLONG_MAX, ymin = LLONG_MAX, xmax = LLONG_MIN, ymax = LLONG_MIN, x0, y0, x1, y1;
+    unsigned int *active = NULL;
+    int *acc = NULL, *diff = NULL;
+    unsigned int width, height, row, sub, x;
+    HRESULT hr = E_OUTOFMEMORY;
+    int winding, run;
+
+    memset(mask, 0, sizeof(*mask));
+
+    for (i = 0; i < set->line_count; ++i)
+    {
+        if (!set->lines[i].hollow && set->lines[i].count >= 2)
+            edge_count += set->lines[i].count;
+    }
+    if (!edge_count)
+        return S_OK;
+
+    if (!(edges = malloc(edge_count * sizeof(*edges))))
+        return E_OUTOFMEMORY;
+
+    for (i = 0, edge_count = 0; i < set->line_count; ++i)
+    {
+        const struct d2d_polyline *line = &set->lines[i];
+        const D2D1_POINT_2F *points = &set->points[line->start];
+
+        if (line->hollow || line->count < 2)
+            continue;
+
+        for (j = 0; j < line->count; ++j)
+        {
+            const D2D1_POINT_2F *pa = &points[j], *pb = &points[(j + 1) % line->count];
+            struct d2d_raster_edge *edge = &edges[edge_count];
+            LONGLONG ax, ay, bx, by;
+
+            if (isnan(pa->x) || isnan(pa->y) || isnan(pb->x) || isnan(pb->y))
+                continue;
+
+            ax = d2d_raster_coordinate(pa->x);
+            ay = d2d_raster_coordinate(pa->y);
+            bx = d2d_raster_coordinate(pb->x);
+            by = d2d_raster_coordinate(pb->y);
+            xmin = min(xmin, ax);
+            xmax = max(xmax, ax);
+            ymin = min(ymin, ay);
+            ymax = max(ymax, ay);
+            if (ay == by)
+                continue;
+
+            if (ay < by)
+            {
+                edge->x0 = ax;
+                edge->y0 = ay;
+                edge->x1 = bx;
+                edge->y1 = by;
+                edge->dir = 1;
+            }
+            else
+            {
+                edge->x0 = bx;
+                edge->y0 = by;
+                edge->x1 = ax;
+                edge->y1 = ay;
+                edge->dir = -1;
+            }
+            ++edge_count;
+        }
+    }
+
+    if (!edge_count)
+    {
+        hr = S_OK;
+        goto done;
+    }
+
+    /* The bounds, in whole pixels, limited to the clip. */
+    x0 = max(clip->left, d2d_floor_div(xmin, D2D_COVERAGE_SNAP));
+    y0 = max(clip->top, d2d_floor_div(ymin, D2D_COVERAGE_SNAP));
+    x1 = min(clip->right, d2d_ceil_div(xmax, D2D_COVERAGE_SNAP));
+    y1 = min(clip->bottom, d2d_ceil_div(ymax, D2D_COVERAGE_SNAP));
+    if (x1 <= x0 || y1 <= y0)
+    {
+        hr = S_OK;
+        goto done;
+    }
+    width = x1 - x0;
+    height = y1 - y0;
+
+    for (i = 0; i < edge_count; ++i)
+    {
+        edges[i].x0 -= x0 * D2D_COVERAGE_SNAP;
+        edges[i].x1 -= x0 * D2D_COVERAGE_SNAP;
+        edges[i].y0 -= y0 * D2D_COVERAGE_SNAP;
+        edges[i].y1 -= y0 * D2D_COVERAGE_SNAP;
+    }
+
+    if (!(mask->data = malloc((size_t)width * height))
+            || !(acc = malloc(width * sizeof(*acc)))
+            || !(diff = malloc((width + 1) * sizeof(*diff)))
+            || !(active = malloc(edge_count * sizeof(*active)))
+            || !(crossings = malloc(edge_count * sizeof(*crossings))))
+        goto done;
+
+    qsort(edges, edge_count, sizeof(*edges), d2d_raster_edge_compare);
+
+    next = 0;
+    active_count = 0;
+    /* Edges above the mask are activated by the first sub-scanline, which
+     * is also where the ones ending above it are dropped. */
+    for (row = 0; row < height; ++row)
+    {
+        BYTE *dst = mask->data + (size_t)row * width;
+
+        memset(acc, 0, width * sizeof(*acc));
+        memset(diff, 0, (width + 1) * sizeof(*diff));
+
+        for (sub = 0; sub < D2D_COVERAGE_GRID; ++sub)
+        {
+            LONGLONG sy = (LONGLONG)row * D2D_COVERAGE_SNAP + 2 * sub + 1;
+
+            while (next < edge_count && edges[next].y0 <= sy)
+                active[active_count++] = next++;
+
+            crossing_count = 0;
+            for (i = 0; i < active_count;)
+            {
+                const struct d2d_raster_edge *edge = &edges[active[i]];
+                struct d2d_raster_crossing c;
+
+                if (edge->y1 <= sy)
+                {
+                    active[i] = active[--active_count];
+                    continue;
+                }
+
+                c.den = edge->y1 - edge->y0;
+                c.num = edge->x0 * c.den + (sy - edge->y0) * (edge->x1 - edge->x0);
+                c.x = (double)c.num / c.den;
+                c.dir = edge->dir;
+                for (j = crossing_count; j && crossings[j - 1].x > c.x; --j)
+                    crossings[j] = crossings[j - 1];
+                crossings[j] = c;
+                ++crossing_count;
+                ++i;
+            }
+
+            winding = 0;
+            for (i = 0; i < crossing_count; ++i)
+            {
+                bool was_inside = d2d_raster_inside(set->fill_mode, winding);
+
+                winding += crossings[i].dir;
+                if (d2d_raster_inside(set->fill_mode, winding) == was_inside)
+                    continue;
+                if (!was_inside)
+                    span_start = crossings[i];
+                else
+                    d2d_raster_add_span(acc, diff, width, &span_start, &crossings[i]);
+            }
+        }
+
+        for (x = 0, run = 0; x < width; ++x)
+        {
+            run += diff[x];
+            dst[x] = ((acc[x] + run) * 255 + 32) / 64;
+        }
+    }
+
+    mask->x = x0;
+    mask->y = y0;
+    mask->width = width;
+    mask->height = height;
+    hr = S_OK;
+
+done:
+    if (FAILED(hr))
+    {
+        free(mask->data);
+        mask->data = NULL;
+    }
+    free(crossings);
+    free(active);
+    free(diff);
+    free(acc);
+    free(edges);
+    return hr;
+}
+
+void d2d_coverage_mask_cleanup(struct d2d_coverage_mask *mask)
+{
+    free(mask->data);
+}
