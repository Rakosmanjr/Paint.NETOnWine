+/* A format the context can render to, whatever alpha mode it is paired
+ * with. */
+BOOL d2d_dxgi_format_supported(DXGI_FORMAT format)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(supported_formats); ++i)
+    {
+        if (supported_formats[i].format == format)
+            return TRUE;
+    }
+
+    return FALSE;
+}
