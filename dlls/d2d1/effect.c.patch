+/* A built-in effect that is a single per-pixel operation is expressed the
+ * same way an application would express it: one draw transform in the graph,
+ * with a pixel shader loaded into the effect context. The shader is compiled
+ * against the signature D2D gives effect shaders, so the renderer can run it
+ * without knowing anything about which effect it came from. */
+struct d2d_builtin_transform
+{
+    ID2D1DrawTransform ID2D1DrawTransform_iface;
+    LONG refcount;
+    GUID shader;
+    UINT32 input_count;
+    /* The properties block of the implementation object is handed to the
+     * shader as its constant buffer, so a built-in effect's shader declares
+     * a cbuffer matching its properties struct. Zero when there are none. */
+    const struct d2d_effect_impl *impl;
+    UINT32 cb_size;
+};
+
+static inline struct d2d_builtin_transform *impl_from_ID2D1DrawTransform(ID2D1DrawTransform *iface)
+{
+    return CONTAINING_RECORD(iface, struct d2d_builtin_transform, ID2D1DrawTransform_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_builtin_transform_QueryInterface(ID2D1DrawTransform *iface,
+        REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_ID2D1DrawTransform)
+            || IsEqualGUID(iid, &IID_ID2D1Transform)
+            || IsEqualGUID(iid, &IID_ID2D1TransformNode)
+            || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        *out = iface;
+        ID2D1DrawTransform_AddRef(iface);
+        return S_OK;
+    }
+
+    WARN("Unsupported interface %s.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_builtin_transform_AddRef(ID2D1DrawTransform *iface)
+{
+    struct d2d_builtin_transform *transform = impl_from_ID2D1DrawTransform(iface);
+
+    return InterlockedIncrement(&transform->refcount);
+}
+
+static ULONG STDMETHODCALLTYPE d2d_builtin_transform_Release(ID2D1DrawTransform *iface)
+{
+    struct d2d_builtin_transform *transform = impl_from_ID2D1DrawTransform(iface);
+    ULONG refcount = InterlockedDecrement(&transform->refcount);
+
+    if (!refcount)
+        free(transform);
+
+    return refcount;
+}
+
+static UINT32 STDMETHODCALLTYPE d2d_builtin_transform_GetInputCount(ID2D1DrawTransform *iface)
+{
+    return impl_from_ID2D1DrawTransform(iface)->input_count;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_builtin_transform_MapOutputRectToInputRects(
+        ID2D1DrawTransform *iface, const D2D1_RECT_L *output_rect, D2D1_RECT_L *input_rects,
+        UINT32 input_rect_count)
+{
+    UINT32 i;
+
+    if (input_rect_count != impl_from_ID2D1DrawTransform(iface)->input_count)
+        return E_INVALIDARG;
+
+    /* Per-pixel: each output pixel reads the input pixels under it. */
+    for (i = 0; i < input_rect_count; ++i)
+        input_rects[i] = *output_rect;
+
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_builtin_transform_MapInputRectsToOutputRect(
+        ID2D1DrawTransform *iface, const D2D1_RECT_L *input_rects,
+        const D2D1_RECT_L *input_opaque_subrects, UINT32 input_rect_count,
+        D2D1_RECT_L *output_rect, D2D1_RECT_L *output_opaque_subrect)
+{
+    UINT32 i;
+
+    if (input_rect_count != impl_from_ID2D1DrawTransform(iface)->input_count)
+        return E_INVALIDARG;
+
+    if (!input_rect_count)
+    {
+        memset(output_rect, 0, sizeof(*output_rect));
+        memset(output_opaque_subrect, 0, sizeof(*output_opaque_subrect));
+        return S_OK;
+    }
+
+    /* Every input contributes, so the output is their union. */
+    *output_rect = input_rects[0];
+    for (i = 1; i < input_rect_count; ++i)
+    {
+        output_rect->left = min(output_rect->left, input_rects[i].left);
+        output_rect->top = min(output_rect->top, input_rects[i].top);
+        output_rect->right = max(output_rect->right, input_rects[i].right);
+        output_rect->bottom = max(output_rect->bottom, input_rects[i].bottom);
+    }
+    *output_opaque_subrect = input_opaque_subrects[0];
+
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_builtin_transform_MapInvalidRect(ID2D1DrawTransform *iface,
+        UINT32 index, D2D1_RECT_L invalid_input_rect, D2D1_RECT_L *invalid_output_rect)
+{
+    if (index)
+        return E_INVALIDARG;
+
+    *invalid_output_rect = invalid_input_rect;
+
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_builtin_transform_SetDrawInfo(ID2D1DrawTransform *iface,
+        ID2D1DrawInfo *draw_info)
+{
+    struct d2d_builtin_transform *transform = impl_from_ID2D1DrawTransform(iface);
+    HRESULT hr;
+
+    if (FAILED(hr = ID2D1DrawInfo_SetPixelShader(draw_info, &transform->shader, 0)))
+        return hr;
+
+    if (transform->cb_size)
+        hr = ID2D1DrawInfo_SetPixelShaderConstantBuffer(draw_info,
+                (const BYTE *)(transform->impl + 1), transform->cb_size);
+
+    return hr;
+}
