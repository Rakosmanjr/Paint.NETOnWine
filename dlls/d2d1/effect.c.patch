+/* Compile the shader if this is the first effect of its kind on the context,
+ * hand it to the effect context, and make it the graph's only node. */
+static HRESULT d2d_builtin_effect_init_full(ID2D1EffectImpl *iface, ID2D1EffectContext *context,
+        ID2D1TransformGraph *graph, const GUID *shader_id, const char *hlsl,
+        UINT32 input_count, UINT32 cb_size)
+{
+    struct d2d_builtin_transform *transform;
+    ID3D10Blob *compiled, *errors = NULL;
+    HRESULT hr;
+
+    if (FAILED(hr = D3DCompile(hlsl, strlen(hlsl), "effect_ps", NULL, NULL,
+            "main", "ps_4_0", 0, 0, &compiled, &errors)))
+    {
+        WARN("Failed to compile the effect pixel shader, hr %#lx.\n", hr);
+        if (errors)
+        {
+            WARN("%s\n", (char *)ID3D10Blob_GetBufferPointer(errors));
+            ID3D10Blob_Release(errors);
+        }
+        return hr;
+    }
+    if (errors)
+        ID3D10Blob_Release(errors);
+
+    hr = ID2D1EffectContext_LoadPixelShader(context, shader_id,
+            ID3D10Blob_GetBufferPointer(compiled), ID3D10Blob_GetBufferSize(compiled));
+    ID3D10Blob_Release(compiled);
+    if (FAILED(hr))
+    {
+        WARN("Failed to load the effect pixel shader, hr %#lx.\n", hr);
+        return hr;
+    }
+
+    if (!(transform = calloc(1, sizeof(*transform))))
+        return E_OUTOFMEMORY;
+
+    transform->ID2D1DrawTransform_iface.lpVtbl = &d2d_builtin_transform_vtbl;
+    transform->refcount = 1;
+    transform->shader = *shader_id;
+    transform->input_count = input_count;
+    transform->cb_size = cb_size;
+    /* The graph is released before the implementation object, so the
+     * properties this points into outlive the transform. */
+    transform->impl = impl_from_ID2D1EffectImpl(iface);
+
+    hr = ID2D1TransformGraph_SetSingleTransformNode(graph,
+            (ID2D1TransformNode *)&transform->ID2D1DrawTransform_iface);
+    ID2D1DrawTransform_Release(&transform->ID2D1DrawTransform_iface);
+
+    return hr;
+}
