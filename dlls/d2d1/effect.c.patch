+/* The rect is in DIPs and may be infinite in any direction, so clamp rather
+ * than convert directly: converting an infinity to LONG is undefined. */
+static void d2d_crop_transform_get_rect(struct d2d_crop_transform *transform, D2D1_RECT_L *rect)
+{
+    const struct crop_properties *props = (const struct crop_properties *)(transform->impl + 1);
+
+    rect->left = props->rect.x <= (float)LONG_MIN ? LONG_MIN :
+            props->rect.x >= (float)LONG_MAX ? LONG_MAX : (LONG)floorf(props->rect.x);
+    rect->top = props->rect.y <= (float)LONG_MIN ? LONG_MIN :
+            props->rect.y >= (float)LONG_MAX ? LONG_MAX : (LONG)floorf(props->rect.y);
+    rect->right = props->rect.z <= (float)LONG_MIN ? LONG_MIN :
+            props->rect.z >= (float)LONG_MAX ? LONG_MAX : (LONG)ceilf(props->rect.z);
+    rect->bottom = props->rect.w <= (float)LONG_MIN ? LONG_MIN :
+            props->rect.w >= (float)LONG_MAX ? LONG_MAX : (LONG)ceilf(props->rect.w);
+}
