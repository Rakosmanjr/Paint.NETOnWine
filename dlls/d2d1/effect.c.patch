+/* A node standing in for a whole nested effect, produced by
+ * CreateTransformNodeFromEffect(). It carries no operation of its own: the
+ * graph evaluator recognises it and evaluates the effect it wraps. */
+static inline struct d2d_transform *impl_from_effect_ID2D1TransformNode(ID2D1TransformNode *iface)
+{
+    return CONTAINING_RECORD(iface, struct d2d_transform, ID2D1TransformNode_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_effect_transform_QueryInterface(ID2D1TransformNode *iface,
+        REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_ID2D1TransformNode)
+            || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        *out = iface;
+        ID2D1TransformNode_AddRef(iface);
+        return S_OK;
+    }
+
+    WARN("Unsupported interface %s.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_effect_transform_AddRef(ID2D1TransformNode *iface)
+{
+    struct d2d_transform *transform = impl_from_effect_ID2D1TransformNode(iface);
+    ULONG refcount = InterlockedIncrement(&transform->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", iface, refcount);
+
+    return refcount;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_effect_transform_Release(ID2D1TransformNode *iface)
+{
+    struct d2d_transform *transform = impl_from_effect_ID2D1TransformNode(iface);
+    ULONG refcount = InterlockedDecrement(&transform->refcount);
+
+    TRACE("%p decreasing refcount to %lu.\n", iface, refcount);
+
+    if (!refcount)
+    {
+        if (transform->effect)
+            ID2D1Effect_Release(transform->effect);
+        free(transform);
+    }
+
+    return refcount;
+}
+
+static UINT32 STDMETHODCALLTYPE d2d_effect_transform_GetInputCount(ID2D1TransformNode *iface)
+{
+    struct d2d_transform *transform = impl_from_effect_ID2D1TransformNode(iface);
+
+    TRACE("iface %p.\n", iface);
+
+    return transform->input_count;
+}
+
+static const ID2D1TransformNodeVtbl d2d_effect_transform_vtbl =
+{
+    d2d_effect_transform_QueryInterface,
+    d2d_effect_transform_AddRef,
+    d2d_effect_transform_Release,
+    d2d_effect_transform_GetInputCount,
+};
+
+static HRESULT d2d_effect_transform_create(ID2D1Effect *effect, ID2D1TransformNode **node)
+{
+    struct d2d_transform *object;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+
+    object->ID2D1TransformNode_iface.lpVtbl = &d2d_effect_transform_vtbl;
+    object->refcount = 1;
+    object->effect = effect;
+    object->input_count = ID2D1Effect_GetInputCount(effect);
+    ID2D1Effect_AddRef(effect);
+
+    *node = &object->ID2D1TransformNode_iface;
+
+    return S_OK;
+}
+
+ID2D1Effect *d2d_transform_node_get_effect(ID2D1TransformNode *node)
+{
+    if (!node || node->lpVtbl != &d2d_effect_transform_vtbl)
+        return NULL;
+    return impl_from_effect_ID2D1TransformNode(node)->effect;
+}
