+static void colour_matrix_multiply(float out[3][3], const float a[3][3], const float b[3][3])
+{
+    float r[3][3];
+    unsigned int i, j, k;
+
+    for (i = 0; i < 3; ++i)
+        for (j = 0; j < 3; ++j)
+            for (r[i][j] = 0.0f, k = 0; k < 3; ++k)
+                r[i][j] += a[i][k] * b[k][j];
+    memcpy(out, r, sizeof(r));
+}
+
+static BOOL colour_matrix_invert(float out[3][3], const float m[3][3])
+{
+    float det, r[3][3];
+    unsigned int i, j;
+
+    r[0][0] = m[1][1] * m[2][2] - m[1][2] * m[2][1];
+    r[0][1] = m[0][2] * m[2][1] - m[0][1] * m[2][2];
+    r[0][2] = m[0][1] * m[1][2] - m[0][2] * m[1][1];
+    r[1][0] = m[1][2] * m[2][0] - m[1][0] * m[2][2];
+    r[1][1] = m[0][0] * m[2][2] - m[0][2] * m[2][0];
+    r[1][2] = m[0][2] * m[1][0] - m[0][0] * m[1][2];
+    r[2][0] = m[1][0] * m[2][1] - m[1][1] * m[2][0];
+    r[2][1] = m[0][1] * m[2][0] - m[0][0] * m[2][1];
+    r[2][2] = m[0][0] * m[1][1] - m[0][1] * m[1][0];
+    det = m[0][0] * r[0][0] + m[0][1] * r[1][0] + m[0][2] * r[2][0];
+    if (fabsf(det) < 1e-8f)
+        return FALSE;
+    for (i = 0; i < 3; ++i)
+        for (j = 0; j < 3; ++j)
+            out[i][j] = r[i][j] / det;
+    return TRUE;
+}
+
+static float colour_curve_eval(const struct colour_curve *c, float x)
+{
+    if (x >= c->d)
+        return powf(max(c->a * x + c->b, 0.0f), c->g) + c->e;
+    return c->c * x + c->f;
+}
+
+static UINT32 icc_read32(const BYTE *p)
+{
+    return (p[0] << 24) | (p[1] << 16) | (p[2] << 8) | p[3];
+}
+
+static float icc_read_s15(const BYTE *p)
+{
+    return (INT32)icc_read32(p) / 65536.0f;
+}
+
+static const BYTE *icc_find_tag(const BYTE *profile, UINT32 size, const char *sig, UINT32 *tag_size)
+{
+    UINT32 count, i, offset, length;
+
+    if (size < 132)
+        return NULL;
+    count = icc_read32(profile + 128);
+    if (count > (size - 132) / 12)
+        return NULL;
+    for (i = 0; i < count; ++i)
+    {
+        const BYTE *entry = profile + 132 + 12 * i;
+
+        if (memcmp(entry, sig, 4))
+            continue;
+        offset = icc_read32(entry + 4);
+        length = icc_read32(entry + 8);
+        if (offset > size || length > size - offset || length < 12)
+            return NULL;
+        *tag_size = length;
+        return profile + offset;
+    }
+    return NULL;
+}
