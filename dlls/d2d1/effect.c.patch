+/* Emboss lights the image from one direction: the difference between the
+ * pixel ahead and the pixel behind along that direction becomes a signed
+ * offset about mid grey. The step is taken in texels, which the shader gets
+ * from the texture's own size rather than a constant. */
+static const char emboss_ps[] =
+    "cbuffer constants : register(b0)\n"
+    "{\n"
+    "    float height;\n"
+    "    float direction;\n"
+    "};\n"
+    "Texture2D InputTexture : register(t0);\n"
+    "SamplerState InputSampler : register(s0);\n"
+    "\n"
+    "float4 main(float4 clip : SV_POSITION, float4 scene : SCENE_POSITION,\n"
+    "        float4 uv : TEXCOORD0) : SV_TARGET\n"
+    "{\n"
+    "    float w, h;\n"
+    "    InputTexture.GetDimensions(w, h);\n"
+    "\n"
+    "    float rad = radians(direction);\n"
+    "    float2 step = float2(cos(rad) / max(w, 1.0f), -sin(rad) / max(h, 1.0f)) * height;\n"
+    "\n"
+    "    float4 ahead = InputTexture.Sample(InputSampler, uv.xy + step);\n"
+    "    float4 behind = InputTexture.Sample(InputSampler, uv.xy - step);\n"
+    "    float4 centre = InputTexture.Sample(InputSampler, uv.xy);\n"
+    "\n"
+    "    float3 a = ahead.a > 0.0f ? ahead.rgb / ahead.a : ahead.rgb;\n"
+    "    float3 b = behind.a > 0.0f ? behind.rgb / behind.a : behind.rgb;\n"
+    "    float3 rgb = saturate(0.5f + dot(a - b, float3(0.299f, 0.587f, 0.114f)));\n"
+    "\n"
+    "    return float4(rgb * centre.a, centre.a);\n"
+    "}\n";
