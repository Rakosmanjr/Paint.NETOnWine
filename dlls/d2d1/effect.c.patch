+/* D2D reports the bounds of an unbounded image as this, and an application
+ * that asks for the bounds of one gets it back as a float. */
+static void d2d_rect_l_set_infinite(D2D1_RECT_L *rect)
+{
+    rect->left = -INT_MAX;
+    rect->top = -INT_MAX;
+    rect->right = INT_MAX;
+    rect->bottom = INT_MAX;
+}
