+/* Fits a sampled curve with the parametric form: an sRGB-shaped curve when
+ * it is one, otherwise the pure power that is closest at its samples. */
+static void colour_curve_fit(const float *samples, UINT32 count, struct colour_curve *curve)
+{
+    float error, best_error = FLT_MAX, lo = 0.2f, hi = 5.0f, g1, g2, e1, e2;
+    const struct colour_curve *candidates[] = {&colour_curve_linear, &colour_curve_srgb};
+    struct colour_curve power = colour_curve_linear;
+    unsigned int i, j, k;
+
+    for (i = 0; i < ARRAY_SIZE(candidates); ++i)
+    {
+        for (error = 0.0f, j = 0; j < count; ++j)
+            error = max(error, fabsf(colour_curve_eval(candidates[i], j / (count - 1.0f)) - samples[j]));
+        if (error < best_error)
+        {
+            best_error = error;
+            *curve = *candidates[i];
+        }
+    }
+
+    for (k = 0; k < 60; ++k)
+    {
+        g1 = lo + (hi - lo) * 0.382f;
+        g2 = lo + (hi - lo) * 0.618f;
+        for (e1 = e2 = 0.0f, j = 0; j < count; ++j)
+        {
+            float x = j / (count - 1.0f);
+            e1 = max(e1, fabsf(powf(x, g1) - samples[j]));
+            e2 = max(e2, fabsf(powf(x, g2) - samples[j]));
+        }
+        if (e1 < e2)
+            hi = g2;
+        else
+            lo = g1;
+    }
+    power.g = (lo + hi) / 2.0f;
+    for (error = 0.0f, j = 0; j < count; ++j)
+        error = max(error, fabsf(powf(j / (count - 1.0f), power.g) - samples[j]));
+    if (error < best_error)
+    {
+        best_error = error;
+        *curve = power;
+    }
+
+    if (best_error > 1.0f / 255.0f)
+        FIXME("Tone curve approximated with an error of %.8e.\n", best_error);
+}
+
+static BOOL icc_parse_curve(const BYTE *tag, UINT32 size, struct colour_curve *curve)
+{
+    static const unsigned int para_counts[] = {1, 3, 4, 5, 7};
+    UINT32 count, type, i;
+    float p[7], *samples;
+
+    if (!memcmp(tag, "curv", 4))
+    {
+        count = icc_read32(tag + 8);
+        if (count > (size - 12) / 2)
+            return FALSE;
+        if (!count)
+        {
+            *curve = colour_curve_linear;
+            return TRUE;
+        }
+        if (count == 1)
+        {
+            *curve = colour_curve_linear;
+            curve->g = ((tag[12] << 8) | tag[13]) / 256.0f;
+            return TRUE;
+        }
+        if (!(samples = malloc(count * sizeof(*samples))))
+            return FALSE;
+        for (i = 0; i < count; ++i)
+            samples[i] = ((tag[12 + 2 * i] << 8) | tag[13 + 2 * i]) / 65535.0f;
+        colour_curve_fit(samples, count, curve);
+        free(samples);
+        return TRUE;
+    }
+
+    if (!memcmp(tag, "para", 4))
+    {
+        type = (tag[8] << 8) | tag[9];
+        if (type >= ARRAY_SIZE(para_counts) || size < 12 + 4 * para_counts[type])
+            return FALSE;
+        for (i = 0; i < para_counts[type]; ++i)
+            p[i] = icc_read_s15(tag + 12 + 4 * i);
+        *curve = colour_curve_linear;
+        curve->g = p[0];
+        switch (type)
+        {
+            case 0:
+                break;
+            case 1:
+            case 2:
+                curve->a = p[1];
+                curve->b = p[2];
+                curve->d = p[1] ? -p[2] / p[1] : 0.0f;
+                if (type == 2)
+                    curve->e = curve->f = p[3];
+                break;
+            case 3:
+            case 4:
+                curve->a = p[1];
+                curve->b = p[2];
+                curve->c = p[3];
+                curve->d = p[4];
+                if (type == 4)
+                {
+                    curve->e = p[5];
+                    curve->f = p[6];
+                }
+                break;
+        }
+        return TRUE;
+    }
+
+    return FALSE;
+}
 
