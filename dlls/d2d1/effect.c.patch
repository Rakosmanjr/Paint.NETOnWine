+static LONG d2d_offset_coordinate(LONG value, LONG offset)
+{
+    LONGLONG v = (LONGLONG)value + offset;
+
+    if (v < LONG_MIN)
+        return LONG_MIN;
+    if (v > LONG_MAX)
+        return LONG_MAX;
+    return v;
+}
+
+static void d2d_rect_l_offset(D2D1_RECT_L *rect, LONG x, LONG y)
+{
+    rect->left = d2d_offset_coordinate(rect->left, x);
+    rect->top = d2d_offset_coordinate(rect->top, y);
+    rect->right = d2d_offset_coordinate(rect->right, x);
+    rect->bottom = d2d_offset_coordinate(rect->bottom, y);
+}
+
+/* Offset and bounds adjustment transforms are not ID2D1Transforms, so they
+ * cannot be asked how they map rects; these supply that mapping. Both pass
+ * their input's pixels through unchanged. */
+BOOL d2d_transform_node_map_output_rect(ID2D1TransformNode *node,
+        const D2D1_RECT_L *output_rect, D2D1_RECT_L *input_rect)
+{
+    struct d2d_transform *transform = CONTAINING_RECORD(node, struct d2d_transform, ID2D1TransformNode_iface);
+
+    if (node->lpVtbl == (ID2D1TransformNodeVtbl *)&d2d_offset_transform_vtbl)
+    {
+        *input_rect = *output_rect;
+        d2d_rect_l_offset(input_rect, -transform->offset.x, -transform->offset.y);
+        return TRUE;
+    }
+
+    if (node->lpVtbl == (ID2D1TransformNodeVtbl *)&d2d_bounds_adjustment_transform_vtbl)
+    {
+        *input_rect = *output_rect;
+        return TRUE;
+    }
+
+    return FALSE;
+}
+
+/* How far a node that is not a draw transform moves its input. */
+BOOL d2d_transform_node_get_offset(ID2D1TransformNode *node, D2D1_POINT_2L *offset)
+{
+    struct d2d_transform *transform = CONTAINING_RECORD(node, struct d2d_transform, ID2D1TransformNode_iface);
+
+    if (node->lpVtbl == (ID2D1TransformNodeVtbl *)&d2d_offset_transform_vtbl)
+    {
+        *offset = transform->offset;
+        return TRUE;
+    }
+
+    if (node->lpVtbl == (ID2D1TransformNodeVtbl *)&d2d_bounds_adjustment_transform_vtbl)
+    {
+        offset->x = offset->y = 0;
+        return TRUE;
+    }
+
+    return FALSE;
+}
+
+BOOL d2d_transform_node_map_input_rect(ID2D1TransformNode *node,
+        const D2D1_RECT_L *input_rect, D2D1_RECT_L *output_rect)
+{
+    struct d2d_transform *transform = CONTAINING_RECORD(node, struct d2d_transform, ID2D1TransformNode_iface);
+
+    if (node->lpVtbl == (ID2D1TransformNodeVtbl *)&d2d_offset_transform_vtbl)
+    {
+        *output_rect = *input_rect;
+        d2d_rect_l_offset(output_rect, transform->offset.x, transform->offset.y);
+        return TRUE;
+    }
+
+    if (node->lpVtbl == (ID2D1TransformNodeVtbl *)&d2d_bounds_adjustment_transform_vtbl)
+    {
+        *output_rect = transform->bounds;
+        return TRUE;
+    }
+
+    return FALSE;
+}
