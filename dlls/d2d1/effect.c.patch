+
+/* Contrast pivots each channel about the midpoint. The slope is the
+ * straightforward reading of the property's -1..1 range; D2D's own curve is
+ * not documented precisely enough to reproduce, so this is an approximation.
+ * The work is done on unpremultiplied colour and premultiplied again after,
+ * since the adjustment is of colour rather than coverage. */
+static const char contrast_ps[] =
+    "cbuffer constants : register(b0)\n"
+    "{\n"
+    "    float contrast;\n"
+    "    int clamp_input;\n"
+    "};\n"
+    "Texture2D InputTexture : register(t0);\n"
+    "SamplerState InputSampler : register(s0);\n"
+    "\n"
+    "float4 main(float4 clip : SV_POSITION, float4 scene : SCENE_POSITION,\n"
+    "        float4 uv : TEXCOORD0) : SV_TARGET\n"
+    "{\n"
+    "    float4 colour = InputTexture.Sample(InputSampler, uv.xy);\n"
+    "    float3 rgb = colour.a > 0.0f ? colour.rgb / colour.a : colour.rgb;\n"
+    "    float slope = contrast > 0.0f ? 1.0f / max(1.0f - contrast, 1e-4f) : 1.0f + contrast;\n"
+    "\n"
+    "    if (clamp_input)\n"
+    "        rgb = saturate(rgb);\n"
+    "    rgb = saturate((rgb - 0.5f) * slope + 0.5f);\n"
+    "\n"
+    "    return float4(rgb * colour.a, colour.a);\n"
+    "}\n";
