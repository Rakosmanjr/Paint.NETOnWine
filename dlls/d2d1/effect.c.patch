+/* The rect is in DIPs and may be infinite in any direction, so clamp rather
+ * than convert directly: converting an infinity to LONG is undefined. */
+static void d2d_crop_transform_get_rect(struct d2d_crop_transform *transform, D2D1_RECT_L *rect)
+{
+    const struct crop_properties *props = (const struct crop_properties *)(transform->impl + 1);
+
+    rect->left = props->rect.x <= (float)LONG_MIN ? LONG_MIN :
+            props->rect.x >= (float)LONG_MAX ? LONG_MAX : (LONG)floorf(props->rect.x);
+    rect->top = props->rect.y <= (float)LONG_MIN ? LONG_MIN :
+            props->rect.y >= (float)LONG_MAX ? LONG_MAX : (LONG)floorf(props->rect.y);
+    rect->right = props->rect.z <= (float)LONG_MIN ? LONG_MIN :
+            props->rect.z >= (float)LONG_MAX ? LONG_MAX : (LONG)ceilf(props->rect.z);
+    rect->bottom = props->rect.w <= (float)LONG_MIN ? LONG_MIN :
+            props->rect.w >= (float)LONG_MAX ? LONG_MAX : (LONG)ceilf(props->rect.w);
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_crop_transform_MapOutputRectToInputRects(ID2D1Transform *iface,
+        const D2D1_RECT_L *output_rect, D2D1_RECT_L *input_rects, UINT32 input_rect_count)
+{
+    if (input_rect_count != 1)
+        return E_INVALIDARG;
+
+    input_rects[0] = *output_rect;
+
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_crop_transform_MapInputRectsToOutputRect(ID2D1Transform *iface,
+        const D2D1_RECT_L *input_rects, const D2D1_RECT_L *input_opaque_subrects,
+        UINT32 input_rect_count, D2D1_RECT_L *output_rect, D2D1_RECT_L *output_opaque_subrect)
+{
+    struct d2d_crop_transform *transform = impl_from_crop_ID2D1Transform(iface);
+    D2D1_RECT_L crop;
+
+    if (input_rect_count != 1)
+        return E_INVALIDARG;
+
+    d2d_crop_transform_get_rect(transform, &crop);
+
+    output_rect->left = max(input_rects[0].left, crop.left);
+    output_rect->top = max(input_rects[0].top, crop.top);
+    output_rect->right = min(input_rects[0].right, crop.right);
+    output_rect->bottom = min(input_rects[0].bottom, crop.bottom);
+
+    if (output_rect->right < output_rect->left)
+        output_rect->right = output_rect->left;
+    if (output_rect->bottom < output_rect->top)
+        output_rect->bottom = output_rect->top;
+
+    *output_opaque_subrect = *output_rect;
+
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_crop_transform_MapInvalidRect(ID2D1Transform *iface,
