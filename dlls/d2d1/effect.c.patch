     LONG refcount;
 
+    /* The transform a built-in effect put in its graph, kept so that the
+     * render info can be refreshed when the properties change. */
+    struct d2d_builtin_transform *transform;
+
     /* Followed by properties block, its size and format depends on particular effect. */
