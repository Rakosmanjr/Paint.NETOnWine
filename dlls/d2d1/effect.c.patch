+/* Curves are mirrored for negative values so that wide-gamut colour survives
+ * where it is not clipped. PQ values convert to and from nits / 80, the
+ * scale of scRGB. */
+static const char color_management_ps[] =
+    "struct curve\n"
+    "{\n"
+    "    float4 p0[3];\n"
+    "    float4 p1[3];\n"
+    "};\n"
+    "cbuffer constants : register(b0)\n"
+    "{\n"
+    "    int source_pq;\n"
+    "    int destination_pq;\n"
+    "    int clamp_source;\n"
+    "    int clamp_destination;\n"
+    "    int premultiplied;\n"
+    "    int passthrough;\n"
+    "    float2 pad;\n"
+    "    row_major float3x4 m;\n"
+    "    curve source;\n"
+    "    curve destination;\n"
+    "};\n"
+    "Texture2D InputTexture : register(t0);\n"
+    "SamplerState InputSampler : register(s0);\n"
+    "\n"
+    "static const float pq_m1 = 2610.0 / 16384.0, pq_m2 = 2523.0 / 4096.0 * 128.0;\n"
+    "static const float pq_c1 = 3424.0 / 4096.0, pq_c2 = 2413.0 / 4096.0 * 32.0;\n"
+    "static const float pq_c3 = 2392.0 / 4096.0 * 32.0;\n"
+    "\n"
+    "float decode_channel(float x, float4 p0, float4 p1)\n"
+    "{\n"
+    "    float a = abs(x);\n"
+    "    float y = a >= p1.x ? pow(max(p0.y * a + p0.z, 0.0), p0.x) + p1.y : p0.w * a + p1.z;\n"
+    "    return x < 0.0 ? -y : y;\n"
+    "}\n"
+    "\n"
+    "float encode_channel(float y, float4 p0, float4 p1)\n"
+    "{\n"
+    "    float a = abs(y), x;\n"
+    "    if (a >= p1.w)\n"
+    "        x = (pow(max(a - p1.y, 0.0), 1.0 / p0.x) - p0.z) / p0.y;\n"
+    "    else\n"
+    "        x = p0.w ? (a - p1.z) / p0.w : 0.0;\n"
+    "    return y < 0.0 ? -x : x;\n"
+    "}\n"
+    "\n"
+    "float3 pq_decode(float3 c)\n"
+    "{\n"
+    "    float3 p = pow(abs(c), 1.0 / pq_m2);\n"
+    "    return sign(c) * pow(max(p - pq_c1, 0.0) / (pq_c2 - pq_c3 * p), 1.0 / pq_m1) * (10000.0 / 80.0);\n"
+    "}\n"
+    "\n"
+    "float3 pq_encode(float3 c)\n"
+    "{\n"
+    "    float3 p = pow(max(c, 0.0) * (80.0 / 10000.0), pq_m1);\n"
+    "    return pow((pq_c1 + pq_c2 * p) / (1.0 + pq_c3 * p), pq_m2);\n"
+    "}\n"
+    "\n"
+    "float4 main(float4 clip : SV_POSITION, float4 scene : SCENE_POSITION,\n"
+    "        float4 uv : TEXCOORD0) : SV_TARGET\n"
+    "{\n"
+    "    float4 colour = InputTexture.Sample(InputSampler, uv.xy);\n"
+    "    float3 rgb = colour.rgb;\n"
+    "    int i;\n"
+    "\n"
+    "    if (passthrough)\n"
+    "        return colour;\n"
+    "    if (premultiplied)\n"
+    "        rgb = colour.a ? rgb / colour.a : 0.0;\n"
+    "    if (clamp_source)\n"
+    "        rgb = saturate(rgb);\n"
+    "    if (source_pq)\n"
+    "        rgb = pq_decode(rgb);\n"
+    "    else\n"
+    "        for (i = 0; i < 3; ++i)\n"
+    "            rgb[i] = decode_channel(rgb[i], source.p0[i], source.p1[i]);\n"
+    "    rgb = mul(m, float4(rgb, 1.0));\n"
+    "    if (clamp_destination)\n"
+    "        rgb = saturate(rgb);\n"
+    "    if (destination_pq)\n"
+    "        rgb = pq_encode(rgb);\n"
+    "    else\n"
+    "        for (i = 0; i < 3; ++i)\n"
+    "            rgb[i] = encode_channel(rgb[i], destination.p0[i], destination.p1[i]);\n"
+    "    if (premultiplied)\n"
+    "        rgb *= colour.a;\n"
+    "    return float4(rgb, colour.a);\n"
+    "}\n";
