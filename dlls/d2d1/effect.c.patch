+/* Crop changes the region rather than the pixels, so it needs no shader --
+ * only a rect mapping. The properties live in the implementation object's
+ * trailing block and are read on each call, so a later SetValue() is picked
+ * up without rebuilding anything. */
+struct d2d_crop_transform
+{
+    ID2D1Transform ID2D1Transform_iface;
+    LONG refcount;
+    struct d2d_effect_impl *impl;
+};
