+    d2d_builtin_transform_QueryInterface,
+    d2d_builtin_transform_AddRef,
+    d2d_builtin_transform_Release,
+    d2d_builtin_transform_GetInputCount,
+    d2d_builtin_transform_MapOutputRectToInputRects,
+    d2d_builtin_transform_MapInputRectsToOutputRect,
+    d2d_builtin_transform_MapInvalidRect,
+    d2d_builtin_transform_SetDrawInfo,
+};
