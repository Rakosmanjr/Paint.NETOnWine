+static HRESULT STDMETHODCALLTYPE d2d_crop_transform_MapOutputRectToInputRects(ID2D1Transform *iface,
+        const D2D1_RECT_L *output_rect, D2D1_RECT_L *input_rects, UINT32 input_rect_count)
+{
+    if (input_rect_count != 1)
+        return E_INVALIDARG;
+
+    input_rects[0] = *output_rect;
+
+    return S_OK;
